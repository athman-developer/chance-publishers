---
import { categories } from '../data/books.js';
---
<div class="utility-bar">
  <div><span>🇰🇪 English</span><span>KES</span></div>
  <div><a href="/authors">Authors</a><a href="/launches">Events</a><a href="/podcast">Studio</a><a href="/shop">Shop</a><a href="/contact">Contact</a><a href="/publish">Submit a manuscript</a></div>
</div>

<header class="site-header" data-nav>
  <div class="header-main">
    <a class="brand" href="/" aria-label="Chance Publishers home">
      <img src="/Images/brand/chance-logo.webp" alt="Chance Publishers" />
    </a>

    <form class="book-search" role="search" action="/search" method="get">
      <label class="sr-only" for="book-search">Search books and authors</label>
      <select name="category" aria-label="Search category">
        <option value="">All books</option>
        {categories.map((c) => <option value={c.short}>{c.short}</option>)}
      </select>
      <input id="book-search" name="q" type="search" placeholder="Search books, titles or authors…" />
      <button type="submit" aria-label="Search">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M20 20l-4.8-4.8"/></svg>
      </button>
    </form>

    <a class="header-contact" href="/contact">
      <span class="contact-icon">✆</span><p><small>Talk to our publishing team</small><b>Chance Publishers</b></p>
    </a>

    <div class="nav-actions">
      <button class="icon-button theme-toggle" type="button" aria-label="Switch color theme" data-theme-toggle><span class="sun">☀</span><span class="moon">☾</span></button>
      <button class="mobile-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle><span></span><span></span><span></span><b class="sr-only">Open menu</b></button>
    </div>
  </div>

  <div class="nav-row">
    <div class="browse-group">
      <button class="browse-button" type="button" aria-expanded="false" data-browse-button><span>☰</span> Browse all books <b>⌄</b></button>
      <div class="browse-dropdown" data-browse-dropdown>
        <a href="/categories/religion"><span>◉</span><div><b>Religion</b><small>Faith, devotion & spiritual growth</small></div></a>
        <a href="/categories/leadership"><span>↗</span><div><b>Leadership</b><small>Purpose, service & transformation</small></div></a>
        <a href="/categories/education"><span>ABC</span><div><b>Education</b><small>Learning, teaching & discovery</small></div></a>
        <a href="/categories/literature"><span>“ ”</span><div><b>Literature</b><small>Stories, poetry & imagination</small></div></a>
        <a href="/categories/research"><span>⌁</span><div><b>Research</b><small>Knowledge, science & society</small></div></a>
      </div>
    </div>
    <nav class="desktop-nav" aria-label="Main navigation">
      <a href="/">Home</a>
      <div class="nav-group">
        <button type="button" aria-expanded="false" data-dropdown-button>Books <span>⌄</span></button>
        <div class="dropdown" data-dropdown>
          <div><span class="dropdown-label">Browse books</span><a href="/books"><b>All books</b><small>Explore the complete catalogue</small></a><a href="/books/new-releases"><b>New releases</b><small>Fresh stories and new ideas</small></a><a href="/books/top-picks"><b>Top picks</b><small>Books readers are loving</small></a></div>
          <div><span class="dropdown-label">Categories</span><a href="/categories/religion">Religion & Spirituality</a><a href="/categories/leadership">Leadership & Growth</a><a href="/categories/education">Education & Learning</a><a href="/categories/literature">Fiction & Literature</a><a href="/categories/research">Research & Society</a><a href="/categories/science">Science, Health & Nature</a></div>
        </div>
      </div>
      <a href="/authors">Authors</a><a href="/launches">Launches</a><a href="/podcast">Studio</a><a href="/publish">Publishing Guide</a><a href="/about">About</a><a href="/contact">Contact</a>
    </nav>
    <div class="nav-cta"><a class="shop-button" href="/shop">Shop <span>↗</span></a><a class="publish-button" href="/publish">Publish with us <span>↗</span></a></div>
  </div>

  <button class="menu-backdrop" type="button" aria-label="Close menu" data-menu-backdrop hidden></button>
  <div class="mobile-menu" id="mobile-menu" data-mobile-menu hidden>
    <form class="mobile-search" role="search" action="/search" method="get"><label class="sr-only" for="mobile-book-search">Search books and authors</label><input id="mobile-book-search" name="q" type="search" placeholder="Search books and authors…" /><button type="submit" aria-label="Search"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M20 20l-4.8-4.8"/></svg></button></form>
    <a href="/">Home</a>
    <details><summary>Books <span>＋</span></summary><div><a href="/books">All books</a><a href="/books/new-releases">New releases</a><a href="/books/top-picks">Top picks</a><a href="/categories/religion">Categories</a></div></details>
    <a href="/authors">Authors</a><a href="/launches">Launches</a><a href="/podcast">Studio</a><a href="/publish">Publishing Guide</a><a href="/about">About</a><a href="/contact">Contact us</a><a class="mobile-shop" href="/shop">Shop books <span>↗</span></a><a class="mobile-publish" href="/publish">Publish with us <span>↗</span></a>
  </div>
</header>

<style is:inline>
  .utility-bar{height:30px;padding:0 clamp(1rem,4vw,4.5rem);display:flex;align-items:center;justify-content:space-between;background:#121914;color:#fff;font-size:.61rem;font-weight:700}.utility-bar>div{display:flex;align-items:center;gap:1.2rem}.utility-bar a{color:#fff;text-decoration:none;opacity:.85}.utility-bar a:hover{opacity:1;color:var(--yellow)}
  .site-header{position:sticky;z-index:60;top:0;background:color-mix(in srgb,var(--surface) 95%,transparent);box-shadow:0 8px 24px rgba(12,50,29,.08);backdrop-filter:blur(18px)}
  .header-main{min-height:96px;padding:0 clamp(1rem,4vw,4.5rem);display:grid;grid-template-columns:224px minmax(320px,1fr) auto auto;align-items:center;gap:clamp(1rem,2.5vw,2.2rem)}
  .brand{width:212px;height:82px;display:flex;align-items:center}.brand img{width:100%;height:100%;object-fit:contain;object-position:left center}html[data-theme="dark"] .brand img{filter:brightness(0) invert(1)}
  .book-search{height:44px;display:grid;grid-template-columns:auto 1fr 48px;border:1px solid var(--line);border-radius:999px;background:var(--surface);overflow:hidden;box-shadow:0 5px 16px rgba(21,78,43,.06);transition:box-shadow .2s ease}.book-search:focus-within{box-shadow:0 5px 16px rgba(21,78,43,.06),0 0 0 3px var(--soft-green)}.book-search select,.book-search input{min-width:0;border:0;outline:0;background:transparent;color:var(--text);font-size:.7rem}.book-search select{padding:0 .9rem;border-right:1px solid var(--line);font-weight:800}.book-search input{padding:0 1rem}
  .book-search button,.mobile-search button{display:grid;place-items:center;border:0;background:var(--yellow);color:#15251a;cursor:pointer;transition:background-color .18s ease,transform .12s ease}
  .book-search button svg,.mobile-search button svg{width:19px;height:19px}
  .book-search button:hover,.mobile-search button:hover{background:var(--yellow-shadow)}
  .book-search button:active,.mobile-search button:active{transform:scale(.92)}
  .book-search button:focus-visible,.mobile-search button:focus-visible{outline:3px solid var(--deep-green);outline-offset:-3px}
  .header-contact{display:flex;align-items:center;gap:.65rem;color:var(--text);text-decoration:none;white-space:nowrap}.contact-icon{width:38px;height:38px;display:grid;place-items:center;border:1px solid var(--line);border-radius:50%;color:var(--green);font-size:1.15rem}.header-contact p{display:grid;margin:0}.header-contact small{color:var(--muted);font-size:.55rem;font-weight:800;text-transform:uppercase;letter-spacing:.05em}.header-contact b{font-size:.72rem}.header-contact:hover .contact-icon{background:var(--soft-green)}
  .nav-actions{display:flex;align-items:center;gap:.55rem}.icon-button{width:40px;height:40px;display:grid;place-items:center;border:1px solid var(--line);border-radius:50%;background:var(--surface);color:var(--text);cursor:pointer}.theme-toggle span{grid-area:1/1;transition:.25s ease}.theme-toggle .moon{opacity:0;transform:scale(.5)}html[data-theme="dark"] .theme-toggle .sun{opacity:0;transform:scale(.5)}html[data-theme="dark"] .theme-toggle .moon{opacity:1;transform:scale(1)}
  .nav-row{min-height:62px;padding:0 clamp(1rem,4vw,4.5rem);display:grid;grid-template-columns:190px 1fr 190px;align-items:center;gap:2rem;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.browse-button{align-self:stretch;margin-left:0;display:flex;align-items:center;gap:.65rem;padding:0 1rem;background:var(--green);color:#fff;text-decoration:none;font-family:var(--display);font-size:.82rem;font-weight:700}.browse-button span{color:var(--yellow)}.desktop-nav{justify-self:center;display:flex;align-items:center;justify-content:center;gap:clamp(1rem,2.2vw,2.5rem)}.desktop-nav>a,.nav-group>button{position:relative;border:0;background:none;color:var(--text);text-decoration:none;font-family:var(--display);font-size:1rem;font-weight:700;letter-spacing:-.02em;cursor:pointer;white-space:nowrap}.desktop-nav>a::after,.nav-group>button::after{content:"";position:absolute;left:0;right:100%;bottom:-1rem;height:3px;border-radius:3px;background:var(--yellow);transition:right .25s ease}.desktop-nav>a:hover::after,.nav-group>button:hover::after{right:0}.nav-group>button span{color:var(--green)}.nav-group{position:relative}.publish-button,.mobile-publish{justify-self:end;padding:.8rem 1.1rem;border-radius:999px;background:var(--yellow);color:#172315;text-decoration:none;font-family:var(--display);font-size:.78rem;font-weight:700;box-shadow:0 5px 0 var(--yellow-shadow)}
  .dropdown{position:absolute;top:calc(100% + 20px);left:50%;width:min(660px,80vw);padding:1.2rem;display:grid;grid-template-columns:1.1fr .9fr;gap:.8rem;border:1px solid var(--line);border-radius:20px;background:var(--surface);box-shadow:0 24px 70px rgba(20,60,35,.18);opacity:0;visibility:hidden;transform:translate(-50%,-8px);transition:.25s ease}.dropdown.is-open{opacity:1;visibility:visible;transform:translate(-50%,0)}.dropdown>div{display:grid;align-content:start;gap:.15rem;padding:.5rem}.dropdown>div+div{border-left:1px solid var(--line);padding-left:1.2rem}.dropdown-label{margin:.15rem .7rem .7rem;color:var(--muted);font-size:.62rem;font-weight:900;letter-spacing:.12em;text-transform:uppercase}.dropdown a{display:grid;gap:.18rem;padding:.72rem;border-radius:13px;color:var(--text);text-decoration:none;font-size:.79rem;font-weight:750}.dropdown a:hover{background:var(--soft-green);color:var(--deep-green)}.dropdown small{color:var(--muted);font-size:.67rem;font-weight:600}
  .mobile-toggle,.mobile-menu,.menu-backdrop{display:none}.mobile-toggle{width:44px;height:44px;padding:10px;border:0;border-radius:13px;background:var(--deep-green);cursor:pointer}.mobile-toggle span{display:block;height:2px;margin:5px 0;border-radius:2px;background:#fff;transition:.25s ease}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
  .nav-row{background:linear-gradient(105deg,#073d25 0%,#0b6a3a 48%,#0a4e2d 100%);border-color:rgba(255,255,255,.12)}.browse-group{position:relative;align-self:stretch}.browse-button{width:100%;height:100%;border:0;background:var(--yellow);color:#172315;cursor:pointer}.browse-button span{color:var(--deep-green)}.browse-button>b{margin-left:auto}.desktop-nav>a,.nav-group>button{color:#fff}.browse-dropdown{position:absolute;top:calc(100% + 10px);left:0;width:330px;padding:.7rem;display:grid;gap:.15rem;border:1px solid var(--line);border-radius:18px;background:var(--surface);box-shadow:0 24px 65px rgba(4,43,23,.25);opacity:0;visibility:hidden;transform:translateY(-8px);transition:.22s ease}.browse-dropdown.is-open{opacity:1;visibility:visible;transform:none}.browse-dropdown a{display:flex;align-items:center;gap:.8rem;padding:.8rem;border-radius:12px;color:var(--text);text-decoration:none}.browse-dropdown a:hover{background:var(--soft-green)}.browse-dropdown a>span{width:38px;height:38px;display:grid;place-items:center;border-radius:10px;background:var(--soft-green);color:var(--deep-green);font-family:var(--head);font-size:.72rem;font-weight:900}.browse-dropdown a div{display:grid}.browse-dropdown a b{font-size:.8rem}.browse-dropdown a small{color:var(--muted);font-size:.62rem}
  @media(max-width:1060px){.header-contact{display:none}.header-main{grid-template-columns:224px 1fr auto}}
  @media(max-width:820px){.utility-bar,.book-search,.nav-row{display:none}.site-header{top:0}.header-main{min-height:80px;grid-template-columns:1fr auto;padding-inline:1rem}.brand{width:178px;height:70px}.mobile-toggle{display:block}.menu-backdrop{position:fixed;z-index:-1;inset:0;width:100vw;height:100vh;border:0;background:rgba(7,31,19,.52);backdrop-filter:blur(3px);cursor:pointer}.menu-backdrop:not([hidden]){display:block}.mobile-menu{position:fixed;z-index:1;top:88px;left:1rem;right:1rem;padding:1rem;max-height:calc(100dvh - 104px);overflow:auto;border:1px solid var(--line);border-radius:20px;background:var(--surface);box-shadow:0 22px 70px rgba(0,0,0,.24);animation:menu-in .22s ease both}.mobile-menu:not([hidden]){display:grid}.mobile-search{height:44px;margin-bottom:.5rem;display:grid;grid-template-columns:1fr 46px;border:1px solid var(--line);border-radius:12px;overflow:hidden}.mobile-search input{min-width:0;padding:0 .8rem;border:0;outline:0;background:transparent;color:var(--text)}.mobile-menu>a,.mobile-menu summary{padding:1rem .7rem;border-bottom:1px solid var(--line);color:var(--text);text-decoration:none;font-size:.95rem;font-weight:800;cursor:pointer;list-style:none}.mobile-menu summary{display:flex;justify-content:space-between}.mobile-menu details div{display:grid;padding:.35rem 0 .5rem 1rem}.mobile-menu details a{padding:.7rem;color:var(--muted);text-decoration:none;font-size:.82rem}.mobile-menu .mobile-publish{display:flex;justify-content:space-between;margin-top:.75rem;border:0}.mobile-toggle[aria-expanded="true"] span:nth-child(1){transform:translateY(7px) rotate(45deg)}.mobile-toggle[aria-expanded="true"] span:nth-child(2){opacity:0}.mobile-toggle[aria-expanded="true"] span:nth-child(3){transform:translateY(-7px) rotate(-45deg)}}
  @keyframes menu-in{from{opacity:0;transform:translateY(-10px) scale(.985)}to{opacity:1;transform:none}}
  .nav-row{grid-template-columns:190px 1fr auto;gap:1.15rem}.nav-cta{display:flex;align-items:center;gap:.65rem}.shop-button{padding:.8rem 1.15rem;border:1px solid rgba(255,255,255,.35);border-radius:999px;background:#fff;color:#07502d;text-decoration:none;font-family:var(--display);font-size:.78rem;font-weight:800;box-shadow:0 5px 0 rgba(0,0,0,.18)}.shop-button:hover{background:var(--yellow);color:#172315}.mobile-menu .mobile-shop{margin-top:.75rem;display:flex;justify-content:space-between;border:0;border-radius:12px;background:var(--deep-green);color:#fff}.mobile-menu .mobile-publish{margin-top:.55rem}
</style>
