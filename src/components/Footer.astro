<style is:global>
  .cp-footer{padding:4rem clamp(1rem,5vw,6rem) 1.5rem;background:#092719;color:#fff}
  .cp-footer-grid{display:grid;grid-template-columns:1.25fr .55fr .55fr 1fr;gap:3rem}
  @media(min-width:901px){
    .cp-footer-brand{order:1}
    .cp-footer-nav-col:nth-of-type(1){order:2}
    .cp-footer-nav-col:nth-of-type(2){order:3}
    .cp-footer-submit{order:4}
  }
  .cp-footer-brand img{width:180px;height:76px;object-fit:contain;filter:brightness(0) invert(1)}
  .cp-footer-brand p{max-width:350px;color:#fff;line-height:1.7}
  .cp-footer-address{font-size:.74rem;opacity:.9}
  .cp-footer-address a{color:#fff!important;text-decoration:underline}
  .cp-footer-nav-col{display:grid;align-content:start;gap:.7rem}
  .cp-footer-nav-col b{color:var(--yellow);font-family:var(--display)}
  .cp-footer-nav-col a{color:#fff;text-decoration:none}
  .cp-footer-submit{display:grid;align-content:start;gap:.45rem}
  .cp-footer-submit b{color:var(--yellow);font-family:var(--display)}
  .cp-footer-submit>p{color:rgba(255,255,255,.7);font-size:.78rem;line-height:1.5}
  .cp-footer-submit>input,.cp-footer-submit textarea{width:100%;padding:.65rem .7rem;border:1px solid rgba(255,255,255,.22);border-radius:9px;background:rgba(255,255,255,.08);color:#fff;outline:none}
  .cp-footer-submit textarea{resize:vertical}
  .cp-footer-submit>label{position:relative;padding:.65rem;display:grid;gap:.2rem;border:1px dashed rgba(255,255,255,.35);border-radius:9px;cursor:pointer}
  .cp-footer-submit>label input{position:absolute;width:1px;height:1px;opacity:0}
  .cp-footer-submit>label span{color:var(--yellow);font-size:.65rem;font-weight:900}
  .cp-footer-submit>label small,.cp-footer-upload-note{color:rgba(255,255,255,.58);font-size:.52rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .cp-footer-submit button{border:0;cursor:pointer}
  .cp-footer-contact{display:inline-flex;margin-top:.3rem;padding:.75rem 1rem;border-radius:10px;background:var(--yellow);color:#172315!important;font-weight:900;text-decoration:none}
  .cp-footer-portal-link{margin-top:.6rem;color:rgba(255,255,255,.7)!important;font-size:.72rem;text-decoration:underline}
  .cp-footer-social{margin:2.5rem auto 0;display:flex;justify-content:center;gap:.6rem}
  .cp-footer-social a{width:40px;height:40px;display:grid;place-items:center;border:1px solid rgba(255,255,255,.25);border-radius:10px;color:#fff;font-size:.76rem;font-weight:900}
  .cp-footer-bottom{margin-top:1.3rem;padding-top:1.1rem;display:flex;justify-content:space-between;align-items:center;gap:1rem;border-top:1px solid rgba(255,255,255,.14);font-size:.68rem}
  .cp-footer-legal-link{color:rgba(255,255,255,.75);text-decoration:underline}

  @media(max-width:900px){
    .cp-footer-grid{grid-template-columns:1fr 1fr}
    .cp-footer-submit,.cp-footer-brand{grid-column:1/-1}
  }
  @media(max-width:560px){
    .cp-footer-grid{grid-template-columns:1fr 1fr;gap:2rem 1rem}
    .cp-footer-submit,.cp-footer-brand{grid-column:1/-1!important}
    .cp-footer-nav-col{grid-column:auto!important}
    .cp-footer-brand{text-align:center}
    .cp-footer-brand img{margin-inline:auto}
    .cp-footer-address{max-width:340px;margin-inline:auto}
    .cp-footer-bottom{display:grid;grid-template-columns:1fr;justify-items:center;gap:.4rem;text-align:center}
  }
</style>
