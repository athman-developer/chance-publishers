---
import Navbar from '../components/Navbar.astro';
import '../styles/responsive.css';
const {title,description='Chance Publishers Limited provides professional book publishing services in Kenya, including editing, proofreading, cover design, book layout, printing support and author guidance in Nairobi.'}=Astro.props;
const siteUrl='https://chancepublishers.com';
const canonical=new URL(Astro.url.pathname,siteUrl).toString();
const localBusinessSchema={
  '@context':'https://schema.org',
  '@type':['LocalBusiness','Organization'],
  '@id':`${siteUrl}/#organization`,
  name:'Chance Publishers Limited',
  alternateName:'Chance Publishers',
  url:siteUrl,
  logo:`${siteUrl}/Images/brand/chance-logo.png`,
  image:`${siteUrl}/og.png`,
  description:'A Nairobi publishing company providing manuscript editing, proofreading, book design, ISBN and copyright registration support, printing guidance, author branding and book launch support.',
  telephone:'+254758305622',
  email:'info@chancepublishers.com',
  priceRange:'KSh 40,000–60,000 publishing packages; printing quoted separately',
  address:{'@type':'PostalAddress',streetAddress:'Kenda House, 4th Floor, Tom Mboya Street, near Afya Centre',addressLocality:'Nairobi',addressCountry:'KE'},
  areaServed:{'@type':'Country',name:'Kenya'},
  openingHoursSpecification:{'@type':'OpeningHoursSpecification',dayOfWeek:['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'],opens:'06:00',closes:'21:00'},
  sameAs:['https://www.instagram.com/chancepublishers/','https://www.tiktok.com/@chancepublishers','https://www.linkedin.com/company/chance-publishers/']
};
---
<!doctype html><html lang="en" data-theme="light"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={description}/><meta name="robots" content="index,follow,max-image-preview:large"/><link rel="canonical" href={canonical}/><meta property="og:type" content="website"/><meta property="og:site_name" content="Chance Publishers"/><meta property="og:title" content={`${title} — Chance Publishers`}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={`${siteUrl}/og.png`}/><meta name="twitter:card" content="summary_large_image"/><title>{title} — Chance Publishers</title><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;600;700;800;900&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet"/><script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)}></script><script is:inline>try{const saved=localStorage.getItem('chance-theme');if(saved)document.documentElement.dataset.theme=saved}catch{}</script></head>
<body><Navbar/><main><slot/></main><footer><div class="footer-grid"><div><img src="/Images/brand/chance-logo.png" alt="Chance Publishers"/><p>Professional book publishing, editing, design and printing support for authors in Kenya.</p><p class="footer-address">Kenda House, 4th Floor, Tom Mboya Street, near Afya Centre, Nairobi<br/>Open Monday–Sunday, 6:00 a.m.–9:00 p.m.<br/><a href="tel:+254758305622">+254 758 305 622</a> · <a href="mailto:info@chancepublishers.com">info@chancepublishers.com</a></p></div><nav><b>Explore</b><a href="/books">Books</a><a href="/shop">Shop</a><a href="/authors">Authors</a><a href="/launches">Launches</a><a href="/podcast">The Reading Room Studio</a></nav><nav><b>Publishing</b><a href="/publish">Publishing guide</a><a href="/#packages">Publishing packages</a><a href="/categories/religion">Categories</a><a href="/contact">Contact us</a><a href="/">Home</a></nav><form class="footer-submit" data-footer-manuscript><b>Submit your manuscript.</b><p>Add your details, choose the manuscript and open a prepared submission.</p><input name="name" required placeholder="Your full name"/><input name="email" type="email" required placeholder="Your email address"/><textarea name="message" rows="2" placeholder="Title, genre and a short note…"></textarea><label><input name="manuscript" type="file" required accept=".doc,.docx,.pdf,.rtf,.odt" data-footer-file/><span>＋ Upload manuscript</span><small data-footer-file-name>PDF, Word, RTF or ODT</small></label><button class="footer-contact" type="submit">Prepare manuscript email →</button><small class="footer-upload-note">Confirm the selected file is attached in your email app before sending.</small></form></div><div class="footer-social"><a href="https://www.facebook.com/chancepublishers" aria-label="Facebook">f</a><a href="https://www.instagram.com/chancepublishers/" aria-label="Instagram">◎</a><a href="https://www.linkedin.com/company/chance-publishers/" aria-label="LinkedIn">in</a><a href="https://www.youtube.com/@chancepublishers" aria-label="YouTube">▶</a><a href="https://www.tiktok.com/@chancepublishers" aria-label="TikTok">♪</a></div><div class="footer-bottom"><span>© 2026 Chance Publishers Limited</span><span>Your chance to grow.</span></div></footer>
<script>const root=document.documentElement;document.querySelector('[data-theme-toggle]')?.addEventListener('click',()=>{const next=root.dataset.theme==='dark'?'light':'dark';root.dataset.theme=next;localStorage.setItem('chance-theme',next)});const menuButton=document.querySelector('[data-menu-toggle]');const mobileMenu=document.querySelector('[data-mobile-menu]');const backdrop=document.querySelector('[data-menu-backdrop]');const close=()=>{menuButton?.setAttribute('aria-expanded','false');if(mobileMenu)mobileMenu.hidden=true;if(backdrop)backdrop.hidden=true};menuButton?.addEventListener('click',()=>{const open=menuButton.getAttribute('aria-expanded')==='true';if(open)close();else{menuButton.setAttribute('aria-expanded','true');if(mobileMenu)mobileMenu.hidden=false;if(backdrop)backdrop.hidden=false}});backdrop?.addEventListener('click',close);const wire=(buttonSelector,menuSelector,group)=>{const button=document.querySelector(buttonSelector);const menu=document.querySelector(menuSelector);button?.addEventListener('click',()=>{const open=button.getAttribute('aria-expanded')==='true';button.setAttribute('aria-expanded',String(!open));menu?.classList.toggle('is-open',!open)});document.addEventListener('click',e=>{if(!e.target.closest(group)){menu?.classList.remove('is-open');button?.setAttribute('aria-expanded','false')}})};wire('[data-dropdown-button]','[data-dropdown]','.nav-group');wire('[data-browse-button]','[data-browse-dropdown]','.browse-group');const footerForm=document.querySelector('[data-footer-manuscript]');const footerFile=document.querySelector('[data-footer-file]');const footerFileName=document.querySelector('[data-footer-file-name]');footerFile?.addEventListener('change',()=>{if(footerFileName)footerFileName.textContent=footerFile.files?.[0]?.name||'PDF, Word, RTF or ODT'});footerForm?.addEventListener('submit',event=>{event.preventDefault();const data=new FormData(footerForm);const file=footerFile?.files?.[0];const subject=`Manuscript Submission — ${data.get('name')||'New Author'}`;const body=`Hello Chance Publishers,\n\nKindly find my manuscript for your review.\n\nName: ${data.get('name')||''}\nEmail: ${data.get('email')||''}\nSelected manuscript: ${file?.name||'Not selected'}\n\nAbout the book:\n${data.get('message')||''}\n\nThank you.`;window.location.href=`mailto:info@chancepublishers.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`});</script></body></html>
<style is:global>:root{--green:#12ae58;--deep-green:#0c5f34;--yellow:#ffd21c;--yellow-shadow:#d7a900;--surface:#fff;--surface-2:#f5f8f5;--text:#183025;--muted:#718078;--line:#dfe8e1;--soft-green:#e8f9ef;--display:"Plus Jakarta Sans",sans-serif;--head:"Fredoka",sans-serif;--body:"Nunito",sans-serif}html[data-theme="dark"]{--surface:#101c16;--surface-2:#14231b;--text:#f4fff7;--muted:#a7b7ac;--line:#294134;--soft-green:#173d29}*{box-sizing:border-box}body{margin:0;background:var(--surface);color:var(--text);font-family:var(--body)}a,button,input,select,textarea{font:inherit}img{display:block;max-width:100%}main{min-height:60vh}.page-hero{padding:clamp(4rem,8vw,7rem) clamp(1rem,5vw,6rem);background:linear-gradient(130deg,#073d25,#0a7540);color:#fff}.page-hero small{color:var(--yellow);font-weight:900;letter-spacing:.15em}.page-hero h1{max-width:900px;margin:.7rem 0 1rem;font-family:var(--display);font-size:clamp(3rem,6vw,6rem);line-height:.96;letter-spacing:-.055em}.page-hero p{max-width:680px;margin:0;color:rgba(255,255,255,.82);font-size:1.05rem;line-height:1.75}footer{padding:4rem clamp(1rem,5vw,6rem) 1.5rem;background:#092719;color:#fff}.footer-grid{display:grid;grid-template-columns:1.25fr .55fr .55fr 1fr;gap:3rem}footer img{width:180px;height:76px;object-fit:contain;filter:brightness(0) invert(1)}footer p{max-width:350px;color:#fff;line-height:1.7}.footer-address{font-size:.74rem;opacity:.9}footer nav{display:grid;align-content:start;gap:.7rem}footer b{color:var(--yellow);font-family:var(--display)}footer a{color:#fff;text-decoration:none}.footer-submit{display:grid;align-content:start;gap:.45rem}.footer-submit>input,.footer-submit textarea{width:100%;padding:.65rem .7rem;border:1px solid rgba(255,255,255,.22);border-radius:9px;background:rgba(255,255,255,.08);color:#fff;outline:none}.footer-submit textarea{resize:vertical}.footer-submit>label{position:relative;padding:.65rem;display:grid;gap:.2rem;border:1px dashed rgba(255,255,255,.35);border-radius:9px;cursor:pointer}.footer-submit>label input{position:absolute;width:1px;height:1px;opacity:0}.footer-submit>label span{color:var(--yellow);font-size:.65rem;font-weight:900}.footer-submit>label small,.footer-upload-note{color:rgba(255,255,255,.58);font-size:.52rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.footer-submit button{border:0;cursor:pointer}.footer-social{margin:2.5rem auto 0;display:flex;justify-content:center;gap:.6rem}.footer-social a{width:40px;height:40px;display:grid;place-items:center;border:1px solid rgba(255,255,255,.25);border-radius:10px;color:#fff;font-size:.76rem;font-weight:900}.footer-contact{display:inline-flex;margin-top:.3rem;padding:.75rem 1rem;border-radius:10px;background:var(--yellow);color:#172315!important;font-weight:900}.footer-bottom{margin-top:1.3rem;padding-top:1.1rem;display:flex;justify-content:space-between;border-top:1px solid rgba(255,255,255,.14);font-size:.68rem}@media(max-width:900px){.footer-grid{grid-template-columns:1fr 1fr}.footer-grid>div:first-child,.footer-submit{grid-column:1/-1}}@media(max-width:560px){.footer-grid{grid-template-columns:1fr}.footer-grid>*{grid-column:auto!important}.footer-bottom{display:grid;gap:.4rem;text-align:center}}</style>
