---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/responsive.css';
const {title,description='Chance Publishers Limited provides professional book publishing services in Kenya, including editing, proofreading, cover design, book layout, printing support and author guidance in Nairobi.'}=Astro.props;
const siteUrl='https://chancepublishers.com';
const canonical=new URL(Astro.url.pathname,siteUrl).toString();
const localBusinessSchema={
  '@context':'https://schema.org',
  '@type':['LocalBusiness','Organization'],
  '@id':`${siteUrl}/#organization`,
  name:'Chance Publishers Limited',
  alternateName:'Chance Publishers',
  url:siteUrl,
  logo:`${siteUrl}/Images/brand/chance-logo.png`,
  image:`${siteUrl}/og.png`,
  description:'A Nairobi publishing company providing manuscript editing, proofreading, book design, ISBN and copyright registration support, printing guidance, author branding and book launch support.',
  telephone:'+254758305622',
  email:'chancepublishersltd@gmail.com',
  priceRange:'KSh 40,000–60,000 publishing packages; printing quoted separately',
  address:{'@type':'PostalAddress',streetAddress:'Kenda House, 4th Floor, Tom Mboya Street, near Afya Centre',addressLocality:'Nairobi',addressCountry:'KE'},
  areaServed:{'@type':'Country',name:'Kenya'},
  openingHoursSpecification:{'@type':'OpeningHoursSpecification',dayOfWeek:['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'],opens:'06:00',closes:'21:00'},
  sameAs:['https://www.instagram.com/chancepublishers/','https://www.tiktok.com/@chancepublishers','https://www.linkedin.com/company/chance-publishers/']
};
---
<!doctype html><html lang="en" data-theme="light"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={description}/><meta name="robots" content="index,follow,max-image-preview:large"/><link rel="canonical" href={canonical}/><meta property="og:type" content="website"/><meta property="og:site_name" content="Chance Publishers"/><meta property="og:title" content={`${title} — Chance Publishers`}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={`${siteUrl}/og.png`}/><meta name="twitter:card" content="summary_large_image"/><title>{title} — Chance Publishers</title><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;600;700;800;900&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet"/><script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)}></script><script is:inline>try{const saved=localStorage.getItem('chance-theme');if(saved)document.documentElement.dataset.theme=saved}catch{}</script></head>
<body><Navbar/><main><slot/></main><Footer/>
<script>const root=document.documentElement;document.querySelector('[data-theme-toggle]')?.addEventListener('click',()=>{const next=root.dataset.theme==='dark'?'light':'dark';root.dataset.theme=next;localStorage.setItem('chance-theme',next)});const menuButton=document.querySelector('[data-menu-toggle]');const mobileMenu=document.querySelector('[data-mobile-menu]');const backdrop=document.querySelector('[data-menu-backdrop]');const close=()=>{menuButton?.setAttribute('aria-expanded','false');if(mobileMenu)mobileMenu.hidden=true;if(backdrop)backdrop.hidden=true};menuButton?.addEventListener('click',()=>{const open=menuButton.getAttribute('aria-expanded')==='true';if(open)close();else{menuButton.setAttribute('aria-expanded','true');if(mobileMenu)mobileMenu.hidden=false;if(backdrop)backdrop.hidden=false}});backdrop?.addEventListener('click',close);const wire=(buttonSelector,menuSelector,group)=>{const button=document.querySelector(buttonSelector);const menu=document.querySelector(menuSelector);button?.addEventListener('click',()=>{const open=button.getAttribute('aria-expanded')==='true';button.setAttribute('aria-expanded',String(!open));menu?.classList.toggle('is-open',!open)});document.addEventListener('click',e=>{if(!e.target.closest(group)){menu?.classList.remove('is-open');button?.setAttribute('aria-expanded','false')}})};wire('[data-dropdown-button]','[data-dropdown]','.nav-group');wire('[data-browse-button]','[data-browse-dropdown]','.browse-group');</script></body></html>
<style is:global>:root{--green:#12ae58;--deep-green:#0c5f34;--yellow:#ffd21c;--yellow-shadow:#d7a900;--surface:#fff;--surface-2:#f5f8f5;--text:#183025;--muted:#718078;--line:#dfe8e1;--soft-green:#e8f9ef;--display:"Plus Jakarta Sans",sans-serif;--head:"Fredoka",sans-serif;--body:"Nunito",sans-serif}html[data-theme="dark"]{--surface:#101c16;--surface-2:#14231b;--text:#f4fff7;--muted:#a7b7ac;--line:#294134;--soft-green:#173d29}*{box-sizing:border-box}body{margin:0;background:var(--surface);color:var(--text);font-family:var(--body)}a,button,input,select,textarea{font:inherit}img{display:block;max-width:100%}main{min-height:60vh}.page-hero{padding:clamp(4rem,8vw,7rem) clamp(1rem,5vw,6rem);background:linear-gradient(130deg,#073d25,#0a7540);color:#fff}.page-hero small{color:var(--yellow);font-weight:900;letter-spacing:.15em}.page-hero h1{max-width:900px;margin:.7rem 0 1rem;font-family:var(--display);font-size:clamp(3rem,6vw,6rem);line-height:.96;letter-spacing:-.055em}.page-hero p{max-width:680px;margin:0;color:rgba(255,255,255,.82);font-size:1.05rem;line-height:1.75}</style>
