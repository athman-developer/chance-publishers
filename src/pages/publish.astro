---
import InnerPage from '../layouts/InnerPage.astro';
const mockups=['pieces-of-me','rooted-and-reimagined','living-resurrection-power','the-terrain','not-expired','blooming-with-grace','women-in-islam'];
const steps=[
['01','Confidentiality first','We begin with a conversation and a non-disclosure agreement (NDA) that defines what is confidential, who can review it and the purpose for which it is shared.'],
['02','Submit the manuscript','Send the most complete editable draft, working title, author details, intended readers, images, references and any permissions already obtained.'],
['03','Review and project plan','We assess the structure, language, length, illustrations and production needs, then agree the scope, schedule, responsibilities and quotation.'],
['04','Editing and proofreading','Editing improves clarity, flow, consistency and structure. Proofreading is the final correction pass after layout, before the author approves production.'],
['05','Book design, ISBN and legal deposit','We design the cover and interior, prepare the imprint and barcode area, and work with KNLS on ISBN requirements. The ISBN normally appears in the imprint information and as a barcode on the lower back cover. After publication, we guide the required legal-deposit copies.'],
['06','Sample copy and approval','A physical dummy copy allows the author to inspect size, margins, paper, image quality, colour, binding and final corrections before bulk printing.'],
['07','Printing and production','After written approval, production begins. Quantity, page count, trim size, paper, colour, binding, cover finish and turnaround all affect the quotation.'],
['08','Launch and reader introduction','We can guide the launch, author presentation, promotional content and selected distribution support based on the agreed package and audience.']];
const sizes=[['A6','Pocket devotional','/Images/covers/islamic-faith.jpg'],['A5','Novel or journal','/Images/covers/pieces-of-me.jpg'],['5 × 8','Memoir and fiction','/Images/covers/behind-my-shadow.jpg'],['6 × 9','Biography and non-fiction','/Images/covers/not-expired.jpg'],['B5','Workbook or textbook','/Images/covers/maarifa-muhimu.jpg'],['A4','Manual or academic book','/Images/covers/asolic-principle.jpg']];
---
<InnerPage title="How to Publish a Book in Kenya — Chance Publishers" description="A clear guide to manuscript submission, editing, proofreading, book design, ISBN through KNLS, legal deposit, printing and book launches with Chance Publishers in Nairobi.">
  <section class="guide-hero"><div class="hero-copy"><small>THE CHANCE PUBLISHERS GUIDE</small><h1>From manuscript<br/><i>to a book you can hold.</i></h1><p>See what happens at every stage, what an author should prepare and how Chance Publishers makes the publishing process in Kenya understandable.</p><div class="hero-actions"><a href="https://wa.me/254758305622?text=Hello%20Chance%20Publishers%2C%20I%20would%20like%20to%20discuss%20my%20manuscript.">Discuss your manuscript →</a><a href="#process">See the full process</a></div></div><aside class="hero-showcase" data-guide-slider><span>CHANCE BOOKS IN MOTION</span><div class="mockup-slider">{mockups.map((name,index)=><img class={index===0?'is-active':''} data-guide-slide src={`/Images/mockups/${name}.jpg`} alt="Chance Publishers book mock-up"/>)}</div><div class="slider-controls"><button type="button" data-slide-prev aria-label="Previous book">←</button><div class="slider-dots" aria-label="Choose book mock-up">{mockups.map((_,index)=><button type="button" class={index===0?'active':''} data-slide-dot={index} aria-label={`Show book ${index+1}`}></button>)}</div><button type="button" data-slide-next aria-label="Next book">→</button></div><p>One landscape showcase. More published work appears automatically.</p></aside></section>
  <nav class="guide-tabs" aria-label="Publishing guide sections"><a href="#process"><span>01</span>Publishing process</a><a href="#isbn"><span>02</span>ISBN & legal deposit</a><a href="#copyright"><span>03</span>Copyright</a><a href="#printing"><span>04</span>Printing</a><a href="#sizes"><span>05</span>Book formats</a><a href="#faq"><span>06</span>Questions</a></nav>
  <section class="ready section"><div><small>START WITH THE MANUSCRIPT</small><h2>What happens after you say,<br/><i>“I’m ready to publish”?</i></h2><p>A manuscript can arrive as a Word document with chapters, headings, images, tables and references. It does not have to look like a finished book yet. What matters is that the material is organised enough for honest review.</p><a href="mailto:info@chancepublishers.com?subject=Manuscript%20Submission">Send your manuscript by email →</a></div><div class="manuscript-visual"><div class="page page-1"><b>WORKING TITLE</b><span>Chapter One</span><i></i><i></i><i></i></div><div class="page page-2"><b>AUTHOR DRAFT</b><span>Editable manuscript</span><i></i><i></i><i></i></div><img src="/Images/mockups/pieces-of-me.jpg" alt="A manuscript becoming a finished book"/></div></section>
  <section class="process section" id="process"><header><small>STEP BY STEP</small><h2>Your book journey,<br/><i>explained properly.</i></h2><p>Every stage has a reason: protect the work, improve the reading experience and prevent expensive production mistakes.</p></header><div class="steps">{steps.map((step,index)=><article><span>{step[0]}</span><div><h3>{step[1]}</h3><p>{step[2]}</p>{index===1&&<small>Typical files: .docx manuscript · labelled images · references · permissions</small>}</div>{[1,4,6].includes(index)&&<img src={`/Images/covers/${index===1?'rooted-and-reimagined':index===4?'the-terrain':'not-expired'}.jpg`} alt="Published book example"/>}</article>)}</div></section>
  <section class="identifiers section"><article id="isbn"><span class="icon">13</span><small>BOOK IDENTIFICATION</small><h2>ISBN: how readers and sellers identify the right edition.</h2><p>Kenya National Library Service is Kenya’s national ISBN agency. Chance Publishers works with KNLS and guides eligible authors through the information and production steps needed for an ISBN.</p><ul><li>An ISBN identifies a particular publication and format.</li><li>A new format or substantially different edition may need a separate number.</li><li>It should be confirmed before the final cover and imprint page are approved.</li><li>The number is normally printed in the book’s imprint details and encoded in the barcode placed near the bottom of the back cover.</li><li>An ISBN is an identifier; it is not proof of copyright ownership.</li></ul><a href="https://www.knls.ac.ke/national-library/" target="_blank" rel="noreferrer">Confirm KNLS national-library information ↗</a></article><article id="copyright"><span class="icon">©</span><small>RIGHTS & LEGAL DEPOSIT</small><h2>Copyright and legal deposit are different responsibilities.</h2><p>Copyright protects original expression once it is recorded. Legal deposit preserves the published record of Kenya. Under Kenya’s Books and Newspapers framework, the required deposit includes two copies for the Registrar of Books and Newspapers and two copies for KNLS within the prescribed period after publication.</p><ul><li>Chance Publishers can guide the author through preparation and delivery of the required copies.</li><li>Keep dated drafts, agreements and written permissions for third-party material.</li><li>Agree ownership, licences, royalties and responsibilities in writing.</li><li>Legal deposit does not replace an ISBN, and an ISBN does not transfer copyright.</li></ul><div class="official-links"><a href="https://www.knls.ac.ke/legal-deposit/" target="_blank" rel="noreferrer">KNLS legal-deposit guidance ↗</a><a href="https://new.kenyalaw.org/akn/ke/act/1960/27/eng@2022-12-31" target="_blank" rel="noreferrer">Books and Newspapers Act ↗</a></div></article></section>
  <section class="printing section" id="printing"><div class="printing-copy"><small>PRINT WITH CONFIDENCE</small><h2>Why every printing quotation is different.</h2><p>The price per copy is only meaningful after the finished specification and quantity are known.</p><div class="cost-grid">{[['Quantity','Bulk quantity affects production efficiency.'],['Pages','More pages use more paper, ink and finishing time.'],['Size','Trim size affects layout, paper use and imposition.'],['Colour','Black-and-white and full-colour need different production.'],['Paper','Weight, finish, opacity and availability affect cost.'],['Binding','Paperback, hardcover, lamination and finishes vary.']].map(item=><span><b>{item[0]}</b>{item[1]}</span>)}</div></div><div class="print-visual"><img src="/Images/launch/event-5087.jpg" alt="Finished Chance Publishers books ready for readers"/><div class="checklist"><b>Before bulk printing</b><ol><li>Editing and proofreading complete</li><li>Final cover and interior approved</li><li>ISBN and imprint details confirmed</li><li>Bleed, resolution and page order checked</li><li>Physical sample copy approved</li><li>Quantity and quotation signed off</li></ol><a href="/contact">Request a printing consultation →</a></div></div></section>
  <section class="sizes section" id="sizes"><header><small>SEE THE DIFFERENCE</small><h2>Choose a format that suits the reader.</h2><p>These visual examples show relative proportions, not exact screen measurements. The best size depends on purpose, length, illustrations, audience and budget.</p></header><div class="format-shelf">{sizes.map((item,index)=><article style={`--scale:${.7+index*.07}`}><img src={item[2]} alt={`${item[0]} book size example`}/><b>{item[0]}</b><span>{item[1]}</span></article>)}</div></section>
  <section class="faq section" id="faq"><header><small>USEFUL ANSWERS BEFORE YOU BEGIN</small><h2>Follow the answer to its next useful step.</h2></header><div class="faq-list"><details open><summary>How much does it cost to publish a book in Kenya?</summary><p>Publishing preparation and printing are quoted separately. Compare the <a href="/#packages">Bronze, Silver and Gold packages</a>, then request a printing quotation once the final size, pages, paper, colour and quantity are known.</p></details><details><summary>How do I submit a manuscript?</summary><p>Send the most complete editable draft with a title, author contact details, intended audience and short book description. <a href="mailto:info@chancepublishers.com?subject=Manuscript%20Submission">Email the manuscript</a> or <a href="/contact">speak with the team first</a>.</p></details><details><summary>How do I get an ISBN in Kenya?</summary><p>KNLS is the national ISBN agency. Chance Publishers works with KNLS and manages the practical publishing steps for eligible projects. Read the <a href="#isbn">ISBN explanation above</a>.</p></details><details><summary>What happens before bulk printing?</summary><p>The manuscript must be edited, designed, proofread and approved. A sample copy should be checked before quantity production. See the <a href="#printing">printing checklist</a>.</p></details><details><summary>Can Chance Publishers help with my launch?</summary><p>Yes. Launch support can include planning, author presentation and promotional moments. See <a href="/launches">Chance Publishers launch experiences</a>.</p></details></div></section>
  <section class="final-cta"><small>YOUR CHANCE TO GROW</small><h2>Bring the draft.<br/>We’ll help shape the book.</h2><p>Visit Kenda House, 4th Floor, Tom Mboya Street near Afya Centre, Nairobi, or speak directly with our publishing team.</p><div><a href="https://wa.me/254758305622?text=Hello%20Chance%20Publishers%2C%20I%20would%20like%20a%20publishing%20consultation.">WhatsApp +254 758 305 622 →</a><a href="mailto:info@chancepublishers.com">Email the team</a></div></section>
</InnerPage>
<style>
  .section{padding:clamp(5rem,8vw,8rem) clamp(1rem,6vw,7rem)}.guide-hero{min-height:650px;padding:clamp(4rem,7vw,7rem) clamp(1rem,6vw,7rem);display:grid;grid-template-columns:.9fr 1.1fr;align-items:center;gap:clamp(3rem,7vw,7rem);background:radial-gradient(circle at 85% 15%,rgba(255,210,28,.2),transparent 25%),linear-gradient(135deg,#062b1c,#0b6a3a);color:#fff}.hero-copy small,.ready small,.process small,.identifiers small,.printing small,.sizes small,.faq small,.final-cta small{color:var(--yellow);font-weight:900;letter-spacing:.14em}.hero-copy h1{margin:.8rem 0 1.2rem;font-family:var(--display);font-size:clamp(3.8rem,6.5vw,6.6rem);line-height:.9;letter-spacing:-.06em}.hero-copy h1 i,.ready h2 i,.process h2 i{color:var(--yellow);font-family:"Patrick Hand",cursive;font-weight:400}.hero-copy p{max-width:620px;color:rgba(255,255,255,.8);line-height:1.8}.hero-actions{display:flex;gap:.7rem;flex-wrap:wrap;margin-top:1.7rem}.hero-actions a{padding:.95rem 1.1rem;border:1px solid rgba(255,255,255,.3);border-radius:11px;color:#fff;text-decoration:none;font-weight:900}.hero-actions a:first-child{background:var(--yellow);color:#173020}.hero-showcase{padding:1rem;border:1px solid rgba(255,255,255,.18);border-radius:25px;background:rgba(255,255,255,.08)}.hero-showcase>span{color:var(--yellow);font-size:.62rem;font-weight:900;letter-spacing:.12em}.hero-showcase>p{margin:.6rem;color:rgba(255,255,255,.66);font-size:.7rem}.mockup-slider{position:relative;margin-top:.7rem;aspect-ratio:16/10;overflow:hidden;border:7px solid #fff;border-radius:17px;background:#fff}.mockup-slider img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0;transform:scale(1.035);transition:opacity .85s ease,transform 5.8s ease}.mockup-slider img.is-active{opacity:1;transform:scale(1)}.slider-controls{margin-top:.75rem;display:flex;align-items:center;justify-content:center;gap:.8rem}.slider-controls>button{width:34px;height:34px;border:1px solid rgba(255,255,255,.2);border-radius:50%;background:rgba(255,255,255,.1);color:#fff;cursor:pointer}.slider-dots{display:flex;gap:.35rem}.slider-dots button{width:8px;height:8px;padding:0;border:0;border-radius:99px;background:rgba(255,255,255,.35);cursor:pointer;transition:.25s}.slider-dots button.active{width:24px;background:var(--yellow)}
  .guide-tabs{position:sticky;z-index:20;top:148px;padding:.75rem clamp(1rem,5vw,6rem);display:flex;justify-content:center;gap:.55rem;overflow:auto;background:color-mix(in srgb,var(--surface) 92%,transparent);backdrop-filter:blur(15px);box-shadow:0 8px 25px rgba(10,50,27,.08)}.guide-tabs a{flex:0 0 auto;padding:.7rem .85rem;display:flex;align-items:center;gap:.45rem;border:1px solid var(--line);border-radius:10px;background:var(--surface);color:var(--text);text-decoration:none;font-size:.68rem;font-weight:900}.guide-tabs a:hover{border-color:var(--green);background:var(--soft-green)}.guide-tabs span{color:var(--green)}
  .ready{display:grid;grid-template-columns:.9fr 1.1fr;align-items:center;gap:5rem;background:var(--surface-2)}.ready>div:first-child>small,.process header small,.identifiers small,.printing small,.sizes small,.faq small{color:var(--green)}.ready h2,.process h2,.identifiers h2,.printing h2,.sizes h2,.faq h2,.final-cta h2{margin:.7rem 0;font-family:var(--display);font-size:clamp(2.8rem,5vw,5rem);line-height:.95}.ready p,.process header p,.printing-copy>p,.sizes header p{color:var(--muted);line-height:1.8}.ready a{color:var(--deep-green);font-weight:900}.manuscript-visual{position:relative;min-height:450px}.manuscript-visual .page{position:absolute;width:54%;height:72%;padding:2rem;border:1px solid var(--line);border-radius:8px;background:#fff;color:#243128;box-shadow:0 22px 50px rgba(15,60,32,.15)}.page-1{left:0;top:4%;transform:rotate(-5deg)}.page-2{left:20%;top:10%;transform:rotate(3deg)}.page b,.page span{display:block}.page span{margin:2rem 0 1rem}.page i{height:5px;margin:.8rem 0;display:block;border-radius:5px;background:#dce3de}.manuscript-visual img{position:absolute;z-index:3;right:0;bottom:0;width:48%;height:70%;object-fit:cover;border:7px solid #fff;border-radius:12px;box-shadow:0 25px 55px rgba(10,50,27,.22)}
  .process{background:var(--surface)}.process header{max-width:820px}.steps{margin-top:2.5rem;display:grid;grid-template-columns:1fr 1fr;gap:.9rem}.steps article{min-height:190px;padding:1.2rem;display:grid;grid-template-columns:auto 1fr auto;gap:1rem;border:1px solid var(--line);border-radius:18px;background:var(--surface-2)}.steps>article>span{width:48px;height:48px;display:grid;place-items:center;border-radius:13px;background:var(--yellow);color:#173020;font-family:var(--display);font-weight:900}.steps h3{margin:.2rem 0;font-family:var(--display)}.steps p{color:var(--muted);font-size:.76rem;line-height:1.65}.steps small{color:var(--green);font-weight:800}.steps img{width:82px;height:120px;object-fit:cover;border-radius:7px;box-shadow:0 8px 20px rgba(0,0,0,.16)}
  .identifiers{display:grid;grid-template-columns:1fr 1fr;gap:1rem;background:var(--surface-2)}.identifiers article{padding:2rem;border:1px solid var(--line);border-radius:22px;background:var(--surface)}.identifiers .icon{width:62px;height:62px;display:grid;place-items:center;border-radius:50%;background:var(--yellow);font-family:var(--display);font-size:1.3rem;font-weight:900}.identifiers h2{font-size:clamp(2rem,3.4vw,3.4rem)}.identifiers p,.identifiers li{color:var(--muted);line-height:1.7}.identifiers li{margin:.45rem 0}.identifiers a{color:var(--deep-green);font-weight:900}.official-links{display:flex;gap:.7rem;flex-wrap:wrap}
  .printing{display:grid;grid-template-columns:1fr 1fr;gap:4rem;background:var(--surface)}.cost-grid{margin-top:1.5rem;display:grid;grid-template-columns:1fr 1fr;gap:.7rem}.cost-grid span{padding:.8rem;border-left:4px solid var(--yellow);background:var(--surface-2);color:var(--muted);font-size:.7rem;line-height:1.5}.cost-grid b{display:block;color:var(--text);font-family:var(--display)}.print-visual{position:relative;min-height:560px}.print-visual>img{width:100%;height:100%;object-fit:cover;border-radius:24px}.checklist{position:absolute;left:-2rem;right:2rem;bottom:-2rem;padding:1.3rem;border-radius:17px;background:#08351f;color:#fff;box-shadow:0 18px 50px rgba(0,0,0,.26)}.checklist>b{color:var(--yellow);font-family:var(--display)}.checklist ol{columns:2;padding-left:1.1rem}.checklist li{margin:.35rem;color:rgba(255,255,255,.76);font-size:.68rem}.checklist a{color:var(--yellow);font-weight:900}
  .sizes{background:var(--surface-2)}.sizes header{max-width:850px}.format-shelf{margin-top:2.5rem;min-height:440px;padding:2rem 1rem 0;display:flex;align-items:end;justify-content:center;gap:1rem;border-bottom:14px solid #6b462e;overflow:auto}.format-shelf article{flex:0 0 150px;display:grid;text-align:center}.format-shelf img{width:calc(140px*var(--scale));height:calc(310px*var(--scale));margin:auto;object-fit:cover;box-shadow:8px 10px 20px rgba(0,0,0,.2)}.format-shelf b{margin-top:.8rem;font-family:var(--display)}.format-shelf span{color:var(--muted);font-size:.64rem}.faq{background:var(--surface)}.faq header{max-width:850px}.faq-list{margin-top:2rem;display:grid;gap:.7rem}.faq-list details{padding:1.1rem 1.2rem;border:1px solid var(--line);border-radius:14px;background:var(--surface-2)}.faq-list summary{font-family:var(--display);font-weight:800;cursor:pointer}.faq-list p{color:var(--muted);line-height:1.7}.faq-list a{color:var(--green);font-weight:900}.final-cta{padding:clamp(4rem,7vw,7rem) clamp(1rem,6vw,7rem);background:linear-gradient(135deg,#062b1c,#0b6a3a);color:#fff}.final-cta h2{max-width:850px}.final-cta p{max-width:700px;color:rgba(255,255,255,.75)}.final-cta>div{display:flex;gap:.7rem;flex-wrap:wrap;margin-top:1.5rem}.final-cta a{padding:.9rem 1rem;border:1px solid rgba(255,255,255,.28);border-radius:10px;color:#fff;text-decoration:none;font-weight:900}.final-cta a:first-child{background:var(--yellow);color:#173020}
  @media(max-width:900px){.guide-hero,.ready,.printing{grid-template-columns:1fr}.guide-tabs{top:76px;justify-content:flex-start}.steps,.identifiers{grid-template-columns:1fr}.print-visual{min-height:480px}.checklist{left:1rem;right:1rem}.format-shelf{justify-content:flex-start}}@media(max-width:560px){.section,.guide-hero,.final-cta{padding-inline:1rem}.guide-hero{padding-top:3rem}.hero-copy h1{font-size:clamp(3rem,14vw,4.3rem)}.hero-showcase{padding:.7rem}.manuscript-visual{min-height:340px}.steps article{grid-template-columns:auto 1fr}.steps img{grid-column:2}.cost-grid{grid-template-columns:1fr}.print-visual{min-height:460px}.checklist ol{columns:1}.format-shelf article{flex-basis:125px}}
</style>
<script>
  document.querySelectorAll('[data-guide-slider]').forEach(slider=>{
    const slides=[...slider.querySelectorAll('[data-guide-slide]')];
    const dots=[...slider.querySelectorAll('[data-slide-dot]')];
    let current=0;
    let timer;
    const show=index=>{
      current=(index+slides.length)%slides.length;
      slides.forEach((slide,i)=>slide.classList.toggle('is-active',i===current));
      dots.forEach((dot,i)=>dot.classList.toggle('active',i===current));
    };
    const restart=()=>{window.clearInterval(timer);timer=window.setInterval(()=>show(current+1),4800)};
    slider.querySelector('[data-slide-prev]')?.addEventListener('click',()=>{show(current-1);restart()});
    slider.querySelector('[data-slide-next]')?.addEventListener('click',()=>{show(current+1);restart()});
    dots.forEach((dot,index)=>dot.addEventListener('click',()=>{show(index);restart()}));
    show(0);restart();
  });
</script>
