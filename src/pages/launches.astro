---
import InnerPage from '../layouts/InnerPage.astro';
const images=['still-i-breathe.jpg','blooming-launch.jpg','terrain-group.jpg','terrain-pair.jpg','plants-presentation.jpg','plants-handover.jpg','plants-handover-2.jpg','book-signing.jpg','launch-group.jpg','launch-group-wide.jpg','book-signing-crowd.jpg','ajtv-0282.jpg','ajtv-0648.jpg','dsc-5746.jpg','dsc-5764.jpg','whatsapp-launch.jpeg','event-0173.jpg','event-0175.jpg','event-0192.jpg','event-0201.jpg','event-0204.jpg','event-5028.jpg','event-5036.jpg','event-5050.jpg','event-5064.jpg','event-5078.jpg','event-5087.jpg'];
---
<InnerPage title="Book Launches by Chance Publishers Kenya" description="Plan a memorable book launch in Nairobi with Chance Publishers. See author celebrations, reader connections and launch support for books published in Kenya.">
  <section class="launch-hero"><div class="hero-copy"><small>CHANCE PUBLISHERS BOOK LAUNCHES</small><h1><span>Your book deserves</span><span>Unforgettable</span><span>Arrival.</span></h1><p>We turn the final step of publishing into a proud introduction—helping authors present their message, meet readers and create momentum that continues after launch day.</p><div class="actions"><a href="/contact">Plan your launch →</a><a href="#launch-gallery">See launch moments</a></div></div><div class="hero-image"><img src="/Images/launch/blooming-launch.jpg" alt="Two people proudly holding a book at a Chance Publishers launch"/><b>THE BOOK IS READY.<br/>LET THE WORLD MEET IT.</b></div></section>
  <section class="launch-intro"><div><small>MORE THAN A CEREMONY</small><h2>A launch gives your book a beginning readers can remember.</h2><p>After months or years of writing, your book deserves more than quietly appearing on a shelf. Chance Publishers helps shape a warm, credible moment around the author, the message and the people the book was written to reach.</p><a href="/contact">Discuss a launch with our team →</a></div><div class="value-grid"><article><span>01</span><h3>Own the moment</h3><p>Present the purpose behind your book with confidence in front of readers, guests and potential partners.</p></article><article><span>02</span><h3>Meet your first readers</h3><p>Create room for conversations, signings, feedback and the personal connections that turn interest into advocacy.</p></article><article><span>03</span><h3>Build lasting visibility</h3><p>Capture photographs, conversations and promotional material that can keep working long after the event.</p></article></div></section>
  <section class="filmstrip" aria-label="Chance Publishers launch highlights"><div class="track">{[...images,...images].map((image,index)=><figure><img src={`/Images/launch/${image}`} alt={`Chance Publishers launch highlight ${index%images.length+1}`} loading="lazy"/></figure>)}</div></section>
  <section class="launch-gallery" id="launch-gallery"><header><small>THE CHANCE LAUNCH ARCHIVE</small><h2>Authors celebrated.<br/><i>Books welcomed into the world.</i></h2><p>Each frame holds something publishing alone cannot create: a proud author, a curious reader and a new conversation beginning.</p></header><div class="masonry">{images.map((image,index)=><figure class={index===0||index===5?'wide':index===3?'tall':''}><img src={`/Images/launch/${image}`} alt="Chance Publishers author and reader launch moment" loading="lazy"/><figcaption><small>CHANCE PUBLISHERS</small><b>{index%3===0?'A proud author moment':index%3===1?'Readers gather around a new book':'A story steps into public life'}</b></figcaption></figure>)}</div></section>
  <section class="launch-path"><div><small>PLANNING YOUR OWN LAUNCH?</small><h2>We help the book, the room and the message work together.</h2></div><div class="path-list"><span><b>01</b>Clarify the launch purpose and audience</span><span><b>02</b>Shape the event story and programme</span><span><b>03</b>Prepare the author and book presentation</span><span><b>04</b>Create moments for readers, media and content</span></div><a href="/contact">Start planning with Chance Publishers →</a></section>
</InnerPage>
<style>
  .launch-hero{min-height:650px;padding:clamp(4rem,7vw,7rem) clamp(1rem,6vw,7rem);display:grid;grid-template-columns:1.08fr .92fr;align-items:center;gap:clamp(2rem,5vw,5rem);overflow:hidden;background:radial-gradient(circle at 12% 15%,rgba(255,210,28,.2),transparent 25%),linear-gradient(135deg,#062b1c,#0b6a3a);color:#fff}.hero-copy small,.launch-intro small,.launch-gallery small,.launch-path small{color:var(--yellow);font-weight:900;letter-spacing:.14em}.hero-copy h1{margin:.8rem 0 1.4rem;font-family:var(--display);font-size:clamp(3rem,4.25vw,4.7rem);line-height:.93;letter-spacing:-.055em}.hero-copy h1 span{display:block;white-space:nowrap}.hero-copy h1 span:nth-child(2),.hero-copy h1 span:nth-child(3){color:var(--yellow)}.hero-copy>p{max-width:640px;color:rgba(255,255,255,.82);font-size:1.05rem;line-height:1.8}.actions{display:flex;gap:.8rem;flex-wrap:wrap;margin-top:2rem}.actions a{padding:1rem 1.2rem;border:1px solid rgba(255,255,255,.28);border-radius:12px;color:#fff;text-decoration:none;font-weight:900}.actions a:first-child{border-color:var(--yellow);background:var(--yellow);color:#173020}.hero-image{position:relative;min-height:490px}.hero-image img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;border:9px solid #fff;border-radius:32px;box-shadow:0 30px 80px rgba(0,0,0,.28)}.hero-image b{position:absolute;right:-1rem;bottom:1.4rem;padding:1rem;border-radius:14px;background:var(--yellow);color:#173020;font-family:var(--display);transform:rotate(3deg)}
  .launch-intro{padding:clamp(5rem,8vw,8rem) clamp(1rem,6vw,7rem);display:grid;grid-template-columns:.85fr 1.15fr;gap:clamp(3rem,7vw,7rem);background:var(--surface)}.launch-intro>div:first-child>small,.launch-gallery header>small{color:var(--green)}.launch-intro h2,.launch-gallery h2,.launch-path h2{margin:.7rem 0 1rem;font-family:var(--display);font-size:clamp(2.8rem,5vw,5rem);line-height:.95}.launch-intro>div:first-child>p{color:var(--muted);line-height:1.8}.launch-intro a{color:var(--deep-green);font-weight:900}.value-grid{display:grid;gap:.8rem}.value-grid article{padding:1.2rem;display:grid;grid-template-columns:auto 1fr;gap:.3rem 1rem;border:1px solid var(--line);border-left:5px solid var(--yellow);border-radius:18px;background:var(--surface-2)}.value-grid span{grid-row:1/3;width:44px;height:44px;display:grid;place-items:center;border-radius:12px;background:var(--soft-green);color:var(--deep-green);font-family:var(--display);font-weight:900}.value-grid h3{margin:.1rem 0;font-family:var(--display)}.value-grid p{margin:0;color:var(--muted);font-size:.75rem;line-height:1.55}
  .filmstrip{padding:1.1rem 0;overflow:hidden;background:#071f15}.track{width:max-content;display:flex;gap:.8rem;animation:scroll 55s linear infinite}.track:hover{animation-play-state:paused}.track figure{width:280px;height:175px;margin:0;overflow:hidden;border:4px solid rgba(255,255,255,.8);border-radius:14px}.track img{width:100%;height:100%;object-fit:cover}@keyframes scroll{to{transform:translateX(-50%)}}
  .launch-gallery{padding:clamp(5rem,8vw,8rem) clamp(1rem,5vw,6rem);background:var(--surface-2)}.launch-gallery header{max-width:880px;margin-bottom:2.5rem}.launch-gallery h2 i{color:var(--green);font-family:"Patrick Hand",cursive;font-weight:400}.launch-gallery header p{max-width:700px;color:var(--muted);line-height:1.75}.masonry{display:grid;grid-template-columns:repeat(4,1fr);grid-auto-rows:260px;gap:.8rem}.masonry figure{position:relative;margin:0;overflow:hidden;border-radius:18px}.masonry .wide{grid-column:span 2}.masonry .tall{grid-row:span 2}.masonry img{width:100%;height:100%;object-fit:cover;transition:.5s}.masonry figure:hover img{transform:scale(1.04)}.masonry figcaption{position:absolute;left:.7rem;right:.7rem;bottom:.7rem;padding:.7rem;display:grid;border-radius:10px;background:rgba(6,31,19,.84);color:#fff;backdrop-filter:blur(8px)}.masonry figcaption small{font-size:.48rem}.masonry figcaption b{font-family:var(--display);font-size:.75rem}
  .launch-path{padding:clamp(4rem,7vw,6rem) clamp(1rem,6vw,7rem);display:grid;grid-template-columns:1fr 1fr;gap:2rem 4rem;background:linear-gradient(135deg,#062b1c,#0b6a3a);color:#fff}.launch-path h2{font-size:clamp(2.4rem,4vw,4.2rem)}.path-list{display:grid;gap:.7rem}.path-list span{padding:.8rem;border-bottom:1px solid rgba(255,255,255,.16);font-weight:800}.path-list b{margin-right:1rem;color:var(--yellow)}.launch-path>a{grid-column:1/-1;width:max-content;padding:1rem 1.2rem;border-radius:12px;background:var(--yellow);color:#173020;text-decoration:none;font-weight:900}
  @media(max-width:900px){.launch-hero,.launch-intro{grid-template-columns:1fr}.hero-image{min-height:410px}.masonry{grid-template-columns:1fr 1fr}.launch-path{grid-template-columns:1fr}.launch-path>a{grid-column:auto}}@media(max-width:600px){.launch-hero{padding:3rem 1rem}.hero-copy h1{font-size:clamp(1.95rem,8.8vw,2.9rem)}.hero-image{min-height:290px}.launch-intro,.launch-gallery,.launch-path{padding-inline:1rem}.track figure{width:220px;height:140px}.masonry{grid-template-columns:1fr;grid-auto-rows:280px}.masonry .wide{grid-column:auto}.masonry .tall{grid-row:auto}}
</style>
