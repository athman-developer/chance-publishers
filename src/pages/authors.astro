---
import InnerPage from '../layouts/InnerPage.astro';
const benefits=[['Editorial partnership','Work with editors who strengthen structure, clarity and language while protecting the voice that makes your work yours.','/publish#process'],['Professional book design','Give readers a confident first impression through purposeful covers, readable interiors and carefully prepared print files.','/publish#design'],['ISBN & legal-deposit guidance','Chance Publishers coordinates the practical publication details and works with KNLS on ISBN requirements for eligible books.','/publish#isbn'],['A launch with meaning','Introduce your work through a launch shaped around the message, audience and author behind the book.','/launches'],['Studio conversations','Extend your ideas beyond the page through author conversations in The Reading Room Studio.','/podcast'],['A path to readers','Prepare your book for local ordering, selected distribution support and continued visibility after publication.','/shop']];
---
<InnerPage title="Authors at Chance Publishers Kenya" description="Discover the authors, educators, researchers and storytellers publishing with Chance Publishers in Nairobi, and learn how we support authors from manuscript to launch.">
  <section class="author-hero"><div class="hero-copy"><small>THE PEOPLE BEHIND THE PAGES</small><h1><span>Meet the Voices</span><span>Shaping Meaningful</span><span>Books.</span></h1><p>Meet writers, educators, researchers and storytellers turning lived experience and original ideas into books that move readers.</p><div class="actions"><a href="/contact">Become a Chance author →</a><a href="#author-support">See author support</a></div></div><div class="hero-image"><img src="/Images/launch/dsc-5764.jpg" alt="A Chance Publishers author presenting a published book"/><b>YOUR VOICE<br/>BELONGS ON THE PAGE</b></div></section>
  <section class="author-story"><div class="story-collage"><figure class="main"><img src="/Images/launch/event-0201.jpg" alt="Author speaking at a Chance Publishers event"/></figure><figure><img src="/Images/launch/event-5087.jpg" alt="Published books on display"/></figure><figure><img src="/Images/launch/event-5028.jpg" alt="Readers at a Chance Publishers event"/></figure></div><div><small>AUTHORS ARE THE BEGINNING</small><h2>Your idea is personal.<br/><i>Its reach can be much bigger.</i></h2><p>Every book begins with someone who has something worth saying. At Chance Publishers, authors are not simply handed from one production stage to another. We build a clear working relationship around the manuscript, the intended reader and the author’s purpose.</p><p>That means honest editorial conversations, professional presentation, practical publishing guidance and an introduction to readers that feels worthy of the work.</p><a href="/publish">Understand the publishing journey →</a></div></section>
  <section class="support" id="author-support"><header><small>WHAT CHANCE AUTHORS GAIN</small><h2>Support around the book—and the person who wrote it.</h2><p>Choose the areas that matter to your journey and follow each link for practical details.</p></header><div class="benefit-grid">{benefits.map((item,index)=><a href={item[2]}><span>0{index+1}</span><h3>{item[0]}</h3><p>{item[1]}</p><b>Learn more →</b></a>)}</div></section>
  <section class="journey"><header><small>FROM WRITER TO PUBLISHED AUTHOR</small><h2>A journey you can understand.</h2></header><div class="journey-line">{[['01','Talk','Share the manuscript and what you want the book to achieve.'],['02','Shape','Review, edit and proofread the writing with purpose.'],['03','Create','Design the cover and interior, then approve a sample.'],['04','Publish','Complete production details and prepare the final copies.'],['05','Introduce','Launch, share and connect the book with readers.']].map(step=><article><span>{step[0]}</span><h3>{step[1]}</h3><p>{step[2]}</p></article>)}</div><div class="journey-links"><a href="/#packages">Compare publishing packages</a><a href="/launches">See launch experiences</a><a href="/podcast">Visit The Reading Room Studio</a><a href="/contact">Speak with our team</a></div></section>
  <section class="author-cta"><div><small>YOUR MANUSCRIPT CAN BE NEXT</small><h2>Let’s make the book readers will remember.</h2><p>Send a short introduction to your manuscript or book idea. Our Nairobi team will explain the next suitable step.</p></div><a href="mailto:chancepublishersltd@gmail.com?subject=Manuscript%20Submission">Submit your manuscript →</a></section>
</InnerPage>
<style>
  .author-hero{min-height:650px;padding:clamp(4rem,7vw,7rem) clamp(1rem,6vw,7rem);display:grid;grid-template-columns:1.08fr .92fr;align-items:center;gap:clamp(2rem,5vw,5rem);overflow:hidden;background:radial-gradient(circle at 12% 15%,rgba(255,210,28,.2),transparent 25%),linear-gradient(135deg,#062b1c,#0b6a3a);color:#fff}.hero-copy small,.author-story small,.support small,.journey small,.author-cta small{color:var(--yellow);font-weight:900;letter-spacing:.14em}.hero-copy h1{margin:.8rem 0 1.4rem;font-family:var(--display);font-size:clamp(3rem,4.25vw,4.7rem);line-height:.93;letter-spacing:-.055em}.hero-copy h1 span{display:block;white-space:nowrap}.hero-copy h1 span:nth-child(2),.hero-copy h1 span:nth-child(3){color:var(--yellow)}.hero-copy>p{max-width:620px;color:rgba(255,255,255,.82);font-size:1.05rem;line-height:1.8}.actions{display:flex;gap:.8rem;flex-wrap:wrap;margin-top:2rem}.actions a{padding:1rem 1.2rem;border:1px solid rgba(255,255,255,.28);border-radius:12px;color:#fff;text-decoration:none;font-weight:900}.actions a:first-child{border-color:var(--yellow);background:var(--yellow);color:#173020}.hero-image{position:relative;min-height:490px}.hero-image img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;border:9px solid #fff;border-radius:32px;box-shadow:0 30px 80px rgba(0,0,0,.28)}.hero-image b{position:absolute;right:-1rem;bottom:1.4rem;padding:1rem;border-radius:14px;background:var(--yellow);color:#173020;font-family:var(--display);transform:rotate(3deg)}
  .author-story{padding:clamp(5rem,8vw,8rem) clamp(1rem,6vw,7rem);display:grid;grid-template-columns:1.05fr .95fr;align-items:center;gap:clamp(3rem,7vw,7rem);background:var(--surface-2)}.story-collage{min-height:520px;display:grid;grid-template-columns:1.3fr .7fr;grid-template-rows:1fr 1fr;gap:.8rem}.story-collage figure{margin:0;overflow:hidden;border-radius:20px}.story-collage .main{grid-row:1/3}.story-collage img{width:100%;height:100%;object-fit:cover}.author-story>div:last-child>small,.support small,.journey small{color:var(--green)}.author-story h2,.support h2,.journey h2,.author-cta h2{margin:.7rem 0;font-family:var(--display);font-size:clamp(2.8rem,5vw,5rem);line-height:.95}.author-story h2 i{color:var(--green);font-family:"Patrick Hand",cursive;font-weight:400}.author-story p,.support header p{color:var(--muted);line-height:1.8}.author-story a{color:var(--deep-green);font-weight:900}
  .support{padding:clamp(5rem,8vw,8rem) clamp(1rem,6vw,7rem);background:var(--surface)}.support header{max-width:850px}.benefit-grid{margin-top:2.5rem;display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.benefit-grid a{padding:1.4rem;display:flex;flex-direction:column;border:1px solid var(--line);border-radius:20px;background:var(--surface-2);color:var(--text);text-decoration:none;transition:.25s}.benefit-grid a:hover{transform:translateY(-6px);border-color:var(--green);box-shadow:0 18px 45px rgba(15,70,35,.12)}.benefit-grid span{width:44px;height:44px;display:grid;place-items:center;border-radius:12px;background:var(--yellow);font-family:var(--display);font-weight:900}.benefit-grid h3{font-family:var(--display);font-size:1.2rem}.benefit-grid p{color:var(--muted);line-height:1.65}.benefit-grid b{margin-top:auto;color:var(--green);font-size:.72rem}
  .journey{padding:clamp(5rem,8vw,8rem) clamp(1rem,6vw,7rem);background:linear-gradient(135deg,#061f14,#0b6239);color:#fff}.journey-line{margin-top:2.5rem;display:grid;grid-template-columns:repeat(5,1fr);gap:.8rem}.journey-line article{padding:1.1rem;border:1px solid rgba(255,255,255,.16);border-radius:17px;background:rgba(255,255,255,.07)}.journey-line span{color:var(--yellow);font-family:var(--display)}.journey-line h3{font-family:var(--display)}.journey-line p{color:rgba(255,255,255,.68);font-size:.72rem;line-height:1.55}.journey-links{margin-top:2rem;display:flex;gap:.6rem;flex-wrap:wrap}.journey-links a{padding:.7rem .85rem;border-radius:999px;background:rgba(255,255,255,.1);color:#fff;text-decoration:none;font-size:.68rem;font-weight:900}.author-cta{padding:3rem clamp(1rem,6vw,7rem);display:flex;align-items:center;justify-content:space-between;gap:3rem;background:var(--yellow);color:#173020}.author-cta small{color:#0a6638}.author-cta h2{font-size:clamp(2rem,4vw,4rem)}.author-cta p{max-width:700px}.author-cta>a{flex:0 0 auto;padding:1rem 1.2rem;border-radius:12px;background:#0a6739;color:#fff;text-decoration:none;font-weight:900}
  @media(max-width:900px){.author-hero,.author-story{grid-template-columns:1fr}.hero-image{min-height:410px}.benefit-grid{grid-template-columns:1fr 1fr}.journey-line{grid-template-columns:1fr 1fr}.author-cta{display:block}.author-cta>a{display:inline-block;margin-top:1rem}}@media(max-width:600px){.author-hero{padding:3rem 1rem}.hero-copy h1{font-size:clamp(2rem,9vw,3rem)}.hero-image{min-height:290px}.author-story,.support,.journey{padding-inline:1rem}.story-collage{min-height:400px}.benefit-grid,.journey-line{grid-template-columns:1fr}.author-cta{padding-inline:1rem}}
</style>
