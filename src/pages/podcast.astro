---
import InnerPage from '../layouts/InnerPage.astro';
const episodes=[
  {title:'Radicalization',id:'1EcVLRMj0Fs'},
  {title:'Unrest, Unspoken',id:'kpqA5UIqWqc'},
  {title:'Best Effect Book',id:'kXrZX3nT83c'},
  {title:'Unrest, Unspoken: Are We Failing Our Teens? | The Mental Health Crisis Behind School Arson in Kenya',id:'RStO-Zh0PPU'},
];
---
<InnerPage title="The Reading Room Studio" description="Watch conversations with authors, readers and thinkers from The Reading Room Studio by Chance Publishers in Nairobi, Kenya."><section class="podcast-hero"><img src="/Images/backgrounds/reading-room-studio.jpg" alt="The Reading Room Studio by Chance Publishers"/><div><small>THE READING ROOM STUDIO</small><h1>Conversations behind the books.</h1><p>Authors, readers and thinkers explore the ideas, experiences and questions that continue beyond the final page.</p><a href="#episodes">Browse episodes ↓</a></div></section><section class="episodes" id="episodes"><div class="episode-head"><div><small>WATCH • LISTEN • GROW</small><h2>Latest conversations</h2></div><div><p>Straight from our YouTube channel — new conversations added as they go live.</p><a class="channel-link" href="https://www.youtube.com/channel/UCwZnkEv1QXSZl__RFS8ehUA" target="_blank" rel="noopener">Visit our YouTube channel ↗</a></div></div><div class="episode-grid">{episodes.map((episode,index)=><a href={`https://www.youtube.com/watch?v=${episode.id}`} target="_blank" rel="noopener" class="episode"><div class="placeholder"><img src={`https://i.ytimg.com/vi/${episode.id}/hqdefault.jpg`} alt={episode.title} loading="lazy"/><i>▶</i></div><small>EPISODE {String(index+1).padStart(2,'0')}</small><h3>{episode.title}</h3><p>Watch on YouTube →</p></a>)}</div></section></InnerPage>
<style>.podcast-hero{position:relative;min-height:680px;display:grid;place-items:center;overflow:hidden;color:#fff;text-align:center}.podcast-hero>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.podcast-hero::after{content:"";position:absolute;inset:0;background:rgba(8,4,10,.42)}.podcast-hero>div{position:relative;z-index:2;width:min(760px,90%)}.podcast-hero small,.episodes small{color:var(--yellow);font-weight:900;letter-spacing:.13em}.podcast-hero h1{margin:.7rem 0;font-family:var(--display);font-size:clamp(3.2rem,7vw,7rem);line-height:.9}.podcast-hero p{font-size:1.05rem;line-height:1.8}.podcast-hero a{display:inline-block;margin-top:1rem;padding:1rem 1.2rem;border-radius:12px;background:var(--yellow);color:#172315;text-decoration:none;font-weight:900}.episodes{padding:5rem clamp(1rem,5vw,6rem);background:var(--surface-2)}.episode-head{display:flex;justify-content:space-between;align-items:end;gap:3rem;margin-bottom:2.5rem}.episode-head h2{margin:.5rem 0 0;font-family:var(--display);font-size:clamp(2.5rem,5vw,4.5rem)}.episode-head p{max-width:420px;color:var(--muted);line-height:1.7}.channel-link{display:inline-block;margin-top:.8rem;color:var(--green);font-weight:900;font-size:.8rem;text-decoration:none}.channel-link:hover{text-decoration:underline}.episode-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:2rem 1.2rem}.episode{color:var(--text);text-decoration:none}.placeholder{position:relative;aspect-ratio:16/9;border-radius:18px;background:#10261a;overflow:hidden;transition:.3s ease}.placeholder img{width:100%;height:100%;object-fit:cover;transition:.4s ease}.episode:hover .placeholder img{transform:scale(1.05)}.placeholder i{position:absolute;left:50%;top:50%;width:54px;height:54px;display:grid;place-items:center;border-radius:50%;background:var(--yellow);color:#172315;transform:translate(-50%,-50%);font-style:normal;box-shadow:0 10px 30px rgba(0,0,0,.35)}.episode>small{display:block;margin-top:.8rem;color:var(--green)}.episode h3{margin:.3rem 0;font-family:var(--display);font-size:1.25rem}.episode p{color:var(--muted);font-size:.8rem}@media(max-width:760px){.episode-head{display:block}.episode-grid{grid-template-columns:1fr 1fr}}@media(max-width:480px){.episode-grid{gap:1.2rem .8rem}.placeholder i{width:38px;height:38px}.episode h3{font-size:.92rem}.episode p{font-size:.68rem}}</style>
