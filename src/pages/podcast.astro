---
import InnerPage from '../layouts/InnerPage.astro';
const episodes=['What makes a book stay with you?','From manuscript to meaningful book','The courage to tell your story','Writing leadership for Africa','Why children need local stories','Books, identity and belonging'];
---
<InnerPage title="The Reading Room Studio" description="Watch conversations with authors, readers and thinkers from The Reading Room Studio by Chance Publishers in Nairobi, Kenya."><section class="podcast-hero"><img src="/Images/backgrounds/reading-room-studio.png" alt="The Reading Room Studio by Chance Publishers"/><div><small>THE READING ROOM STUDIO</small><h1>Conversations behind the books.</h1><p>Authors, readers and thinkers explore the ideas, experiences and questions that continue beyond the final page.</p><a href="#episodes">Browse episodes ↓</a></div></section><section class="episodes" id="episodes"><div class="episode-head"><div><small>WATCH • LISTEN • GROW</small><h2>Latest conversations</h2></div><p>These are designed as replaceable studio thumbnails. Add the final artwork and YouTube links when they are ready.</p></div><div class="episode-grid">{episodes.map((episode,index)=><a href="#youtube-link" class="episode"><div class={`placeholder p${index+1}`}><span>🎙</span><b>THE READING ROOM STUDIO</b><i>▶</i></div><small>EPISODE {String(index+1).padStart(2,'0')}</small><h3>{episode}</h3><p>Watch on YouTube →</p></a>)}</div></section></InnerPage>
<style>.podcast-hero{position:relative;min-height:680px;display:grid;place-items:center;overflow:hidden;color:#fff;text-align:center}.podcast-hero>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.podcast-hero::after{content:"";position:absolute;inset:0;background:rgba(8,4,10,.42)}.podcast-hero>div{position:relative;z-index:2;width:min(760px,90%)}.podcast-hero small,.episodes small{color:var(--yellow);font-weight:900;letter-spacing:.13em}.podcast-hero h1{margin:.7rem 0;font-family:var(--display);font-size:clamp(3.2rem,7vw,7rem);line-height:.9}.podcast-hero p{font-size:1.05rem;line-height:1.8}.podcast-hero a{display:inline-block;margin-top:1rem;padding:1rem 1.2rem;border-radius:12px;background:var(--yellow);color:#172315;text-decoration:none;font-weight:900}.episodes{padding:5rem clamp(1rem,5vw,6rem);background:var(--surface-2)}.episode-head{display:flex;justify-content:space-between;align-items:end;gap:3rem;margin-bottom:2.5rem}.episode-head h2{margin:.5rem 0 0;font-family:var(--display);font-size:clamp(2.5rem,5vw,4.5rem)}.episode-head p{max-width:420px;color:var(--muted);line-height:1.7}.episode-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:2rem 1.2rem}.episode{color:var(--text);text-decoration:none}.placeholder{position:relative;aspect-ratio:16/10;padding:1.2rem;display:flex;align-items:flex-start;justify-content:space-between;border-radius:18px;background:linear-gradient(135deg,#341538,#ef61ad);color:#fff;overflow:hidden}.p2{background:linear-gradient(135deg,#063d27,#16ad59)}.p3{background:linear-gradient(135deg,#3b2c00,#e5b700)}.p4{background:linear-gradient(135deg,#13264b,#7162e8)}.p5{background:linear-gradient(135deg,#491813,#ff8b74)}.p6{background:linear-gradient(135deg,#102924,#40b8aa)}.placeholder span{font-size:2.2rem}.placeholder b{font-family:var(--display);font-size:.75rem;letter-spacing:.1em}.placeholder i{position:absolute;left:50%;top:50%;width:54px;height:54px;display:grid;place-items:center;border-radius:50%;background:var(--yellow);color:#172315;transform:translate(-50%,-50%);font-style:normal}.episode>small{display:block;margin-top:.8rem;color:var(--green)}.episode h3{margin:.3rem 0;font-family:var(--display);font-size:1.25rem}.episode p{color:var(--muted);font-size:.8rem}@media(max-width:760px){.episode-head{display:block}.episode-grid{grid-template-columns:1fr 1fr}}@media(max-width:480px){.episode-grid{grid-template-columns:1fr}}</style>
