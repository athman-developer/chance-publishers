---
import InnerPage from '../../layouts/InnerPage.astro';import {packages} from '../../data/packages.js';
export function getStaticPaths(){return packages.map(pkg=>({params:{tier:pkg.slug},props:{pkg}}))}
const {pkg}=Astro.props;
const serviceImage=(title,index)=>{const name=title.toLowerCase();if(name.includes('proofread'))return 'https://images.pexels.com/photos/7967586/pexels-photo-7967586.jpeg?auto=compress&cs=tinysrgb&w=900';if(name.includes('edit'))return 'https://images.pexels.com/photos/7968806/pexels-photo-7968806.jpeg?auto=compress&cs=tinysrgb&w=900';if(name.includes('cover')||name.includes('brand')||name.includes('marketing'))return 'https://images.pexels.com/photos/13451104/pexels-photo-13451104.jpeg?auto=compress&cs=tinysrgb&w=900';if(name.includes('launch')||name.includes('priority'))return 'https://images.pexels.com/photos/9297454/pexels-photo-9297454.jpeg?auto=compress&cs=tinysrgb&w=900';if(name.includes('layout')||name.includes('sample')||name.includes('everything'))return 'https://images.pexels.com/photos/4865543/pexels-photo-4865543.jpeg?auto=compress&cs=tinysrgb&w=900';if(name.includes('distribution')||name.includes('sales')||name.includes('digital'))return 'https://images.pexels.com/photos/8472371/pexels-photo-8472371.jpeg?auto=compress&cs=tinysrgb&w=900';return index%2?'https://images.pexels.com/photos/6963779/pexels-photo-6963779.jpeg?auto=compress&cs=tinysrgb&w=900':'https://images.pexels.com/photos/4865543/pexels-photo-4865543.jpeg?auto=compress&cs=tinysrgb&w=900'};
---
<InnerPage title={`${pkg.name} Publishing Package`} description={`${pkg.name} publishing package from Chance Publishers`}>
  <section class={`tier-hero ${pkg.slug}`}><div class="tier-glow"></div><a href="/#packages">← Back to packages</a><div class="tier-hero-grid"><div><span class="tier-label">CHANCE PUBLISHERS PACKAGE</span><h1>{pkg.name}<br/>Publishing Package</h1><p>{pkg.intro}</p><div class="tier-price"><small>KSh</small><b>{pkg.price}</b><span>Printing quoted separately</span></div></div><div class="hero-medal"><span>{pkg.number}</span><small>{pkg.tagline}</small></div></div></section>
  <section class="service-intro" id="services"><div><small>WHAT YOU RECEIVE</small><h2>Every service,<br/>clearly explained.</h2></div><p>See the professional work behind your selected package—from editorial care and book design to launch preparation, distribution and reader visibility.</p></section>
  <section class="service-grid">{pkg.services.map((service,index)=><article class={`service-card ${index%2===1||service[0].startsWith('Everything')?'image-right':''}`}><div class="service-image"><img src={serviceImage(service[0],index)} alt={`${service[0]} publishing service`} loading="lazy"/><span class="service-icon">{service[2]}</span><small>CHANCE PUBLISHERS SUPPORT</small></div><div class="service-copy"><span>0{index+1}</span><h3>{service[0]}</h3><p>{service[1]}</p></div></article>)}</section>
  <section class="package-journey"><div><small>HOW IT WORKS</small><h2>A guided path from manuscript to book.</h2></div><ol><li><b>Consultation</b><span>Discuss your manuscript, goals, audience and package.</span></li><li><b>Editorial and design</b><span>Your book moves through the selected professional services.</span></li><li><b>Sample approval</b><span>Review the dummy copy and confirm final corrections.</span></li><li><b>Print and launch</b><span>Receive a custom print quotation and plan the next stage.</span></li></ol></section>
  <section class="tier-checkout"><div><small>READY WHEN YOU ARE</small><h2>Continue with the {pkg.name} Package.</h2><p>A Chance Publishers team member will confirm your manuscript requirements, printing needs and final quotation before payment.</p></div><div><span>KSh <b>{pkg.price}</b></span><a href={`/publish?package=${pkg.slug}`}>Proceed to checkout <strong>↗</strong></a><button class="consult" type="button" data-tier-consult>Request a consultation</button></div></section>
  <dialog class="tier-consult-dialog" data-tier-dialog><button class="dialog-close" type="button" data-tier-close aria-label="Close consultation choices">×</button><small>FREE PUBLISHING CONSULTATION</small><h2>Speak with Chance Publishers.</h2><p>Choose how you would like to discuss the {pkg.name} Package with our Nairobi publishing team.</p><div class="dialog-options"><a href="tel:+254758305622"><span>Phone call</span><b>+254 758 305 622 →</b></a><a href={`mailto:info@chancepublishers.com?subject=${pkg.name}%20Package%20Consultation`}><span>Email</span><b>info@chancepublishers.com →</b></a><a class="all-contact" href="/contact"><span>All contact options</span><b>Open Contact page →</b></a></div></dialog>
</InnerPage>
<script>const dialog=document.querySelector('[data-tier-dialog]');document.querySelector('[data-tier-consult]')?.addEventListener('click',()=>dialog?.showModal());document.querySelector('[data-tier-close]')?.addEventListener('click',()=>dialog?.close());dialog?.addEventListener('click',event=>{if(event.target===dialog)dialog.close()});</script>
<style>.tier-hero{--metal:#b87333;position:relative;padding:2rem clamp(1rem,6vw,7rem) 6rem;overflow:hidden;background:radial-gradient(circle at 85% 20%,color-mix(in srgb,var(--metal) 28%,transparent),transparent 30%),linear-gradient(140deg,#061e14,#093d27);color:#fff}.tier-hero.silver{--metal:#dce5e8}.tier-hero.gold{--metal:#ffd21c}.tier-hero>a{color:#fff;text-decoration:none;font-weight:800}.tier-hero-grid{min-height:520px;display:grid;grid-template-columns:1.2fr .8fr;align-items:center;gap:4rem}.tier-label,.service-intro small,.package-journey small,.tier-checkout small{color:var(--metal);font-size:.65rem;font-weight:900;letter-spacing:.16em}.tier-hero h1{margin:.8rem 0;font-family:var(--display);font-size:clamp(3.4rem,7vw,7.2rem);line-height:.88;letter-spacing:-.06em}.tier-hero p{max-width:660px;color:rgba(255,255,255,.76);font-size:1.05rem;line-height:1.75}.tier-price{display:flex;align-items:baseline;gap:.5rem}.tier-price small{color:var(--metal);font-weight:900}.tier-price b{font-family:var(--display);font-size:2.4rem}.tier-price span{color:rgba(255,255,255,.5);font-size:.65rem}.hero-medal{justify-self:center;width:300px;height:300px;padding:25px;display:grid;place-content:center;border:2px solid color-mix(in srgb,var(--metal) 70%,white);border-radius:50%;background:linear-gradient(145deg,color-mix(in srgb,var(--metal) 72%,white),var(--metal));color:#173020;text-align:center;box-shadow:0 30px 100px color-mix(in srgb,var(--metal) 28%,transparent)}.hero-medal>span{font-family:Georgia,serif;font-size:6rem;font-weight:900}.hero-medal small{max-width:190px;font-family:var(--display);font-size:.65rem;font-weight:900;text-transform:uppercase}.service-intro{padding:5rem clamp(1rem,6vw,7rem) 2.5rem;display:flex;align-items:end;justify-content:space-between;gap:3rem}.service-intro small,.package-journey small,.tier-checkout small{color:var(--green)}.service-intro h2,.package-journey h2,.tier-checkout h2{margin:.5rem 0;font-family:var(--display);font-size:clamp(2.7rem,5vw,4.8rem);line-height:1}.service-intro>p{max-width:520px;color:var(--muted);line-height:1.75}.service-grid{padding:0 clamp(1rem,6vw,7rem) 6rem;display:grid;grid-template-columns:repeat(2,1fr);gap:1.2rem}.service-card{min-height:280px;display:grid;grid-template-columns:210px 1fr;overflow:hidden;border:1px solid var(--line);border-radius:22px;background:var(--surface);box-shadow:0 15px 40px rgba(20,70,35,.07)}.service-card.image-right{grid-template-columns:1fr 210px}.service-card.image-right .service-image{order:2}.service-card.image-right .service-copy{order:1}.service-image{position:relative;min-width:0;overflow:hidden;background:var(--soft-green);color:#fff}.service-image>img{width:100%;height:100%;min-height:280px;object-fit:cover;transition:transform .5s ease}.service-card:hover .service-image>img{transform:scale(1.05)}.service-image::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent 35%,rgba(5,29,17,.82))}.service-icon{position:absolute;z-index:2;left:1rem;top:1rem;width:44px;height:44px;display:grid;place-items:center;border-radius:12px;background:var(--yellow);color:#173020;font-family:var(--display);font-size:1.25rem}.service-image small{position:absolute;z-index:2;left:1rem;right:1rem;bottom:1rem;color:#fff;font-size:.48rem;font-weight:900;letter-spacing:.1em}.service-copy{padding:1.5rem}.service-copy>span{color:var(--green);font-weight:900}.service-card h3{margin:.4rem 0;font-family:var(--display);font-size:1.3rem}.service-card p{color:var(--muted);font-size:.83rem;line-height:1.7}.package-journey{padding:5rem clamp(1rem,6vw,7rem);background:var(--surface-2)}.package-journey>div{max-width:720px}.package-journey ol{margin:2.5rem 0 0;padding:0;display:grid;grid-template-columns:repeat(4,1fr);gap:1rem;list-style:none;counter-reset:steps}.package-journey li{position:relative;padding:1.3rem;border-top:4px solid var(--green);border-radius:18px;background:var(--surface);counter-increment:steps}.package-journey li::before{content:'0' counter(steps);display:block;margin-bottom:1rem;color:var(--green);font-family:var(--display);font-size:1.5rem}.package-journey li b,.package-journey li span{display:block}.package-journey li b{font-family:var(--display)}.package-journey li span{margin-top:.5rem;color:var(--muted);font-size:.75rem;line-height:1.5}.tier-checkout{padding:5rem clamp(1rem,6vw,7rem);display:grid;grid-template-columns:1fr auto;align-items:center;gap:4rem;background:linear-gradient(130deg,#ffe15a,var(--yellow));color:#173020}.tier-checkout p{max-width:720px;line-height:1.7}.tier-checkout>div:last-child{min-width:280px;display:grid;gap:.7rem}.tier-checkout>div:last-child>span{font-size:.8rem}.tier-checkout>div:last-child>span b{font-family:var(--display);font-size:2rem}.tier-checkout a,.tier-checkout button{padding:1rem;display:flex;justify-content:space-between;border:0;border-radius:11px;background:#0b5f36;color:#fff;text-decoration:none;font-weight:900;cursor:pointer}.tier-checkout button.consult{justify-content:center;background:rgba(255,255,255,.65);color:#173020}.tier-consult-dialog{width:min(560px,calc(100vw - 2rem));padding:2rem;border:1px solid rgba(255,255,255,.18);border-radius:26px;background:linear-gradient(145deg,#092d1c,#061b12);color:#fff;box-shadow:0 35px 120px rgba(0,0,0,.55)}.tier-consult-dialog::backdrop{background:rgba(3,12,8,.72);backdrop-filter:blur(7px)}.dialog-close{position:absolute;right:1rem;top:1rem;width:38px;height:38px;border:1px solid rgba(255,255,255,.2);border-radius:50%;background:rgba(255,255,255,.08);color:#fff;font-size:1.3rem;cursor:pointer}.tier-consult-dialog>small{color:var(--yellow);font-weight:900;letter-spacing:.13em}.tier-consult-dialog h2{margin:.5rem 0;font-family:var(--display);font-size:2.2rem}.tier-consult-dialog>p{color:rgba(255,255,255,.7);line-height:1.65}.dialog-options{display:grid;gap:.7rem;margin-top:1.4rem}.dialog-options a{padding:1rem;display:flex;justify-content:space-between;gap:1rem;border:1px solid rgba(255,255,255,.14);border-radius:12px;background:rgba(255,255,255,.07);color:#fff;text-decoration:none}.dialog-options span{color:var(--yellow);font-weight:900}.dialog-options b{font-size:.72rem}.dialog-options .all-contact{background:var(--yellow);color:#173020}.dialog-options .all-contact span{color:#173020}@media(max-width:900px){.service-grid{grid-template-columns:1fr}}@media(max-width:800px){.tier-hero-grid,.tier-checkout{grid-template-columns:1fr}.hero-medal{width:220px;height:220px}.service-intro{display:block}.package-journey ol{grid-template-columns:1fr 1fr}}@media(max-width:520px){.service-card,.service-card.image-right{grid-template-columns:1fr}.service-card.image-right .service-image{order:0}.service-image{min-height:190px}.service-image>img{min-height:190px}.package-journey ol{grid-template-columns:1fr}.tier-consult-dialog{padding:1.5rem}.dialog-options a{display:grid}}</style>
