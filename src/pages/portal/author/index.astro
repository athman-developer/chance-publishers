---
export const prerender = false;
import PortalLayout from '../../../layouts/PortalLayout.astro';
import { prisma } from '../../../lib/db';
import { STAGE_LABELS } from '../../../lib/workflow';

const user = Astro.locals.user!;
const projects = await prisma.bookProject.findMany({
  where: { authorId: user.id },
  orderBy: { createdAt: 'desc' },
});
const fullName = user.authorProfile?.fullLegalName || user.email;
const firstName = fullName.split(' ')[0];

const packages = await prisma.publishingPackage.findMany({ orderBy: { sortOrder: 'asc' } });
const unreadNotifications = await prisma.notification.count({ where: { userId: user.id, readAt: null } });

const steps = [
  { n: '01', title: 'Sign your NDA', body: 'Protect your manuscript with a signed non-disclosure agreement before anything is submitted.' },
  { n: '02', title: 'Submit your manuscript', body: 'Upload your draft and choose the publishing package that fits your book.' },
  { n: '03', title: 'Editorial & design', body: 'Our team edits, proofreads and designs your cover and interior layout.' },
  { n: '04', title: 'Print, publish & launch', body: 'Approve your printed sample, then publish, distribute and launch your book.' },
];
---
<PortalLayout title="Dashboard" user={user} section="author">
  <div class="dash-header">
    <h1>Good day, {firstName}.</h1>
    {!user.emailVerified && <p class="verify-banner">Please verify your email — check your inbox for a link from Chance Publishers.</p>}
  </div>

  {projects.length === 0 ? (
    <div class="empty-state">
      <h2>You don't have a book project yet</h2>
      <p>Start your manuscript submission — you'll enter your book details, choose a publishing package, and complete your NDA before uploading your manuscript.</p>
      <a class="btn-primary" href="/portal/author/projects/new">Start a new book project</a>
    </div>
  ) : (
    <div class="project-grid">
      {projects.map((p) => (
        <a class="project-card" href={`/portal/author/projects/${p.id}`}>
          <small>{p.projectNumber}</small>
          <h3>{p.title}</h3>
          <div class="progress-track"><div class="progress-fill" style={`width:${p.overallProgress}%`}></div></div>
          <span>{p.overallProgress}% complete — {STAGE_LABELS[p.currentStageKey] || p.currentStageKey.replaceAll('_', ' ')}</span>
        </a>
      ))}
      <a class="project-card new-card" href="/portal/author/projects/new">+ Start another book</a>
    </div>
  )}

  <div class="quick-links">
    <a class="quick-link" href="/portal/notifications">
      <span class="ql-icon">🔔</span>
      <div><strong>Notifications</strong><small>{unreadNotifications > 0 ? `${unreadNotifications} unread` : 'All caught up'}</small></div>
    </a>
    <a class="quick-link" href="/printing-estimate">
      <span class="ql-icon">🖨️</span>
      <div><strong>Printing estimate</strong><small>Get a print run quote</small></div>
    </a>
    <a class="quick-link" href="/launches">
      <span class="ql-icon">🎉</span>
      <div><strong>Request a launch</strong><small>Plan your book launch</small></div>
    </a>
    <a class="quick-link" href="/publish">
      <span class="ql-icon">📦</span>
      <div><strong>Publishing packages</strong><small>Compare Bronze, Silver, Gold</small></div>
    </a>
  </div>

  <section class="how-it-works">
    <h2>How publishing with us works</h2>
    <div class="steps-grid">
      {steps.map((s) => (
        <div class="step-card">
          <span class="step-n">{s.n}</span>
          <h3>{s.title}</h3>
          <p>{s.body}</p>
        </div>
      ))}
    </div>
  </section>

  {packages.length > 0 && (
    <section class="packages-preview">
      <h2>Publishing packages</h2>
      <div class="pkg-grid">
        {packages.map((pkg) => (
          <div class="pkg-card">
            <h3>{pkg.name}</h3>
            <p class="pkg-price">KSh {Number(pkg.priceKes).toLocaleString()}</p>
            <a href="/publish">View details →</a>
          </div>
        ))}
      </div>
    </section>
  )}
</PortalLayout>
<style>
  .dash-header h1{margin:0 0 .3rem;font-family:var(--display);font-size:2rem;letter-spacing:-.02em}
  .verify-banner{margin:0 0 1.5rem;padding:.7rem 1rem;border-radius:10px;background:#fff8e1;color:#8a6800;font-size:.82rem;font-weight:700;display:inline-block}
  .empty-state{margin-top:2rem;padding:3rem 2rem;text-align:center;background:var(--surface);border:1px dashed var(--line);border-radius:20px}
  .empty-state h2{margin:0 0 .6rem;font-family:var(--display);font-size:1.4rem}
  .empty-state p{max-width:460px;margin:0 auto 1.5rem;color:var(--muted);line-height:1.6}
  .btn-primary{display:inline-block;padding:.9rem 1.4rem;border-radius:12px;background:var(--green);color:#fff;font-weight:800;text-decoration:none;box-shadow:0 6px 0 var(--deep-green)}
  .project-grid{margin-top:2rem;display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:1.2rem}
  .project-card{padding:1.5rem;background:var(--surface);border:1px solid var(--line);border-radius:16px;text-decoration:none;color:var(--text);display:grid;gap:.5rem}
  .project-card small{color:var(--green);font-weight:800;font-size:.68rem;letter-spacing:.08em}
  .project-card h3{margin:0;font-family:var(--display);font-size:1.15rem}
  .progress-track{height:8px;border-radius:99px;background:var(--soft-green);overflow:hidden}
  .progress-fill{height:100%;background:var(--green)}
  .project-card span{font-size:.78rem;color:var(--muted);font-weight:700}
  .new-card{display:grid;place-items:center;color:var(--green);font-weight:800;border-style:dashed}

  .quick-links{margin-top:2.5rem;display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:1rem}
  .quick-link{display:flex;align-items:center;gap:.9rem;padding:1.1rem 1.2rem;background:var(--surface);border:1px solid var(--line);border-radius:14px;text-decoration:none;color:var(--text)}
  .quick-link:hover{border-color:var(--green)}
  .ql-icon{font-size:1.4rem}
  .quick-link strong{display:block;font-size:.9rem}
  .quick-link small{color:var(--muted);font-size:.76rem}

  .how-it-works{margin-top:3rem}
  .how-it-works h2,.packages-preview h2{margin:0 0 1.2rem;font-family:var(--display);font-size:1.3rem}
  .steps-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:1.2rem}
  .step-card{padding:1.4rem;background:var(--surface);border:1px solid var(--line);border-radius:16px}
  .step-n{display:inline-block;margin-bottom:.6rem;font-family:var(--display);font-size:1.1rem;color:var(--green)}
  .step-card h3{margin:0 0 .4rem;font-size:1rem}
  .step-card p{margin:0;color:var(--muted);font-size:.82rem;line-height:1.6}

  .packages-preview{margin-top:3rem}
  .pkg-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:1.2rem}
  .pkg-card{padding:1.4rem;text-align:center;background:var(--surface);border:1px solid var(--line);border-radius:16px}
  .pkg-card h3{margin:0 0 .4rem;font-family:var(--display);font-size:1.1rem}
  .pkg-price{margin:0 0 .8rem;color:var(--deep-green);font-weight:800;font-size:1.2rem}
  .pkg-card a{color:var(--green);font-weight:800;font-size:.82rem;text-decoration:none}
</style>
