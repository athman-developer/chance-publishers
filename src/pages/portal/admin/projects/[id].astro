---
export const prerender = false;
import PortalLayout from '../../../../layouts/PortalLayout.astro';
import { prisma } from '../../../../lib/db';
import { listAssignableEmployees } from '../../../../lib/workload';
import { TASK_TYPES } from '../../../../lib/workflow';

const user = Astro.locals.user!;
const { id } = Astro.params;

const project = await prisma.bookProject.findUnique({
  where: { id },
  include: {
    author: { include: { authorProfile: true } },
    package: true,
    tasks: { include: { assignedToUser: { include: { employeeProfile: true, partnerProfile: true } } }, orderBy: { createdAt: 'desc' } },
    ndaAgreement: true,
    quotations: { orderBy: { createdAt: 'desc' } },
    invoices: { include: { payments: true }, orderBy: { createdAt: 'desc' } },
    printJobs: { orderBy: { createdAt: 'desc' } },
    fileAssets: { where: { kind: 'MANUSCRIPT' }, orderBy: { version: 'desc' } },
    distributionListings: true,
  },
});
if (!project) return Astro.redirect('/portal/admin');

const kdpListing = project.distributionListings.find((d) => d.platform === 'AMAZON_KDP');
const DISTRIBUTION_STATUS_LABEL: Record<string, string> = {
  NOT_STARTED: 'Not started',
  AUTHOR_INVITED_ADMIN: 'Author sent invite — needs accepting',
  ADMIN_ACCESS_CONFIRMED: 'Access confirmed — ready to upload',
  UPLOADED: 'Uploaded — awaiting Amazon review',
  LIVE: 'Live on Amazon',
};

const employees = await listAssignableEmployees();
const error = Astro.url.searchParams.get('error');

const totalPaid = project.invoices.reduce(
  (sum, inv) => sum + inv.payments.filter((p) => p.status === 'VERIFIED').reduce((s, p) => s + Number(p.amountKes), 0),
  0,
);
const totalInvoiced = project.invoices.reduce((sum, inv) => sum + Number(inv.amountKes), 0);
const activity = await prisma.activityEvent.findMany({ where: { projectId: id }, orderBy: { createdAt: 'desc' }, take: 30 });

const teamMembers = [...new Map(project.tasks.filter((t) => t.assignedToUser).map((t) => [t.assignedToUser!.id, t.assignedToUser!])).values()];
const contactGrants = await prisma.contactShareGrant.findMany({ where: { projectId: id, revokedAt: null } });
const grantByEmployee = new Map(contactGrants.map((g) => [g.employeeUserId, g]));

const siteUrl = Astro.url.origin;
const shareLink = project.shareToken ? `${siteUrl}/portal/share/${project.shareToken}` : null;
const updateSent = Astro.url.searchParams.get('updateSent');
---
<PortalLayout title={project.title} user={user} section="admin">
  <a class="back-link" href="/portal/admin">← Dashboard</a>
  <div class="header-row">
    <div>
      <small>{project.projectNumber}</small>
      <h1>{project.title}</h1>
      <p class="muted">{project.author.authorProfile?.fullLegalName || project.author.email}</p>
    </div>
    <div style="display:flex;gap:.6rem;align-items:center">
      <a class="btn-link" href={`/portal/projects/${id}/messages`}>💬 Messages</a>
      <span class="status-chip">{project.status.replaceAll('_', ' ')} · {project.overallProgress}%</span>
    </div>
  </div>

  {error === 'missing-fields' && <div class="banner error">Please choose a task type and an assignee.</div>}
  {error === 'no-file' && <div class="banner error">Please choose a file to upload.</div>}
  {error === 'file-too-large' && <div class="banner error">That file is over the 4MB limit — please compress it or split it into parts.</div>}
  {error === 'unsupported-file-type' && <div class="banner error">That file type isn't supported. Use Word, PDF, RTF or ODT.</div>}
  {Astro.url.searchParams.get('manuscript') === 'submitted' && <div class="banner ok">Manuscript uploaded.</div>}
  {updateSent && updateSent !== 'none' && <div class="banner ok">Update sent via {updateSent.split(',').join(', ')}.</div>}
  {updateSent === 'none' && <div class="banner error">Could not send — the author has no phone/email on file, or the send failed.</div>}

  <div class="card">
    <h2>Manuscript</h2>
    <p class="muted">If the client sent their manuscript by email or WhatsApp instead of using the portal, upload it here on their behalf — it appears in their project exactly as if they'd submitted it themselves.</p>
    {project.fileAssets.length > 0 && (
      <ul class="file-list">
        {project.fileAssets.map((f) => (
          <li>v{f.version} — {f.originalFilename} <a href={`/api/portal/files/download?fileId=${f.id}`} target="_blank">↗</a></li>
        ))}
      </ul>
    )}
    {project.ndaAgreement?.status !== 'EXECUTED' && (
      <p class="muted small">The NDA isn't executed yet — the file will still be saved, but the project stage won't advance until it is.</p>
    )}
    <form method="post" action="/api/portal/admin/manuscript/upload" enctype="multipart/form-data" data-chunked-upload-form="admin/manuscript">
      <input type="hidden" name="projectId" value={id} />
      <label>Upload manuscript on the client's behalf<input type="file" name="manuscript" accept=".pdf,.doc,.docx,.rtf,.odt" required /><small class="muted">Max 10MB</small></label>
      <button type="submit" class="btn-primary">Upload manuscript</button>
      <p class="upload-status" data-upload-status></p>
    </form>
  </div>

  <div class="card">
    <h2>Amazon &amp; online platforms</h2>
    <p class="muted">The author invites our team as an authorized user on their own Amazon KDP account — no password ever changes hands. Update status here once you've accepted the invite and uploaded their book.</p>
    <div class="distribution-status-row">
      <span>Amazon KDP</span>
      <span class={`status-chip ${(kdpListing?.status || 'NOT_STARTED').toLowerCase()}`}>{DISTRIBUTION_STATUS_LABEL[kdpListing?.status || 'NOT_STARTED']}</span>
    </div>
    <form method="post" action="/api/portal/admin/distribution/update">
      <input type="hidden" name="projectId" value={id} />
      <input type="hidden" name="platform" value="AMAZON_KDP" />
      <label>Status
        <select name="status">
          {Object.entries(DISTRIBUTION_STATUS_LABEL).map(([key, label]) => (
            <option value={key} selected={key === (kdpListing?.status || 'NOT_STARTED')}>{label}</option>
          ))}
        </select>
      </label>
      <label>Listing URL (once live)<input type="url" name="listingUrl" value={kdpListing?.listingUrl || ''} placeholder="https://amazon.com/dp/..." /></label>
      <label>ASIN<input type="text" name="asin" value={kdpListing?.asin || ''} placeholder="B0XXXXXXX" /></label>
      <label>Notes<textarea name="notes" rows="2">{kdpListing?.notes || ''}</textarea></label>
      <button type="submit" class="btn-primary">Save distribution status</button>
    </form>
  </div>

  <div class="card">
    <h2>Client updates — no login required</h2>
    <p class="muted">For clients who don't want to use the portal. Share a private link that always shows current progress, invoices, quotations and messages, or send a one-off WhatsApp/email/SMS update now.</p>
    {shareLink ? (
      <div class="share-link-row">
        <input type="text" readonly value={shareLink} onclick="this.select()" />
        <a href={shareLink} target="_blank" class="btn-link">Open ↗</a>
      </div>
    ) : (
      <p class="muted small">No share link yet — generate one below.</p>
    )}
    <div class="client-update-actions">
      <form method="post" action="/api/portal/admin/projects/share">
        <input type="hidden" name="projectId" value={id} />
        <input type="hidden" name="action" value="generate" />
        <button type="submit" class="btn-secondary-btn">{shareLink ? 'Regenerate link' : 'Generate share link'}</button>
      </form>
      {shareLink && (
        <form method="post" action="/api/portal/admin/projects/share">
          <input type="hidden" name="projectId" value={id} />
          <input type="hidden" name="action" value="revoke" />
          <button type="submit" class="btn-secondary-btn">Revoke link</button>
        </form>
      )}
      <form method="post" action="/api/portal/admin/projects/send-update">
        <input type="hidden" name="projectId" value={id} />
        <button type="submit" class="btn-primary">Send update now (WhatsApp/Email/SMS)</button>
      </form>
    </div>
  </div>

  <div class="grid-2">
    <div class="card">
      <h2>Assign a new task</h2>
      <form method="post" action="/api/portal/admin/tasks/create">
        <input type="hidden" name="projectId" value={id} />
        <label>Task type
          <select name="taskType" required>
            {TASK_TYPES.map((t) => <option value={t.key}>{t.label}</option>)}
          </select>
        </label>
        <label>Assign to
          <select name="assignedToUserId" required>
            <option value="">Select an employee…</option>
            {employees.map((e) => (
              <option value={e.id}>{e.name} — {e.activeCount} active ({e.workloadLabel})</option>
            ))}
          </select>
        </label>
        <div class="row">
          <label>Due date<input type="date" name="dueDate" /></label>
          <label>Priority
            <select name="priority">
              <option value="NORMAL">Normal</option>
              <option value="LOW">Low</option>
              <option value="HIGH">High</option>
              <option value="URGENT">Urgent</option>
            </select>
          </label>
        </div>
        <label>Instructions<textarea name="instructions" rows="3" placeholder="What should they do, and which file should they use?"></textarea></label>
        <button type="submit" class="btn-primary">Assign task</button>
      </form>
    </div>

    <div class="card">
      <h2>Employee workload</h2>
      <div class="workload-list">
        {employees.map((e) => (
          <div class="workload-row">
            <div>
              <strong>{e.name}</strong>
              <span class="muted">{e.activeCount} active · {e.dueThisWeek} due this week{e.overdue > 0 ? ` · ${e.overdue} overdue` : ''}</span>
            </div>
            <span class={`workload-chip ${e.workloadLabel.replaceAll(' ', '-').toLowerCase()}`}>{e.workloadLabel}</span>
          </div>
        ))}
        {employees.length === 0 && <p class="muted">No employees yet.</p>}
      </div>
    </div>
  </div>

  <h2>Tasks on this project</h2>
  {project.tasks.length === 0 ? (
    <p class="muted">No tasks assigned yet.</p>
  ) : (
    <div class="table-wrap">
      <table>
        <thead><tr><th>Task</th><th>Type</th><th>Assignee</th><th>Status</th><th>Due</th><th></th></tr></thead>
        <tbody>
          {project.tasks.map((t) => (
            <tr>
              <td>{t.taskNumber}</td>
              <td>{t.taskType.replaceAll('_', ' ')}</td>
              <td>{t.assignedToUser?.employeeProfile?.jobTitle || t.assignedToUser?.email || '—'}</td>
              <td><span class="status-chip small">{t.status.replaceAll('_', ' ')}</span></td>
              <td>{t.dueDate ? t.dueDate.toLocaleDateString('en-GB') : '—'}</td>
              <td><a href={`/portal/admin/tasks/${t.id}`}>View →</a></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}

  <h2>Finance</h2>
  <div class="grid-2">
    <div class="card">
      <h2>New quotation</h2>
      {error === 'missing-quotation-fields' && <div class="banner error">Please add a type and at least one line item.</div>}
      <form method="post" action="/api/portal/admin/quotations/create">
        <input type="hidden" name="projectId" value={id} />
        <label>Type
          <select name="type" required>
            <option value="PUBLISHING">Publishing</option>
            <option value="PRINTING">Printing</option>
            <option value="LAUNCH">Launch</option>
            <option value="ADDITIONAL_SERVICES">Additional Services</option>
            <option value="CUSTOM">Custom</option>
          </select>
        </label>
        <label>Payment terms
          <select name="paymentTerms">
            <option value="70/30">70% deposit / 30% balance</option>
            <option value="50/50">50% deposit / 50% balance</option>
            <option value="100_UPFRONT">100% upfront</option>
            <option value="ON_COMPLETION">Payment on completion</option>
          </select>
        </label>
        <label>Valid for (days)<input type="number" name="validDays" value="14" min="1" /></label>
        <label>Line items — one per line: <code>description | qty | unit price</code>
          <textarea name="items" rows="4" placeholder={"Gold publishing package | 1 | 60000\nExtra revision round | 1 | 5000"} required></textarea>
        </label>
        <label>Notes<textarea name="notes" rows="2"></textarea></label>
        <button type="submit" class="btn-primary">Send quotation</button>
      </form>
    </div>

    <div class="card">
      <h2>Balance</h2>
      <div class="finance-summary">
        <div><span class="muted">Total invoiced</span><strong>KSh {totalInvoiced.toLocaleString()}</strong></div>
        <div><span class="muted">Paid</span><strong>KSh {totalPaid.toLocaleString()}</strong></div>
        <div><span class="muted">Outstanding</span><strong>KSh {(totalInvoiced - totalPaid).toLocaleString()}</strong></div>
      </div>
    </div>
  </div>

  {project.quotations.length > 0 && (
    <div class="table-wrap" style="margin-bottom:1.5rem">
      <table>
        <thead><tr><th>Quotation</th><th>Type</th><th>Status</th><th>Terms</th><th></th></tr></thead>
        <tbody>
          {project.quotations.map((q) => (
            <tr>
              <td>{q.quotationNumber}</td>
              <td>{q.type.replaceAll('_', ' ')}</td>
              <td><span class="status-chip small">{q.status.replaceAll('_', ' ')}</span></td>
              <td>{q.paymentTerms}</td>
              <td><a href={`/portal/quotations/${q.id}`}>View →</a></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}

  {project.invoices.length > 0 && (
    <div class="table-wrap">
      <table>
        <thead><tr><th>Invoice</th><th>Label</th><th>Amount</th><th>Status</th><th></th></tr></thead>
        <tbody>
          {project.invoices.map((inv) => (
            <tr>
              <td>{inv.invoiceNumber}</td>
              <td>{inv.label || inv.type}</td>
              <td>KSh {Number(inv.amountKes).toLocaleString()}</td>
              <td><span class="status-chip small">{inv.status.replaceAll('_', ' ')}</span></td>
              <td><a href={`/portal/invoices/${inv.id}`}>View →</a></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}

  <h2>Printing</h2>
  {project.printJobs.length === 0 ? (
    <p class="muted">No printing requests yet.</p>
  ) : (
    <div class="table-wrap">
      <table>
        <thead><tr><th>Print Job</th><th>Spec</th><th>Status</th><th></th></tr></thead>
        <tbody>
          {project.printJobs.map((pj) => (
            <tr>
              <td>{pj.printJobNumber}</td>
              <td>{pj.quantity} × {pj.bookSize} — {pj.pageCount}pp</td>
              <td><span class="status-chip small">{pj.status.replaceAll('_', ' ')}</span></td>
              <td><a href={`/portal/print-jobs/${pj.id}`}>View →</a></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}

  {teamMembers.length > 0 && (
    <div class="timeline-block">
      <h2>Contact sharing</h2>
      <p class="muted">Authors never see a team member's phone or email unless explicitly granted here.</p>
      <div class="grant-list">
        {teamMembers.map((member) => {
          const grant = grantByEmployee.get(member!.id);
          return (
            <div class="grant-row">
              <span>{member!.employeeProfile?.jobTitle || member!.partnerProfile?.companyName || member!.email}</span>
              {grant ? (
                <form method="post" action="/api/portal/admin/contact-grants/revoke">
                  <input type="hidden" name="grantId" value={grant.id} />
                  <span class="status-chip small">Sharing: {grant.level.replaceAll('_', ' ')}</span>
                  <button type="submit" class="btn-reject-small">Revoke</button>
                </form>
              ) : (
                <form method="post" action="/api/portal/admin/contact-grants/grant">
                  <input type="hidden" name="projectId" value={id} />
                  <input type="hidden" name="employeeUserId" value={member!.id} />
                  <select name="level">
                    <option value="WORK_EMAIL">Share work email</option>
                    <option value="PHONE">Share phone</option>
                    <option value="PHONE_AND_EMAIL">Share phone + email</option>
                  </select>
                  <button type="submit" class="btn-verify-small">Grant</button>
                </form>
              )}
            </div>
          );
        })}
      </div>
    </div>
  )}

  {activity.length > 0 && (
    <div class="timeline-block">
      <h2>Activity</h2>
      <ol class="timeline">
        {activity.map((e) => (
          <li><small>{e.createdAt.toLocaleString('en-GB')}</small><span>{e.message}</span></li>
        ))}
      </ol>
    </div>
  )}
</PortalLayout>
<style>
  .back-link{display:inline-block;margin-bottom:1rem;color:var(--muted);text-decoration:none;font-weight:700;font-size:.82rem}
  .header-row{display:flex;justify-content:space-between;align-items:flex-start;gap:1rem;margin-bottom:2rem}
  .header-row small{color:var(--green);font-weight:800;font-size:.7rem;letter-spacing:.08em}
  .header-row h1{margin:.2rem 0 .2rem;font-family:var(--display);font-size:1.8rem}
  .muted{color:var(--muted);font-size:.85rem}
  .status-chip{padding:.4rem .8rem;border-radius:99px;background:var(--soft-green);color:var(--deep-green);font-size:.72rem;font-weight:800;white-space:nowrap}
  .btn-link{color:var(--green);font-weight:800;font-size:.85rem;text-decoration:none}
  .timeline-block{margin-top:1.5rem;padding:1.5rem;background:var(--surface);border:1px solid var(--line);border-radius:16px}
  .timeline-block h2{margin:0 0 1rem;font-family:var(--display);font-size:1.15rem}
  .timeline{margin:0;padding:0;list-style:none;display:grid;gap:.8rem}
  .timeline li{display:flex;flex-direction:column;gap:.15rem;padding-left:1rem;border-left:2px solid var(--soft-green)}
  .timeline small{color:var(--muted);font-size:.68rem;font-weight:700}
  .timeline span{font-size:.85rem}
  .grant-list{display:grid;gap:.7rem}
  .grant-row{display:flex;justify-content:space-between;align-items:center;gap:1rem;padding:.8rem 1rem;background:var(--surface-2);border-radius:10px;flex-wrap:wrap}
  .grant-row form{display:flex;align-items:center;gap:.6rem}
  .grant-row select{padding:.5rem .6rem;border:1px solid var(--line);border-radius:8px;font-size:.78rem}
  .btn-verify-small{padding:.5rem .8rem;border:0;border-radius:8px;background:var(--green);color:#fff;font-weight:800;font-size:.72rem;cursor:pointer}
  .btn-reject-small{padding:.5rem .8rem;border:1px solid var(--line);border-radius:8px;background:transparent;color:#b91c1c;font-weight:800;font-size:.72rem;cursor:pointer}
  .status-chip.small{padding:.3rem .6rem;font-size:.66rem}
  .status-chip.not_started{background:var(--surface-2);color:var(--muted)}
  .status-chip.author_invited_admin{background:#fff3cd;color:#8a6800}
  .distribution-status-row{display:flex;justify-content:space-between;align-items:center;padding:.7rem 1rem;background:var(--surface-2);border-radius:9px;font-weight:700;margin-bottom:1rem}
  .banner{padding:1rem 1.2rem;border-radius:12px;font-size:.88rem;font-weight:700;margin-bottom:1.5rem}
  .banner.error{background:#fdecec;color:#b91c1c}
  .banner.ok{background:var(--soft-green);color:var(--deep-green)}
  .grid-2{display:grid;grid-template-columns:1fr 1fr;gap:1.5rem;margin-bottom:2rem}
  .card{padding:1.5rem;background:var(--surface);border:1px solid var(--line);border-radius:16px;margin-bottom:1.5rem}
  .share-link-row{display:flex;gap:.6rem;align-items:center;margin-bottom:1rem}
  .share-link-row input{flex:1;background:var(--surface-2);font-size:.78rem;color:var(--muted)}
  .client-update-actions{display:flex;gap:.8rem;flex-wrap:wrap}
  .client-update-actions form{display:contents}
  .btn-secondary-btn{padding:.7rem 1rem;border:1px solid var(--line);border-radius:9px;background:var(--surface);color:var(--text);font-weight:800;font-size:.8rem;cursor:pointer}
  .card h2{margin:0 0 1rem;font-family:var(--display);font-size:1.1rem}
  form{display:grid;gap:1rem}
  .row{display:grid;grid-template-columns:1fr 1fr;gap:1rem}
  label{display:grid;gap:.4rem;font-size:.78rem;font-weight:800}
  input,select,textarea{padding:.7rem .8rem;border:1px solid var(--line);border-radius:9px;font-size:.85rem;font-family:inherit}
  .btn-primary{padding:.8rem;border:0;border-radius:10px;background:var(--green);color:#fff;font-weight:800;cursor:pointer;box-shadow:0 5px 0 var(--deep-green)}
  .workload-list{display:grid;gap:.8rem}
  .workload-row{display:flex;justify-content:space-between;align-items:center;gap:1rem;padding:.7rem 0;border-bottom:1px solid var(--line)}
  .workload-row div{display:grid;gap:.15rem}
  .workload-row span.muted{font-size:.72rem}
  .workload-chip{padding:.3rem .6rem;border-radius:99px;font-size:.62rem;font-weight:800;white-space:nowrap}
  .workload-chip.available{background:var(--soft-green);color:var(--deep-green)}
  .workload-chip.moderately-busy{background:#fff3cd;color:#8a6800}
  .workload-chip.high-workload{background:#fdecec;color:#b91c1c}
  h2{font-family:var(--display);font-size:1.2rem;margin:0 0 1rem}
  .table-wrap{overflow-x:auto;background:var(--surface);border:1px solid var(--line);border-radius:16px}
  table{width:100%;border-collapse:collapse;font-size:.82rem}
  th,td{padding:.9rem 1rem;text-align:left;white-space:nowrap}
  thead{background:var(--surface-2)}
  th{color:var(--muted);font-size:.68rem;letter-spacing:.06em;text-transform:uppercase}
  tbody tr:not(:last-child){border-bottom:1px solid var(--line)}
  td a{color:var(--green);font-weight:800;text-decoration:none}
  code{padding:.1rem .3rem;background:var(--surface-2);border-radius:4px;font-size:.72rem}
  .finance-summary{display:grid;gap:1rem}
  .finance-summary div{display:flex;justify-content:space-between;align-items:center;padding-bottom:.6rem;border-bottom:1px solid var(--line)}
  .finance-summary strong{font-family:var(--display);font-size:1.1rem;color:var(--deep-green)}
  .file-list{margin:0 0 1rem;padding-left:1.2rem;font-size:.85rem}
  .file-list a{color:var(--green);font-weight:800;text-decoration:none}
  .muted.small{font-size:.76rem}
  .upload-status{margin:.4rem 0 0;font-size:.78rem;font-weight:700;color:var(--muted)}
  @media(max-width:820px){.grid-2{grid-template-columns:1fr}}
</style>
<script>
  // Netlify Functions reject request bodies over ~6MB before our server code
  // ever runs, so files bigger than one 4MB chunk are split client-side and
  // uploaded piece by piece to <scope>/upload-chunk, then stitched back
  // together server-side in <scope>/upload-finalize.
  const CHUNK_SIZE = 4 * 1024 * 1024;
  const MAX_CHUNKED_BYTES = 10 * 1024 * 1024;

  document.querySelectorAll<HTMLFormElement>('[data-chunked-upload-form]').forEach((form) => {
    const scope = form.dataset.chunkedUploadForm!;
    form.addEventListener('submit', async (e) => {
      const fileInput = form.querySelector<HTMLInputElement>('input[type="file"]');
      const file = fileInput?.files?.[0];
      if (!file) return;

      if (file.size > MAX_CHUNKED_BYTES) {
        e.preventDefault();
        alert(`That file is ${(file.size / (1024 * 1024)).toFixed(1)}MB, which is over the 10MB limit. Please compress it or split it into parts.`);
        return;
      }
      if (file.size <= CHUNK_SIZE) return; // small enough for a normal post

      e.preventDefault();
      const statusEl = form.querySelector<HTMLElement>('[data-upload-status]');
      const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      submitBtn && (submitBtn.disabled = true);

      const uploadId = crypto.randomUUID();
      const totalChunks = Math.ceil(file.size / CHUNK_SIZE);
      const extraFields: [string, string][] = [];
      form.querySelectorAll<HTMLInputElement>('input[type="hidden"]').forEach((input) => extraFields.push([input.name, input.value]));

      try {
        for (let i = 0; i < totalChunks; i++) {
          const chunkBlob = file.slice(i * CHUNK_SIZE, (i + 1) * CHUNK_SIZE);
          const fd = new FormData();
          extraFields.forEach(([k, v]) => fd.append(k, v));
          fd.append('uploadId', uploadId);
          fd.append('chunkIndex', String(i));
          fd.append('totalChunks', String(totalChunks));
          fd.append('chunk', chunkBlob, file.name);
          if (statusEl) statusEl.textContent = `Uploading part ${i + 1} of ${totalChunks}…`;
          const res = await fetch(`/api/portal/${scope}/upload-chunk`, { method: 'POST', body: fd });
          const result = await res.json();
          if (!result.ok) throw new Error(result.error || 'chunk-failed');
        }

        if (statusEl) statusEl.textContent = 'Finalizing upload…';
        const finalizeFd = new FormData();
        extraFields.forEach(([k, v]) => finalizeFd.append(k, v));
        finalizeFd.append('uploadId', uploadId);
        finalizeFd.append('totalChunks', String(totalChunks));
        finalizeFd.append('filename', file.name);
        finalizeFd.append('contentType', file.type);
        const finalizeRes = await fetch(`/api/portal/${scope}/upload-finalize`, { method: 'POST', body: finalizeFd });
        const finalizeResult = await finalizeRes.json();
        if (!finalizeResult.ok) throw new Error(finalizeResult.error || 'finalize-failed');
        window.location.href = finalizeResult.redirect;
      } catch {
        alert('Upload failed. Please check your connection and try again.');
        submitBtn && (submitBtn.disabled = false);
        if (statusEl) statusEl.textContent = '';
      }
    });
  });
</script>
