---
export const prerender = false;
import { createHash } from 'node:crypto';
import { prisma } from '../../lib/db';

const token = Astro.url.searchParams.get('token') || '';
const error = Astro.url.searchParams.get('error');

let status: 'form' | 'invalid' | 'expired' = 'invalid';

if (token) {
  const tokenHash = createHash('sha256').update(token).digest('hex');
  const record = await prisma.verificationToken.findUnique({ where: { tokenHash } });
  if (record && record.type === 'PASSWORD_RESET' && !record.usedAt) {
    status = record.expiresAt < new Date() ? 'expired' : 'form';
  }
}

const ERROR_MESSAGES: Record<string, string> = {
  'too-short': 'New password must be at least 8 characters.',
  mismatch: "New password and confirmation don't match.",
};
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Reset Password — Chance Publishers Portal</title>
  <meta name="robots" content="noindex" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
</head>
<body style="font-family:system-ui,sans-serif;background:#f7f5ef;display:grid;place-items:center;min-height:100vh;margin:0;padding:1.5rem;box-sizing:border-box;">
  <div style="max-width:420px;width:100%;padding:2.5rem;background:#fff;border-radius:16px;box-shadow:0 10px 40px rgba(0,0,0,.08);box-sizing:border-box;">
    {status === 'form' && (
      <>
        <h1 style="color:#0a5b35;margin:0 0 .5rem;font-size:1.5rem;">Choose a new password</h1>
        <p style="color:#556;margin:0 0 1.5rem;font-size:.9rem;">Make it at least 8 characters.</p>
        {error && (
          <div style="margin-bottom:1rem;padding:.8rem 1rem;border-radius:10px;background:#fdecec;color:#b91c1c;font-size:.85rem;font-weight:700;">
            {ERROR_MESSAGES[error] || 'Something went wrong. Please try again.'}
          </div>
        )}
        <form method="post" action="/api/portal/reset-password" style="display:grid;gap:1rem;text-align:left;">
          <input type="hidden" name="token" value={token} />
          <label style="display:grid;gap:.4rem;font-size:.8rem;font-weight:800;color:#173025;">
            New password
            <input type="password" name="newPassword" required minlength="8" autocomplete="new-password" style="padding:.85rem .95rem;border:1px solid #dfe8e1;border-radius:10px;font-size:.95rem;" />
          </label>
          <label style="display:grid;gap:.4rem;font-size:.8rem;font-weight:800;color:#173025;">
            Confirm new password
            <input type="password" name="confirmPassword" required minlength="8" autocomplete="new-password" style="padding:.85rem .95rem;border:1px solid #dfe8e1;border-radius:10px;font-size:.95rem;" />
          </label>
          <button type="submit" style="margin-top:.4rem;padding:.95rem;border:0;border-radius:12px;background:#12ae58;color:#fff;font-weight:800;cursor:pointer;box-shadow:0 6px 0 #0c5f34;">Update password</button>
        </form>
      </>
    )}
    {status === 'expired' && (
      <>
        <h1 style="color:#b45309;margin:0 0 .5rem;">Link expired</h1>
        <p style="color:#556;">This password reset link has expired. Request a new one below.</p>
        <a href="/portal/forgot-password" style="display:inline-block;margin-top:1rem;padding:.8rem 1.2rem;border-radius:10px;background:#0a5b35;color:#fff;text-decoration:none;font-weight:700;">Request a new link</a>
      </>
    )}
    {status === 'invalid' && (
      <>
        <h1 style="color:#b91c1c;margin:0 0 .5rem;">Invalid link</h1>
        <p style="color:#556;">This password reset link is invalid or has already been used.</p>
        <a href="/portal/forgot-password" style="display:inline-block;margin-top:1rem;padding:.8rem 1.2rem;border-radius:10px;background:#0a5b35;color:#fff;text-decoration:none;font-weight:700;">Request a new link</a>
      </>
    )}
  </div>
</body>
</html>
