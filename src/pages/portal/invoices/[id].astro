---
export const prerender = false;
import PortalLayout from '../../../layouts/PortalLayout.astro';
import { prisma } from '../../../lib/db';
import { userHasRole } from '../../../lib/auth/session';

const user = Astro.locals.user!;
const { id } = Astro.params;

const invoice = await prisma.invoice.findUnique({
  where: { id },
  include: {
    project: { include: { author: { include: { authorProfile: true } } } },
    items: true,
    payments: { include: { cheque: true, receipt: true }, orderBy: { createdAt: 'desc' } },
  },
});
if (!invoice) return Astro.redirect('/portal/author');

const isOwner = invoice.project.authorId === user.id;
const isAdmin = userHasRole(user, 'ADMIN') || userHasRole(user, 'SUPER_ADMIN');
if (!isOwner && !isAdmin) return Astro.redirect('/portal/author');

const verifiedPaid = invoice.payments
  .filter((p) => p.status === 'VERIFIED')
  .reduce((sum, p) => sum + Number(p.amountKes), 0);
const outstanding = Math.max(0, Number(invoice.amountKes) - verifiedPaid);
const hasPendingProof = invoice.payments.some((p) => p.status === 'PENDING_VERIFICATION' && p.method !== 'CHEQUE');

const section = isAdmin ? 'admin' : 'author';
const error = Astro.url.searchParams.get('error');
const submitted = Astro.url.searchParams.get('submitted');
---
<PortalLayout title={invoice.invoiceNumber} user={user} section={section}>
  <a class="back-link" href={isAdmin ? `/portal/admin/projects/${invoice.projectId}` : `/portal/author/projects/${invoice.projectId}`}>← Back</a>
  <div class="header-row">
    <div>
      <small>{invoice.invoiceNumber} — {invoice.label || invoice.type}</small>
      <h1>{invoice.project.title}</h1>
    </div>
    <span class="status-chip">{invoice.status.replaceAll('_', ' ')}</span>
  </div>

  {submitted && <div class="banner ok">Payment proof submitted — awaiting verification.</div>}
  {error === 'missing-cheque-fields' && <div class="banner error">Please fill in all cheque details.</div>}

  <div class="card">
    <table class="items-table">
      <thead><tr><th>Description</th><th>Qty</th><th>Unit Price</th><th>Total</th></tr></thead>
      <tbody>
        {invoice.items.map((item) => (
          <tr>
            <td>{item.description}</td>
            <td>{item.quantity}</td>
            <td>KSh {Number(item.unitPriceKes).toLocaleString()}</td>
            <td>KSh {(item.quantity * Number(item.unitPriceKes)).toLocaleString()}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <div class="totals">
      <div><span class="muted">Total</span><strong>KSh {Number(invoice.amountKes).toLocaleString()}</strong></div>
      <div><span class="muted">Paid</span><strong>KSh {verifiedPaid.toLocaleString()}</strong></div>
      <div><span class="muted">Outstanding</span><strong>KSh {outstanding.toLocaleString()}</strong></div>
    </div>
  </div>

  {isOwner && outstanding > 0 && (
    <div class="card">
      <h2>Pay this invoice</h2>
      {hasPendingProof ? (
        <div class="banner ok">Your payment proof is submitted and awaiting verification.</div>
      ) : (
        <>
          <h3>M-Pesa</h3>
          <form data-mpesa-form>
            <input type="hidden" name="invoiceId" value={invoice.id} />
            <label>Phone number<input type="tel" name="phoneNumber" placeholder="2547XXXXXXXX" pattern="2547[0-9]{8}" /></label>
            <button type="submit" class="btn-primary">Pay with M-Pesa</button>
            <p class="mpesa-status" data-mpesa-status></p>
          </form>

          <h3>Bank transfer</h3>
          <form method="post" action="/api/portal/invoices/pay-bank-transfer" enctype="multipart/form-data">
            <input type="hidden" name="invoiceId" value={invoice.id} />
            <label>Transaction reference<input type="text" name="reference" /></label>
            <label>Proof of payment<input type="file" name="proof" accept=".pdf,.jpg,.jpeg,.png" required /></label>
            <button type="submit" class="btn-primary">Submit proof of payment</button>
          </form>
          <p class="muted small">To pay by cash or cheque, please contact our office.</p>
        </>
      )}
    </div>
  )}

  {isAdmin && outstanding > 0 && (
    <div class="grid-2">
      <div class="card">
        <h2>Record cash payment</h2>
        <form method="post" action="/api/portal/admin/payments/record-cash">
          <input type="hidden" name="invoiceId" value={invoice.id} />
          <label>Amount<input type="number" name="amount" value={outstanding} min="1" step="0.01" required /></label>
          <button type="submit" class="btn-primary">Record &amp; verify cash</button>
        </form>
      </div>
      <div class="card">
        <h2>Record cheque</h2>
        <form method="post" action="/api/portal/admin/payments/record-cheque">
          <input type="hidden" name="invoiceId" value={invoice.id} />
          <label>Amount<input type="number" name="amount" value={outstanding} min="1" step="0.01" required /></label>
          <label>Cheque number<input type="text" name="chequeNumber" required /></label>
          <label>Bank<input type="text" name="bank" required /></label>
          <label>Drawer name<input type="text" name="drawer" required /></label>
          <button type="submit" class="btn-primary">Record cheque</button>
        </form>
      </div>
    </div>
  )}

  <div class="card">
    <h2>Payment history</h2>
    {invoice.payments.length === 0 ? (
      <p class="muted">No payments yet.</p>
    ) : (
      <ul class="payment-list">
        {invoice.payments.map((p) => (
          <li>
            <div>
              <strong>{p.method.replaceAll('_', ' ')}</strong> — KSh {Number(p.amountKes).toLocaleString()}
              <span class={`status-chip small ${p.status.toLowerCase()}`}>{p.cheque ? p.cheque.status.replaceAll('_', ' ') : p.status.replaceAll('_', ' ')}</span>
            </div>
            {p.receipt && <a href={`/api/portal/files/download?fileId=${p.receipt.id}`} target="_blank">Receipt ↗</a>}
          </li>
        ))}
      </ul>
    )}
  </div>
</PortalLayout>
<script>
  const mpesaForm = document.querySelector<HTMLFormElement>('[data-mpesa-form]');
  mpesaForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const status = mpesaForm.querySelector<HTMLElement>('[data-mpesa-status]')!;
    const button = mpesaForm.querySelector('button')!;
    button.disabled = true;
    status.textContent = 'Sending request…';
    try {
      const res = await fetch('/api/portal/invoices/pay-mpesa', { method: 'POST', body: new FormData(mpesaForm) });
      const result = await res.json();
      status.textContent = result.ok
        ? 'Check your phone to complete the payment.'
        : result.error || 'Something went wrong.';
    } catch {
      status.textContent = 'Could not reach the server. Please try again.';
    } finally {
      button.disabled = false;
    }
  });
</script>
<style>
  .back-link{display:inline-block;margin-bottom:1rem;color:var(--muted);text-decoration:none;font-weight:700;font-size:.82rem}
  .header-row{display:flex;justify-content:space-between;align-items:flex-start;gap:1rem;margin-bottom:1.5rem}
  .header-row small{color:var(--green);font-weight:800;font-size:.7rem;letter-spacing:.06em}
  .header-row h1{margin:.2rem 0 0;font-family:var(--display);font-size:1.6rem}
  .status-chip{padding:.4rem .8rem;border-radius:99px;background:var(--soft-green);color:var(--deep-green);font-size:.72rem;font-weight:800;white-space:nowrap}
  .status-chip.small{padding:.25rem .5rem;font-size:.62rem;margin-left:.6rem}
  .status-chip.rejected,.status-chip.bounced{background:#fdecec;color:#b91c1c}
  .banner{padding:1rem 1.2rem;border-radius:12px;font-size:.86rem;font-weight:700;margin-bottom:1.5rem}
  .banner.ok{background:var(--soft-green);color:var(--deep-green)}
  .banner.error{background:#fdecec;color:#b91c1c}
  .card{max-width:640px;margin-bottom:1.5rem;padding:1.4rem;background:var(--surface);border:1px solid var(--line);border-radius:16px}
  .card h2{margin:0 0 1rem;font-family:var(--display);font-size:1.05rem}
  .card h3{margin:0 0 .6rem;font-family:var(--display);font-size:.9rem}
  .items-table{width:100%;border-collapse:collapse;font-size:.85rem;margin-bottom:1rem}
  .items-table th{text-align:left;color:var(--muted);font-size:.68rem;text-transform:uppercase;padding-bottom:.5rem;border-bottom:1px solid var(--line)}
  .items-table td{padding:.6rem 0;border-bottom:1px solid var(--line)}
  .totals{display:grid;gap:.5rem;margin-top:.5rem}
  .totals div{display:flex;justify-content:space-between}
  .muted{color:var(--muted);font-size:.85rem}
  .muted.small{font-size:.76rem}
  .mpesa-status{margin:.4rem 0 0;font-size:.78rem;font-weight:700;color:var(--muted)}
  form{display:grid;gap:1rem}
  label{display:grid;gap:.4rem;font-size:.8rem;font-weight:800}
  input{padding:.7rem .8rem;border:1px solid var(--line);border-radius:9px;font-size:.85rem}
  .btn-primary{padding:.8rem;border:0;border-radius:10px;background:var(--green);color:#fff;font-weight:800;cursor:pointer;box-shadow:0 5px 0 var(--deep-green)}
  .grid-2{display:grid;grid-template-columns:1fr 1fr;gap:1.2rem;max-width:640px}
  .payment-list{margin:0;padding:0;list-style:none;display:grid;gap:.8rem}
  .payment-list li{display:flex;justify-content:space-between;align-items:center;padding:.7rem;background:var(--surface-2);border-radius:9px;font-size:.85rem}
  .payment-list a{color:var(--green);font-weight:800;text-decoration:none}
  @media(max-width:600px){.grid-2{grid-template-columns:1fr}}
</style>
