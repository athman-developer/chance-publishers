---
import Navbar from "../components/Navbar.astro";
import "../styles/responsive.css";

const products = [
  ["Not Expired","Leadership & Growth","/Images/covers/not-expired.jpg","Featured"],
  ["Pieces of Me","Religion & Society","/Images/covers/pieces-of-me.jpg","New"],
  ["The Terrain","Fiction & Literature","/Images/covers/the-terrain.jpg","New"],
  ["When the Sky Changes","Children & Young Readers","/Images/covers/when-the-sky-changes.jpg","Kids"],
  ["The Rise of Ndindi Nyoro","Leadership & Biography","/Images/covers/rise-of-ndindi-nyoro.jpg","New"],
  ["Blooming With Grace","Religion & Inspiration","/Images/covers/blooming-with-grace-new.jpg","Popular"],
  ["My Lagdera","Research & Society","/Images/covers/my-lagdera.jpg","Featured"],
  ["Asolic Principle & Its Applications","Science & Education","/Images/covers/asolic-principle.jpg","New"],
];

const categoryCards = [
  ["Religion & Spirituality","7 titles","✦","mint","/Images/covers/living-resurrection-power.jpg","/categories/religion"],
  ["Leadership & Growth","4 titles","↗","yellow","/Images/covers/not-expired.jpg","/categories/leadership"],
  ["Education & Learning","3 titles","ABC","sky","/Images/covers/when-the-sky-changes.jpg","/categories/education"],
  ["Fiction & Literature","7 titles","“ ”","coral","/Images/covers/the-terrain.jpg","/categories/literature"],
  ["Research & Society","3 titles","⌁","lavender","/Images/covers/my-lagdera.jpg","/categories/research"],
  ["Science & Discovery","1 title","π","mint","/Images/covers/asolic-principle.jpg","/categories/science"],
];

const siteUrl = 'https://chancepublishers.com';
const localBusinessSchema = {
  '@context':'https://schema.org',
  '@type':['LocalBusiness','Organization'],
  '@id':`${siteUrl}/#organization`,
  name:'Chance Publishers Limited',
  alternateName:'Chance Publishers',
  url:siteUrl,
  logo:`${siteUrl}/Images/brand/chance-logo.png`,
  image:`${siteUrl}/og.png`,
  description:'A Nairobi publishing company providing manuscript editing, proofreading, cover design, book layout, ISBN and copyright registration support, printing guidance, author branding and book launch support in Kenya.',
  telephone:'+254758305622',
  email:'info@chancepublishers.com',
  priceRange:'KSh 40,000–60,000 publishing packages; printing quoted separately',
  address:{'@type':'PostalAddress',streetAddress:'Kenda House, 4th Floor, Tom Mboya Street, near Afya Centre',addressLocality:'Nairobi',addressCountry:'KE'},
  areaServed:{'@type':'Country',name:'Kenya'},
  openingHoursSpecification:{'@type':'OpeningHoursSpecification',dayOfWeek:['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'],opens:'06:00',closes:'21:00'},
  sameAs:['https://www.facebook.com/chancepublishers','https://www.instagram.com/chancepublishers/','https://www.youtube.com/@chancepublishers','https://www.tiktok.com/@chancepublishers','https://www.linkedin.com/company/chance-publishers/']
};
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Chance Publishers is a Nairobi book publishing company offering manuscript editing, proofreading, cover design, book layout, ISBN and copyright support, printing guidance and author launches in Kenya." />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <link rel="canonical" href={siteUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Chance Publishers" />
    <meta property="og:title" content="Chance Publishers | Book Publishing & Printing Services in Kenya" />
    <meta property="og:description" content="Publish your book in Kenya with professional editing, design, printing guidance, ISBN support and author launch services from Chance Publishers in Nairobi." />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:image" content={`${siteUrl}/og.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#13ad58" />
    <title>Chance Publishers | Book Publishing & Printing Services in Kenya</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Nunito:wght@400;600;700;800;900&family=Patrick+Hand&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)}></script>
    <script is:inline>
      try { const saved = localStorage.getItem('chance-theme'); if (saved) document.documentElement.dataset.theme = saved; } catch {}
    </script>
  </head>
  <body>
    <Navbar />
    <main id="top">
      <section class="hero-slider" aria-label="Featured Chance Publishers stories" data-hero-slider>
        <article class="hero hero-slide is-active transition-fade" data-hero-slide>
          <div class="hero-dots" aria-hidden="true"></div>
          <div class="hero-copy"><div class="eyebrow"><span>●</span> African stories. Limitless possibilities.</div><h1>Ideas that grow<br /><em>beyond the page.</em></h1><p>Discover meaningful books, remarkable African voices and stories created to educate, inspire and transform.</p><div class="hero-buttons"><a class="btn btn-primary" href="#books">Explore our books <span>→</span></a><a class="btn btn-play" href="/publish"><i>✎</i> Publish with us</a></div><div class="reader-love"><div class="avatars"><span>R</span><span>A</span><span>M</span><span>+</span></div><p><b>Loved by readers</b><small>Growing ideas across Africa</small></p></div></div>
          <div class="hero-visual" aria-label="Chance Publishers book launch"><div class="circle circle-one"></div><div class="circle circle-two"></div><div class="main-photo"><img src="/Images/launch/ajtv-0282.jpg" alt="An author presenting a book at a Chance Publishers launch" fetchpriority="high" /></div><div class="floating-book book-a"><img src="/Images/covers/not-expired.jpg" alt="Not Expired" /><span>Popular</span></div><div class="floating-book book-b"><img src="/Images/covers/pieces-of-me.jpg" alt="Pieces of Me" /><span>New</span></div><div class="happy-note"><span>✦</span><b>Stories<br />with impact</b></div><div class="grow-sticker">YOUR<br /><b>CHANCE</b><br />TO GROW</div></div>
        </article>
        <article class="hero hero-slide reverse transition-zoom-in" data-hero-slide hidden>
          <div class="hero-visual"><div class="circle circle-one"></div><div class="circle circle-two"></div><div class="main-photo"><img src="/Images/launch/dsc-5764.jpg" alt="A Chance Publishers educational book presentation" /></div><div class="floating-book book-a"><img src="/Images/covers/asolic-principle.jpg" alt="Asolic Principle and Its Applications" /><span>Learn</span></div><div class="floating-book book-b"><img src="/Images/covers/living-resurrection-power.jpg" alt="Living in the Resurrection Power" /><span>Read</span></div><div class="floating-book book-c"><img src="/Images/covers/blooming-with-grace-new.jpg" alt="Blooming With Grace" /><span>New</span></div></div>
          <div class="hero-copy"><div class="eyebrow"><span>●</span> Knowledge made beautifully accessible.</div><h1>Books that open<br /><em>new possibilities.</em></h1><p>Explore thoughtful books that help readers learn, lead, heal and see the world through a richer African lens.</p><div class="hero-buttons"><a class="btn btn-primary" href="/books">Browse our library <span>→</span></a><a class="btn btn-play" href="#launches">See our launches</a></div></div>
        </article>
        <article class="hero hero-slide transition-zoom-out" data-hero-slide hidden>
          <div class="hero-copy"><div class="eyebrow"><span>●</span> Your manuscript has somewhere to go.</div><h1>Turn your story<br /><em>into a real book.</em></h1><p>From editorial shaping and cover design to printing and launch support, we walk with authors from first draft to proud publication.</p><div class="hero-buttons"><a class="btn btn-primary" href="/publish">Publish with us <span>→</span></a><a class="btn btn-play" href="#authors">Meet our authors</a></div></div>
          <div class="hero-visual"><div class="circle circle-one"></div><div class="main-photo"><img src="/Images/launch/whatsapp-launch.jpeg" alt="An author presenting a newly published book" /></div><div class="floating-book book-a"><img src="/Images/covers/beautiful-scars-new.jpg" alt="Beautiful Scars" /><span>New</span></div><div class="floating-book book-b"><img src="/Images/covers/not-expired.jpg" alt="Not Expired" /><span>Lead</span></div><div class="floating-book book-c"><img src="/Images/covers/rise-of-ndindi-nyoro.jpg" alt="The Rise of Ndindi Nyoro" /><span>Rise</span></div></div>
        </article>
        <article class="hero hero-slide transition-soft-rise" data-hero-slide hidden>
          <div class="hero-copy"><div class="eyebrow"><span>●</span> Conversations beyond the printed page.</div><h1>Listen to the ideas<br /><em>behind the books.</em></h1><p>The Reading Room brings authors and readers together for warm, useful conversations about writing, meaning and the stories that stay with us.</p><div class="hero-buttons"><a class="btn btn-primary" href="#podcast">Explore the podcast <span>→</span></a><a class="btn btn-play" href="#books">Find your next read</a></div></div>
          <div class="hero-visual"><div class="circle circle-one"></div><div class="main-photo studio-photo"><img src="/Images/backgrounds/reading-room-studio.jpg" alt="The Reading Room podcast studio" /></div><div class="happy-note"><span>▶</span><b>Listen.<br />Learn. Grow.</b></div></div>
        </article>
        <div class="slider-controls" aria-label="Slideshow controls"><button type="button" data-slide-prev aria-label="Previous slide">←</button><div>{[0,1,2,3].map((_,i)=><button type="button" class={i===0?'is-active':''} data-slide-dot={i} aria-label={`Show slide ${i+1}`}></button>)}</div><button type="button" data-slide-next aria-label="Next slide">→</button></div>
      </section>

      <section class="about-chance section" id="about">
        <div class="about-collage reveal"><figure class="about-main"><img src="/Images/launch/still-i-breathe.jpg" alt="A Chance Publishers author presenting Still, I Breathe" loading="lazy" /></figure><figure class="about-small"><img src="/Images/launch/terrain-pair.jpg" alt="Chance Publishers authors holding published books" loading="lazy" /></figure><figure class="about-book"><img src="/Images/launch/event-0175.jpg" alt="Guests sharing a launch cake at a Chance Publishers event" loading="lazy" /></figure></div>
        <div class="about-copy reveal"><span class="kicker">WHO WE ARE</span><h2>Chance Publishers helps ideas become <i>books with impact.</i></h2><p>Chance Publishers Limited is a Nairobi book publishing company supporting first-time and established authors across Kenya. We help transform manuscripts into professionally edited, beautifully designed and market-ready books.</p><p>From editing and proofreading to cover design, book layout, sample copies, printing guidance, launches and distribution support, we walk with authors through a clear and personal publishing journey.</p><div class="about-services"><span>Editorial care</span><span>Beautiful design</span><span>Publishing guidance</span><span>Author growth</span></div><a class="btn btn-primary" href="/contact">Meet Chance Publishers <span>→</span></a></div>
      </section>

      <section class="publishing-roadmap section" id="publishing-process">
        <div class="roadmap-intro reveal"><span class="kicker">HOW BOOK PUBLISHING WORKS IN KENYA</span><h2>A clear path from<br /><i>private draft to published book.</i></h2><p>Before printing begins, a manuscript needs careful review, editorial work, design, identifiers and final approval. Chance Publishers keeps each stage understandable so authors know what is happening, why it matters and what comes next.</p><div class="roadmap-actions"><a class="btn btn-primary" href="/publish">Learn the complete publishing process <span>→</span></a><a href="https://wa.me/254758305622?text=Hello%20Chance%20Publishers%2C%20I%20would%20like%20to%20discuss%20my%20manuscript.">Get started on WhatsApp ↗</a></div></div>
        <div class="roadmap-list reveal">
          <a href="/publish#process"><span>01</span><div><b>Protect & submit</b><small>NDA, manuscript submission and project review</small></div><i>↗</i></a>
          <a href="/publish#process"><span>02</span><div><b>Edit & proofread</b><small>Clarity, structure, language and final corrections</small></div><i>↗</i></a>
          <a href="/publish#isbn"><span>03</span><div><b>Identify & protect</b><small>ISBN guidance and copyright-registration support</small></div><i>↗</i></a>
          <a href="/publish#printing"><span>04</span><div><b>Design & print</b><small>Cover, layout, sample copy and production approval</small></div><i>↗</i></a>
          <a href="/launches"><span>05</span><div><b>Launch & grow</b><small>Launch guidance, branding and distribution support</small></div><i>↗</i></a>
        </div>
      </section>

      <section class="top-picks section" id="books">
        <div class="section-title reveal"><div><span class="kicker">READ • GROW • SHARE</span><h2>Some of the books <i>we have published.</i></h2></div><a href="/shop">Shop all books <span>→</span></a></div>
        <div class="picks-layout">
          <article class="feature-pick reveal">
            <img src="/Images/mockups/not-expired.jpg" alt="Not Expired book mock-up" loading="lazy" />
            <div><span>COMMUNITY FAVOURITES</span><h3>Books readers<br />love to share.</h3><p>Discover stories that start conversations and bring generations together.</p><a href="/books/top-picks">Browse popular books →</a></div>
          </article>
          <div class="product-grid">
            {products.map((product,index)=>(
              <article class="product-card reveal" style={`--delay:${index*45}ms`}>
                <a class="product-cover" href="/shop" aria-label={`View ${product[0]} in the shop`}>
                  <span class={`badge badge-${product[3].toLowerCase()}`}>{product[3]}</span>
                  <img src={product[2]} alt={`${product[0]} cover`} loading="lazy" style={product[4]?`object-position:${product[4]}`:undefined} />
                  <span class="quick-view">Quick view ↗</span>
                </a>
                <small>{product[1]}</small><h3>{product[0]}</h3><a href="/shop">Find in shop <span>→</span></a>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="author-cta author-cta-rich section" id="authors">
        <div class="author-copy reveal"><span class="kicker">YOUR BOOK STARTS HERE</span><h2>Your story deserves<br /><i>a beautiful beginning.</i></h2><p>Bring Chance Publishers the manuscript you have worked so hard to create. Our editorial and design team will help you refine the message, strengthen the writing, shape the pages, produce the finished book and prepare it to meet the world with confidence.</p><div class="author-steps"><span><b>01</b> Refine</span><span><b>02</b> Design</span><span><b>03</b> Publish</span><span><b>04</b> Launch</span></div><a class="btn btn-primary" href="/publish">Start your publishing journey <span>↗</span></a></div>
        <div class="author-visual reveal"><div class="author-visual-heading"><small>THE STORY IS YOURS</small><b>We help it arrive beautifully.</b></div><div class="author-image"><img src="/Images/launch/dsc-5746.jpg" alt="A Chance Publishers author presenting a published book" loading="lazy" /></div><div class="author-quote"><span>“</span><p>From a private manuscript<br />to a book readers can hold.</p></div><div class="author-note author-note-bottom"><b>EDIT • DESIGN • PUBLISH</b><br/>A clear journey, guided together.</div><div class="author-seal">CHANCE<br /><b>PUBLISHERS</b><br />YOUR CHANCE TO GROW</div></div>
      </section>

      <section class="launch-section launch-section-rich section" id="launches">
        <div class="launch-copy reveal"><span class="kicker">CHANCE PUBLISHERS BOOK LAUNCHES</span><h2><span>Where finished</span><br /><span>books</span><br /><i>meet their readers.</i></h2><p>Every Chance Publishers launch is more than a presentation—it is the moment an author’s work steps into the world, families celebrate the journey and meaningful ideas begin new conversations.</p><div class="launch-stats"><span><b>Books</b><small>beautifully introduced</small></span><span><b>Authors</b><small>proudly celebrated</small></span><span><b>Readers</b><small>brought together</small></span></div><a class="btn btn-primary" href="/launches">Explore Chance launch stories <span>→</span></a></div>
        <div class="launch-gallery reveal"><figure class="launch-main"><img src="/Images/launch/whatsapp-launch.jpeg" alt="A Chance Publishers book launch" loading="lazy" /><figcaption>Chance Publishers launch day</figcaption></figure><figure><img src="/Images/launch/ajtv-0648.jpg" alt="Readers and Chance Publishers authors" loading="lazy" /><figcaption>Readers & authors</figcaption></figure><figure><img src="/Images/launch/dsc-5746.jpg" alt="A Chance Publishers educational book presentation" loading="lazy" /><figcaption>Knowledge shared</figcaption></figure></div>
      </section>

      <section class="packages-section packages-compact section" id="packages">
        <div class="package-orbit orbit-one" aria-hidden="true">✦</div><div class="package-orbit orbit-two" aria-hidden="true">BOOK • GROW • PUBLISH</div>
        <div class="packages-heading reveal"><span class="packages-kicker">PUBLISHING PACKAGES</span><h2>Choose the support your<br /><i>book journey needs.</i></h2><p>Whether you are preparing your first manuscript or getting ready to launch and sell, our packages give you a clear professional path from draft to finished book.</p></div>
        <div class="package-grid">
          <article class="package-card silver reveal" style="--delay:0ms"><div class="package-card-top"><div class="package-medal"><span>Ⅱ</span></div><div class="package-tier"><small>GUIDED PUBLISHING</small><h3>Silver</h3></div></div><p>Complete guidance for authors ready to move from draft to publish-ready.</p><div class="package-price"><span>KSh</span><b>50,000</b></div><ul><li>Everything in Bronze</li><li>3 sample copies</li><li>Publishing guidance</li><li>Marketing support (Amazon only)</li></ul><button class="package-select" type="button" data-package="silver" data-price="50,000">Choose Silver <span>→</span></button></article>
          <article class="package-card gold featured reveal" style="--delay:100ms"><div class="popular-ribbon">FLAGSHIP PACKAGE</div><div class="package-card-top"><div class="package-medal"><span>Ⅰ</span></div><div class="package-tier"><small>PUBLISH, LAUNCH & SELL</small><h3>Gold</h3></div></div><p>Our highest-support package for publishing, promotion and distribution.</p><div class="package-price"><span>KSh</span><b>60,000</b></div><ul><li>Everything in Silver</li><li>Book launch guidance</li><li>Branding & priority support</li></ul><div class="store-chips" aria-label="Online distribution stores"><span>Amazon</span><span>Jiji</span><span>Kilimall</span><span>Nuria</span><span>Kibanga</span></div><button class="package-select" type="button" data-package="gold" data-price="60,000">Choose Gold <span>→</span></button></article>
          <article class="package-card bronze reveal" style="--delay:200ms"><div class="package-card-top"><div class="package-medal"><span>Ⅲ</span></div><div class="package-tier"><small>GET PUBLISH-READY</small><h3>Bronze</h3></div></div><p>For first-time authors preparing a manuscript for professional publishing.</p><div class="package-price"><span>KSh</span><b>40,000</b></div><ul><li>Editing & proofreading</li><li>Cover and book design</li><li>Copyright support</li><li>2 sample copies</li></ul><button class="package-select" type="button" data-package="bronze" data-price="40,000">Choose Bronze <span>→</span></button></article>
        </div>
        <div class="package-notes reveal"><div><span>🖨</span><p><b>Printing is quoted separately.</b><small>Every book receives a custom quotation based on its size, pages, paper, colour and quantity.</small></p></div><div><span>📣</span><p><b>Marketing can grow with you.</b><small>Launch guidance, store listings, author branding and promotion can be added to suit your goals.</small></p></div><button type="button" data-consult-open>Book a free consultation <span>↗</span></button></div>
      </section>

      <dialog class="package-dialog" data-package-dialog><button class="dialog-close" type="button" data-dialog-close aria-label="Close package details">×</button><div class="dialog-medal" data-dialog-medal>Ⅲ</div><small>YOU HAVE SELECTED</small><h2><span data-dialog-tier>Bronze</span> Package</h2><p class="dialog-price">KSh <b data-dialog-price>40,000</b></p><p>See exactly what the package includes and how every service supports your book before you proceed.</p><div class="dialog-actions"><a href="/packages/bronze#services" data-dialog-details>View full package details <span>→</span></a><a href="/publish?package=bronze" data-dialog-checkout>Proceed to checkout <span>↗</span></a></div></dialog>
      <dialog class="consult-dialog" data-consult-dialog><button class="dialog-close" type="button" data-consult-close aria-label="Close consultation options">×</button><small>FREE PUBLISHING CONSULTATION</small><h2>How would you like to talk?</h2><p>Connect directly with the Chance Publishers team in Nairobi.</p><div class="consult-options"><a href="https://wa.me/254758305622?text=Hello%20Chance%20Publishers%2C%20I%20would%20like%20a%20free%20publishing%20consultation." target="_blank" rel="noreferrer"><span>WhatsApp</span><b>Chat now →</b></a><a href="tel:+254758305622"><span>Phone call</span><b>+254 758 305 622 →</b></a><a href="mailto:info@chancepublishers.com?subject=Free%20Publishing%20Consultation"><span>Email</span><b>Write to us →</b></a></div></dialog>
      <dialog class="confirm-dialog" data-confirm-dialog><button class="dialog-close" type="button" data-confirm-close aria-label="Close">×</button><span class="confirm-icon">✓</span><h2 data-confirm-title>Manuscript sent</h2><p data-confirm-message>Thank you — our publishing team will be in touch soon.</p><button type="button" class="confirm-ok" data-confirm-close>Done</button></dialog>

      <section class="podcast-strip section" id="podcast">
        <img class="podcast-bg" src="/Images/backgrounds/reading-room-studio.jpg" alt="Podcast studio with two microphones and chairs" loading="lazy" />
        <div class="podcast-copy reveal"><span class="podcast-name">THE READING ROOM STUDIO</span><h2>Good books make<br /><i>great conversations.</i></h2><p>The Reading Room is where books move beyond the page. We sit down with writers, thinkers and readers to explore the experiences behind their work, practical lessons from their journeys and the questions that help all of us read, write and live with greater intention.</p><a class="btn btn-yellow podcast-main-button" href="#episodes"><span class="play">▶</span> Explore all podcasts</a></div>
        <a class="podcast-card podcast-mini-card reveal" id="episodes" href="#youtube-link-placeholder" aria-label="Open What makes a book stay with you on YouTube"><span class="mini-mic" aria-hidden="true">🎙</span><div><small>FEATURED CONVERSATION</small><h3>What makes a book stay with you?</h3><span>Watch episode ↗</span></div></a>
      </section>

    </main>

    <footer>
      <div class="footer-main">
        <div class="footer-brand"><img src="/Images/brand/chance-logo.png" alt="Chance Publishers" /><p>Professional book publishing, editing, design and printing support for authors in Kenya.</p><p class="footer-nap">Kenda House, 4th Floor, Tom Mboya Street, near Afya Centre, Nairobi<br/>Open Monday–Sunday, 6:00 a.m.–9:00 p.m.<br/><a href="tel:+254758305622">+254 758 305 622</a> · <a href="mailto:info@chancepublishers.com">info@chancepublishers.com</a></p></div>
        <div><h3>Explore</h3><a href="/books">Books</a><a href="/categories/religion">Categories</a><a href="/authors">Authors</a><a href="/launches">Launches</a></div>
        <div><h3>Chance</h3><a href="/publish">Publishing guide</a><a href="#packages">Publishing packages</a><a href="/podcast">The Reading Room Studio</a><a href="#about">About us</a><a href="/contact">Contact us</a></div>
        <div class="newsletter manuscript-box"><h3>Submit your manuscript.</h3><p>Add your details, choose your manuscript, and open a prepared submission to Chance Publishers.</p><form data-manuscript-form><div class="manuscript-fields"><label><span>Full name</span><input name="name" required placeholder="Your full name" /></label><label><span>Email address</span><input name="email" type="email" required placeholder="you@example.com" /></label></div><label><span>Tell us about the book</span><textarea name="message" rows="3" placeholder="Title, genre and a short description…"></textarea></label><label class="file-upload"><input name="manuscript" type="file" required accept=".doc,.docx,.pdf,.rtf,.odt" data-manuscript-file /><span>＋ Upload your manuscript</span><small data-file-name>PDF, Word, RTF or ODT</small></label><button type="submit">Prepare manuscript email →</button><small class="upload-note">Your email app will open with your details already written. For security, confirm the selected manuscript is attached before sending.</small></form></div>
      </div>
      <div class="footer-social-row socials"><a href="https://www.facebook.com/chancepublishers" aria-label="Chance Publishers on Facebook">f</a><a href="https://www.linkedin.com/company/chance-publishers/" aria-label="Chance Publishers on LinkedIn">in</a><a href="https://www.youtube.com/@chancepublishers" aria-label="Chance Publishers on YouTube"><img src="https://cdn.simpleicons.org/youtube/FFFFFF" alt="" /></a><a href="https://www.tiktok.com/@chancepublishers" aria-label="Chance Publishers on TikTok"><img src="https://cdn.simpleicons.org/tiktok/FFFFFF" alt="" /></a></div>
      <div class="footer-bottom"><span>© 2026 Chance Publishers Limited</span><div><a href="#">Privacy</a><a href="#">Terms</a></div><b>Your chance to grow 🌱</b></div>
    </footer>

    <script>
      const root = document.documentElement;
      document.querySelector('[data-theme-toggle]')?.addEventListener('click',()=>{const next=root.dataset.theme==='dark'?'light':'dark';root.dataset.theme=next;try{localStorage.setItem('chance-theme',next)}catch{}});
