---
import InnerPage from '../../layouts/InnerPage.astro';

const items = [
  {
    href: '/legal/privacy-policy',
    title: 'Privacy Policy',
    desc: 'What personal information we collect from authors, clients and site visitors, and how it is used.',
    icon: 'shield',
  },
  {
    href: '/legal/terms-of-use',
    title: 'Terms of Use',
    desc: 'The rules for using our website and author portal, and the terms of our publishing services.',
    icon: 'document',
  },
  {
    href: '/legal/data-protection',
    title: 'Data Protection',
    desc: 'How we secure your data in line with the Kenya Data Protection Act, 2019, and your rights over it.',
    icon: 'lock',
  },
  {
    href: '/legal/author-safety',
    title: 'Author Safety',
    desc: 'How we protect authors from plagiarism, exploitation and unsafe publishing practices.',
    icon: 'heart',
  },
  {
    href: '/legal/author-verification',
    title: 'Author Verification',
    desc: 'Why we verify your identity before publishing, and how that information is used and protected.',
    icon: 'id',
  },
  {
    href: '/legal/copyright-ownership',
    title: 'Copyright &amp; Manuscript Ownership',
    desc: 'You own your manuscript before, during and after working with us — here is exactly what that means.',
    icon: 'book',
  },
  {
    href: '/legal/payment-policy',
    title: 'Payment Policy',
    desc: 'How package fees, NDA fees and printing costs are invoiced, split and paid.',
    icon: 'card',
  },
  {
    href: '/legal/refund-policy',
    title: 'Refund Policy',
    desc: 'When a payment can be refunded, and how to request one.',
    icon: 'refund',
  },
  {
    href: '/legal/cookie-policy',
    title: 'Cookie Policy',
    desc: 'The cookies our website and portal use, and how to control them.',
    icon: 'cookie',
  },
];

const icons: Record<string, string> = {
  shield: '<path d="M12 3l7 3v6c0 4.5-3 8-7 9-4-1-7-4.5-7-9V6l7-3z"/><path d="M9 12l2 2 4-4"/>',
  document: '<path d="M7 3h7l4 4v14H7z"/><path d="M14 3v4h4"/><path d="M9.5 12h5M9.5 15.5h5M9.5 8.5h2"/>',
  lock: '<rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/>',
  heart: '<path d="M12 20s-7-4.35-9.5-8.5C.8 8 2 4.5 5.5 4c2-.3 3.7.8 4.5 2.2C10.8 4.8 12.5 3.7 14.5 4 18 4.5 19.2 8 17.5 11.5 15 15.65 12 20 12 20z"/>',
  id: '<rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="9" cy="12" r="2"/><path d="M7 16.5c.5-1.5 1.8-2.2 3.2-2.2s2.5.7 3 2.2M14 9.5h5M14 13h5"/>',
  book: '<path d="M4 5c2.5-1 5.5-1 8 0v14c-2.5-1-5.5-1-8 0z"/><path d="M20 5c-2.5-1-5.5-1-8 0v14c2.5-1 5.5-1 8 0z"/>',
  card: '<rect x="3" y="6" width="18" height="13" rx="2"/><path d="M3 10.5h18"/><path d="M7 15h4"/>',
  refund: '<path d="M4 12a8 8 0 1 1 2.3 5.6"/><path d="M4 18v-4h4"/>',
  cookie: '<path d="M12 3a8.5 8.5 0 1 0 8.9 10.4 3 3 0 0 1-3.6-3.7A3 3 0 0 1 13.3 6a3 3 0 0 1-1.3-3z"/><circle cx="9" cy="11" r=".9" fill="currentColor" stroke="none"/><circle cx="13" cy="15" r=".9" fill="currentColor" stroke="none"/><circle cx="10" cy="17" r=".7" fill="currentColor" stroke="none"/>',
};
---
<InnerPage title="Legal &amp; Safety" description="Privacy, terms, data protection, payment and safety policies for Chance Publishers authors and clients.">
  <section class="legal-hub-hero page-hero">
    <small>LEGAL &amp; SAFETY</small>
    <h1>Legal &amp; Safety</h1>
    <p>Clear, plain-language policies covering your privacy, your manuscript's ownership, how payments work, and how we keep your information and your work safe.</p>
  </section>

  <section class="legal-hub-grid">
    {items.map((item) => (
      <a class="legal-hub-card" href={item.href}>
        <span class="legal-hub-icon" set:html={`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">${icons[item.icon]}</svg>`} />
        <span class="legal-hub-text">
          <b set:html={item.title} />
          <small>{item.desc}</small>
        </span>
        <span class="legal-hub-arrow">→</span>
      </a>
    ))}
  </section>
</InnerPage>
<style>
  .legal-hub-hero p{margin-top:1rem}
  .legal-hub-grid{max-width:820px;margin:-2.5rem auto 5rem;padding:0 clamp(1rem,5vw,2rem);position:relative;z-index:2;display:grid;gap:1rem}
  .legal-hub-card{display:flex;align-items:center;gap:1.1rem;padding:1.3rem 1.4rem;background:var(--surface);border:1px solid var(--line);border-radius:16px;text-decoration:none;color:var(--text);box-shadow:0 10px 30px rgba(12,50,29,.07);transition:transform .15s ease,box-shadow .15s ease}
  .legal-hub-card:hover{transform:translateY(-2px);box-shadow:0 14px 34px rgba(12,50,29,.12)}
  .legal-hub-icon{flex-shrink:0;width:44px;height:44px;display:grid;place-items:center;border-radius:12px;background:var(--soft-green);color:var(--deep-green)}
  html[data-theme="dark"] .legal-hub-icon{color:var(--yellow)}
  .legal-hub-icon svg{width:22px;height:22px}
  .legal-hub-text{display:grid;gap:.25rem;flex:1}
  .legal-hub-text b{font-family:var(--display);font-size:1rem}
  .legal-hub-text small{color:var(--muted);font-size:.82rem;line-height:1.5}
  .legal-hub-arrow{color:var(--muted);font-weight:900}
</style>
