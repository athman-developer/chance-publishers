---
import InnerPage from '../layouts/InnerPage.astro';
import {books,categories} from '../data/books.js';
---
<InnerPage title="Chance Publishers Bookshop Kenya" description="Shop books published by Chance Publishers in Kenya. Browse fiction, religion, education, leadership, research and inspiring African books with local ordering support.">
  <section class="shop-hero"><div><small>THE CHANCE BOOKSHOP</small><h1>Find a book<br/><i>worth keeping.</i></h1><p>Browse books created with Kenyan authors, educators, researchers and storytellers. Compare titles, formats and guide prices, then order directly from our team.</p><a href="#shop-grid">Start shopping ↓</a></div><div class="hero-books">{books.slice(0,5).map((book,index)=><img class={`book-${index+1}`} src={book.image} alt={`${book.title} cover`}/>)}</div></section>
  <section class="shop-wrap" data-shop>
    <aside class="filters"><div class="filter-head"><h2>Refine results</h2><button type="button" data-clear>Clear</button></div><label class="search"><span>Search the shop</span><input type="search" placeholder="Title, author or topic…" data-search/></label><div class="filter-block"><b>Category</b><label><input type="radio" name="category" value="all" checked/>All books</label>{categories.map(item=><label><input type="radio" name="category" value={item.short}/>{item.name}</label>)}</div><div class="filter-block"><b>Price</b><label><input type="radio" name="price" value="all" checked/>All prices</label><label><input type="radio" name="price" value="under1200"/>Under KSh 1,200</label><label><input type="radio" name="price" value="1200to1600"/>KSh 1,200–1,600</label><label><input type="radio" name="price" value="over1600"/>Above KSh 1,600</label></div><p>Guide prices can be updated when the final shop catalogue is confirmed.</p></aside>
    <div class="results" id="shop-grid"><div class="toolbar"><p><b data-count>{books.length}</b> results</p><select data-sort aria-label="Sort books"><option value="featured">Featured</option><option value="low">Price: low to high</option><option value="high">Price: high to low</option><option value="title">Title A–Z</option></select></div><div class="product-grid" data-grid>{books.map(book=><article class="product" data-title={`${book.title} ${book.author} ${book.category}`.toLowerCase()} data-category={book.category} data-price={book.price}><a class="cover-link" href={`/contact?book=${encodeURIComponent(book.title)}`}><div class="cover"><img src={book.image} alt={`${book.title} cover`} loading="lazy"/><span>{book.badge}</span></div></a><div class="rating" aria-label="Five star rating">★★★★★ <small>New title</small></div><a class="title" href={`/contact?book=${encodeURIComponent(book.title)}`}>{book.title}</a><p>by <b>{book.author}</b></p><small>{book.category} · Paperback</small><div class="price"><sup>KSh</sup><b>{book.price.toLocaleString()}</b></div><p class="delivery">Available from Chance Publishers, Nairobi</p><div class="actions"><a href={`https://wa.me/254758305622?text=${encodeURIComponent(`Hello Chance Publishers, I would like to order ${book.title}.`)}`}>Order on WhatsApp</a><a class="details" href={`/contact?book=${encodeURIComponent(book.title)}`}>Details</a></div></article>)}</div><div class="empty" data-empty hidden><h2>No matching books</h2><p>Clear a filter or try another search.</p></div></div>
  </section>
</InnerPage>
<script>const root=document.querySelector('[data-shop]');if(root){const cards=[...root.querySelectorAll('.product')];const search=root.querySelector('[data-search]');const count=root.querySelector('[data-count]');const grid=root.querySelector('[data-grid]');const empty=root.querySelector('[data-empty]');const apply=()=>{const query=search.value.toLowerCase();const category=root.querySelector('input[name="category"]:checked')?.value||'all';const price=root.querySelector('input[name="price"]:checked')?.value||'all';let visible=0;cards.forEach(card=>{const amount=Number(card.dataset.price);const priceOk=price==='all'||price==='under1200'&&amount<1200||price==='1200to1600'&&amount>=1200&&amount<=1600||price==='over1600'&&amount>1600;const show=card.dataset.title.includes(query)&&(category==='all'||card.dataset.category===category)&&priceOk;card.hidden=!show;if(show)visible++});count.textContent=String(visible);empty.hidden=visible!==0};search.addEventListener('input',apply);root.querySelectorAll('input[type="radio"]').forEach(input=>input.addEventListener('change',apply));root.querySelector('[data-clear]').addEventListener('click',()=>{search.value='';root.querySelectorAll('input[value="all"]').forEach(input=>input.checked=true);apply()});root.querySelector('[data-sort]').addEventListener('change',event=>{const sorted=[...cards].sort((a,b)=>event.target.value==='low'?a.dataset.price-b.dataset.price:event.target.value==='high'?b.dataset.price-a.dataset.price:event.target.value==='title'?a.dataset.title.localeCompare(b.dataset.title):0);sorted.forEach(card=>grid.append(card))})}</script>
<style>
  .shop-hero{min-height:560px;padding:clamp(4rem,7vw,7rem) clamp(1rem,6vw,7rem);display:grid;grid-template-columns:.85fr 1.15fr;align-items:center;gap:4rem;overflow:hidden;background:radial-gradient(circle at 85% 12%,rgba(255,216,47,.24),transparent 25%),linear-gradient(135deg,#071f15,#087341);color:#fff}.shop-hero small{color:var(--yellow);font-weight:900;letter-spacing:.15em}.shop-hero h1{margin:.7rem 0 1rem;font-family:var(--display);font-size:clamp(4rem,7vw,7.2rem);line-height:.88;letter-spacing:-.06em}.shop-hero h1 i{color:var(--yellow);font-family:"Patrick Hand",cursive;font-weight:400}.shop-hero p{max-width:640px;color:rgba(255,255,255,.8);line-height:1.8}.shop-hero>div>a{display:inline-block;margin-top:1.2rem;padding:.95rem 1.1rem;border-radius:12px;background:var(--yellow);color:#173020;text-decoration:none;font-weight:900;box-shadow:0 6px 0 #b58a00}.hero-books{position:relative;min-height:410px}.hero-books img{position:absolute;width:31%;height:70%;object-fit:cover;border:6px solid #fff;border-radius:12px;box-shadow:0 25px 60px rgba(0,0,0,.35)}.book-1{left:2%;top:10%;transform:rotate(-8deg)}.book-2{left:19%;top:2%;transform:rotate(-4deg)}.book-3{left:37%;top:0;z-index:3}.book-4{right:16%;top:4%;transform:rotate(5deg)}.book-5{right:0;top:12%;transform:rotate(9deg)}
  .shop-wrap{padding:clamp(4rem,6vw,6rem) clamp(1rem,5vw,5.5rem);display:grid;grid-template-columns:250px 1fr;gap:2.5rem;background:#f5f7f5;color:#17251b}.filters{position:sticky;top:155px;align-self:start;padding:1.25rem;border:1px solid #d9e1dc;border-radius:18px;background:#fff;box-shadow:0 12px 35px rgba(14,60,32,.08)}.filter-head{display:flex;align-items:center;justify-content:space-between}.filter-head h2{font-family:var(--display);font-size:1.15rem}.filter-head button{border:0;background:none;color:#098042;font-weight:900;cursor:pointer}.search{display:grid;gap:.4rem;margin:1rem 0}.search span,.filter-block>b{font-size:.67rem;font-weight:900;text-transform:uppercase;letter-spacing:.08em}.search input{width:100%;padding:.75rem;border:1px solid #d9e1dc;border-radius:9px}.filter-block{padding:1rem 0;display:grid;gap:.65rem;border-top:1px solid #e1e6e3}.filter-block label{display:flex;align-items:center;gap:.55rem;font-size:.76rem}.filters>p{color:#65726a;font-size:.65rem;line-height:1.5}.toolbar{display:flex;align-items:center;justify-content:space-between;margin-bottom:1.4rem}.toolbar p{margin:0}.toolbar select{padding:.7rem 1rem;border:1px solid #d9e1dc;border-radius:9px;background:#fff}.product-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1.2rem}.product{padding:1rem;display:flex;flex-direction:column;border:1px solid #dde4df;border-radius:16px;background:#fff;box-shadow:0 8px 25px rgba(16,65,35,.06);transition:.25s}.product:hover{transform:translateY(-5px);box-shadow:0 18px 40px rgba(16,65,35,.13)}.cover{position:relative;aspect-ratio:.68;overflow:hidden;border-radius:9px;background:#edf1ee}.cover img{width:100%;height:100%;object-fit:cover}.cover span{position:absolute;left:.5rem;top:.5rem;padding:.32rem .45rem;border-radius:999px;background:#ffd82f;color:#17251b;font-size:.48rem;font-weight:900}.rating{margin-top:.75rem;color:#e5a900;font-size:.7rem}.rating small{color:#65726a}.title{min-height:2.7em;margin:.3rem 0;color:#17251b;text-decoration:none;font-family:var(--display);font-size:.92rem;line-height:1.3}.title:hover{color:#08743e}.product>p{margin:.15rem 0;color:#65726a;font-size:.67rem}.product>small{color:#65726a;font-size:.58rem}.price{margin:.7rem 0;color:#17251b}.price sup{font-size:.58rem}.price b{font-family:var(--display);font-size:1.35rem}.delivery{color:#0a7340!important}.actions{margin-top:auto;display:grid;gap:.45rem}.actions a{padding:.65rem;border-radius:9px;background:#ffd82f;color:#17251b;text-decoration:none;text-align:center;font-size:.62rem;font-weight:900}.actions .details{border:1px solid #b8c6bd;background:#fff}.empty{padding:5rem;text-align:center}
  @media(max-width:1150px){.product-grid{grid-template-columns:repeat(3,1fr)}}@media(max-width:820px){.shop-hero{grid-template-columns:1fr}.hero-books{min-height:350px}.shop-wrap{grid-template-columns:1fr}.filters{position:static}.product-grid{grid-template-columns:repeat(3,1fr)}}@media(max-width:600px){.shop-hero{padding:3rem 1rem}.shop-hero h1{font-size:clamp(3.2rem,15vw,4.8rem)}.hero-books{min-height:270px}.shop-wrap{padding-inline:1rem}.product-grid{grid-template-columns:repeat(2,1fr);gap:.7rem}.product{padding:.65rem}.title{font-size:.78rem}.toolbar{align-items:flex-start}.toolbar select{max-width:150px}}
</style>
