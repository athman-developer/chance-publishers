---
import InnerPage from '../layouts/InnerPage.astro';
import {customProducts} from '../data/books.js';
---
<InnerPage title="Custom Book Products" description="Personalized bookmarks, journals, gift sets and keepsakes made around a reader, an author or a story — from Chance Publishers, Nairobi.">
  <section class="shop-hero"><div><small>MADE FOR YOU</small><h1>Custom &amp; personalized<br/><i>book products.</i></h1><p>Gifts and keepsakes made around a reader, an author, or a story. Every piece below is made to order — send us your idea on WhatsApp and we'll quote it for you.</p><a href="#custom-grid">See the products ↓</a><p class="books-note">Looking for a book to buy? Visit our bookshop at <a href="https://shop.chancepublishers.com">shop.chancepublishers.com</a>.</p></div></section>
  <section class="custom-wrap">
    <div class="custom-grid" id="custom-grid">{customProducts.map(item=><article class="custom-card"><h3>{item.name}</h3><p>{item.description}</p><a href={`https://wa.me/254758305622?text=${encodeURIComponent(`Hello Chance Publishers, I would like to ask about: ${item.name}.`)}`}>Ask on WhatsApp</a></article>)}</div>
  </section>
</InnerPage>
<style>
  .shop-hero{min-height:420px;padding:clamp(4rem,7vw,7rem) clamp(1rem,6vw,7rem);display:flex;align-items:center;overflow:hidden;background:radial-gradient(circle at 85% 12%,rgba(255,216,47,.24),transparent 25%),linear-gradient(135deg,#071f15,#087341);color:#fff}.shop-hero small{color:var(--yellow);font-weight:900;letter-spacing:.15em}.shop-hero h1{margin:.7rem 0 1rem;font-family:var(--display);font-size:clamp(3rem,6vw,5rem);line-height:.95;letter-spacing:-.04em}.shop-hero h1 i{color:var(--yellow);font-family:"Patrick Hand",cursive;font-weight:400}.shop-hero p{max-width:640px;color:rgba(255,255,255,.8);line-height:1.8}.shop-hero>div>a{display:inline-block;margin-top:1.2rem;padding:.95rem 1.1rem;border-radius:12px;background:var(--yellow);color:#173020;text-decoration:none;font-weight:900;box-shadow:0 6px 0 #b58a00}.books-note{margin-top:1.5rem;font-size:.8rem;color:rgba(255,255,255,.65)}.books-note a{color:var(--yellow);font-weight:800}
  .custom-wrap{padding:clamp(3rem,6vw,5rem) clamp(1rem,5vw,5.5rem) clamp(4rem,7vw,6rem);background:#fff}
  .custom-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1.1rem}.custom-card{padding:1.3rem;border:1px solid #dde4df;border-radius:14px;background:#f5f7f5;transition:.25s}.custom-card:hover{transform:translateY(-4px);box-shadow:0 14px 30px rgba(16,65,35,.1);background:#fff}.custom-card h3{margin:0 0 .5rem;font-family:var(--display);font-size:1rem;color:#17251b;line-height:1.25}.custom-card p{margin:0 0 1rem;color:#65726a;font-size:.78rem;line-height:1.6;min-height:3.6em}.custom-card a{display:inline-block;padding:.55rem .9rem;border-radius:9px;background:#ffd82f;color:#17251b;text-decoration:none;font-size:.68rem;font-weight:900}
  @media(max-width:1150px){.custom-grid{grid-template-columns:repeat(3,1fr)}}@media(max-width:820px){.custom-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:600px){.shop-hero{padding:3rem 1rem}.shop-hero h1{font-size:clamp(2.6rem,12vw,3.6rem)}.custom-wrap{padding-inline:1rem}.custom-grid{grid-template-columns:1fr}}
</style>
