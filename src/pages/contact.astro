id var(--line);border-top:5px solid var(--green);border-radius:22px;background:var(--surface);color:var(--text);text-decoration:none;box-shadow:0 18px 50px rgba(17,70,38,.11);transition:.25s ease}.contact-card:hover{transform:translateY(-7px);box-shadow:0 25px 65px rgba(17,70,38,.17)}.contact-card>span{width:52px;height:52px;display:grid;place-items:center;border-radius:15px;background:var(--soft-green);color:var(--deep-green);font-size:1.4rem}.contact-card small{display:block;margin-top:1.2rem;color:var(--green);font-size:.58rem}.contact-card h2{margin:.35rem 0;font-family:var(--display);font-size:1.6rem}.contact-card p{min-height:3em;color:var(--muted);line-height:1.55}.contact-card b{color:var(--deep-green);font-size:.78rem}.contact-card.whatsapp{border-top-color:var(--yellow)}.visit-section{padding:clamp(5rem,8vw,8rem) clamp(1rem,6vw,7rem);display:grid;grid-template-columns:.75fr 1.25fr;align-items:center;gap:clamp(3rem,7vw,7rem);background:var(--surface-2)}.visit-copy h2,.message-intro h2{margin:.7rem 0 1.3rem;font-family:var(--display);font-size:clamp(2.7rem,5vw,5rem);line-height:.95;letter-spacing:-.05em}.visit-copy>p{color:var(--muted);font-size:1rem;line-height:1.75}.visit-copy>p b{color:var(--text);font-family:var(--display);font-size:1.15rem}.postal{font-size:.8rem!important}.secondary-numbers{display:flex;gap:.5rem;flex-wrap:wrap;margin:1.4rem 0}.secondary-numbers a{padding:.6rem .75rem;border-radius:999px;background:var(--soft-green);color:var(--deep-green);text-decoration:none;font-size:.72rem;font-weight:900}.directions{display:inline-block;color:var(--deep-green);font-weight:900;text-underline-offset:5px}.map-wrap{position:relative;min-height:520px;overflow:hidden;border:8px solid var(--surface);border-radius:28px;box-shadow:0 25px 70px rgba(20,65,36,.15)}.map-wrap iframe{position:absolute;inset:0;width:100%;height:100%;border:0;filter:saturate(.8)}.map-label{position:absolute;left:1rem;bottom:1rem;padding:.8rem 1rem;display:flex;align-items:center;gap:.8rem;border-radius:13px;background:#fff;color:#173020;box-shadow:0 12px 35px rgba(0,0,0,.17)}.map-label>span{font-size:1.5rem;color:var(--green)}.map-label div{display:grid}.map-label small{color:#6a786f;font-size:.52rem;font-weight:900}.map-label b{font-family:var(--display);font-size:.8rem}.message-section{padding:clamp(5rem,8vw,8rem) clamp(1rem,6vw,7rem);display:grid;grid-template-columns:.82fr 1.18fr;gap:clamp(3rem,7vw,7rem);background:var(--surface)}.message-intro>p{max-width:540px;color:var(--muted);line-height:1.75}.service-list{display:flex;gap:.55rem;flex-wrap:wrap;margin-top:1.5rem}.service-list span{padding:.55rem .7rem;border:1px solid var(--line);border-radius:999px;background:var(--surface-2);font-size:.68rem;font-weight:900}.contact-form{padding:clamp(1.2rem,3vw,2.3rem);display:grid;grid-template-columns:1fr 1fr;gap:1rem;border:1px solid var(--line);border-radius:26px;background:var(--surface-2);box-shadow:0 20px 65px rgba(18,75,39,.1)}.contact-form label{display:grid;gap:.45rem;color:var(--text);font-size:.7rem;font-weight:900}.contact-form input,.contact-form select,.contact-form textarea{width:100%;padding:.9rem 1rem;border:1px solid var(--line);border-radius:11px;background:var(--surface);color:var(--text);outline:none}.contact-form textarea{resize:vertical}.contact-form input:focus,.contact-form select:focus,.contact-form textarea:focus{border-color:var(--green);box-shadow:0 0 0 3px color-mix(in srgb,var(--green) 15%,transparent)}.contact-form .full{grid-column:1/-1}.hp-field{position:absolute!important;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap}.contact-form button{padding:1rem 1.2rem;display:flex;justify-content:space-between;border:0;border-radius:12px;background:var(--green);color:#fff;font-family:var(--display);font-weight:900;cursor:pointer;box-shadow:0 6px 0 var(--deep-green)}.form-note{margin:.2rem 0 0;color:var(--muted);font-size:.62rem}.social-section{padding:3rem clamp(1rem,6vw,7rem);display:flex;align-items:center;justify-content:space-between;gap:2rem;background:var(--yellow);color:#173020}.social-section small{color:var(--deep-green)}.social-section h2{margin:.3rem 0 0;font-family:var(--display);font-size:clamp(2rem,4vw,4rem)}.social-section nav{display:flex;gap:.7rem;flex-wrap:wrap;justify-content:flex-end}.social-section a{padding:.7rem .85rem;border:1px solid rgba(23,48,32,.28);border-radius:999px;color:#173020;text-decoration:none;font-size:.72rem;font-weight:900}
  @media(max-width:900px){.contact-hero,.visit-section,.message-section{grid-template-columns:1fr}.contact-hero{min-height:auto;padding-block:4rem;gap:2.5rem}.contact-hero-copy{max-width:760px}.contact-portrait{width:min(100%,720px);min-height:410px;margin-inline:auto}.contact-options{grid-template-columns:1fr 1fr}.contact-options .contact-card:last-child{grid-column:1/-1}.map-wrap{min-height:430px}}
  @media(max-width:600px){.contact-hero{padding:3rem 1rem 2.4rem;gap:1.7rem}.contact-hero h1{font-size:clamp(3rem,13vw,4.35rem);line-height:.9}.contact-hero-copy>p{font-size:.92rem;line-height:1.65}.hero-actions{display:grid;margin-top:1.3rem}.hero-actions a{width:100%;padding:.88rem 1rem;text-align:center}.contact-portrait{width:min(100%,420px);min-height:285px}.contact-portrait>img{inset:0;width:100%;border-width:6px;border-radius:24px}.portrait-note{right:.35rem;bottom:-.6rem;width:90px;height:90px;padding:.5rem}.portrait-note b{font-size:.62rem}.portrait-note span{font-size:.43rem}.contact-options{grid-template-columns:1fr;margin-top:0;padding:2rem 1rem 4rem}.contact-options .contact-card:last-child{grid-column:auto}.visit-section,.message-section{padding-inline:1rem}.contact-form{grid-template-columns:1fr}.contact-form label{grid-column:1/-1}.social-section{display:block}.social-section nav{justify-content:flex-start;margin-top:1.2rem}.map-wrap{min-height:330px}}
</style>
