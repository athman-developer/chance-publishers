---
import InnerPage from '../layouts/InnerPage.astro';

const contactSchema = {
  '@context': 'https://schema.org',
  '@type': 'Publisher',
  name: 'Chance Publishers Limited',
  url: 'https://chancepublishers.com',
  email: 'chancepublishersltd@gmail.com',
  telephone: '+254758305622',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Kenda House, 4th Floor, Tom Mboya Street',
    addressLocality: 'Nairobi',
    postalCode: '00100',
    addressCountry: 'KE',
  },
  sameAs: [
    'https://www.instagram.com/chancepublishers/',
    'https://www.tiktok.com/@chancepublishers',
    'https://www.linkedin.com/company/chance-publishers/',
  ],
};
---

<InnerPage title="Contact Chance Publishers Nairobi" description="Contact Chance Publishers Limited in Nairobi for book publishing, editing, proofreading, cover design, printing and author support in Kenya.">
  <script type="application/ld+json" set:html={JSON.stringify(contactSchema)} />

  <section class="contact-hero">
    <div class="contact-hero-copy">
      <small>CONTACT CHANCE PUBLISHERS</small>
      <h1>Let’s talk about<br /><i>your book.</i></h1>
      <p>Whether you have a finished manuscript or a first idea, our Nairobi publishing team will help you understand the next clear step.</p>
      <div class="hero-actions">
        <a class="primary" href="https://wa.me/254758305622?text=Hello%20Chance%20Publishers%2C%20I%20would%20like%20to%20discuss%20my%20book.">Chat on WhatsApp <span>↗</span></a>
        <a href="tel:+254758305622">Call +254 758 305 622</a>
      </div>
    </div>
    <div class="contact-portrait">
      <img src="/Images/launch/ajtv-0282.jpg" alt="Chance Publishers author and reader community in Nairobi" />
      <div class="portrait-note"><b>YOUR CHANCE<br />TO GROW</b><span>Publishing support in Kenya</span></div>
    </div>
  </section>

  <section class="contact-options" aria-label="Contact options">
    <a class="contact-card whatsapp" href="https://wa.me/254758305622?text=Hello%20Chance%20Publishers%2C%20I%20would%20like%20a%20free%20publishing%20consultation."><span>◉</span><small>FASTEST RESPONSE</small><h2>WhatsApp us</h2><p>Start a direct conversation with our publishing team.</p><b>+254 758 305 622 →</b></a>
    <a class="contact-card" href="tel:+254758305622"><span>✆</span><small>PHONE</small><h2>Call our team</h2><p>Talk through your manuscript, printing or publishing needs.</p><b>+254 758 305 622 →</b></a>
    <a class="contact-card" href="mailto:chancepublishersltd@gmail.com"><span>✉</span><small>EMAIL</small><h2>Write to us</h2><p>Send your questions and project details for a considered reply.</p><b>chancepublishersltd@gmail.com →</b></a>
  </section>

  <section class="visit-section">
    <div class="visit-copy">
      <small>VISIT OUR NAIROBI OFFICE</small>
      <h2>Find Chance Publishers in the heart of Nairobi.</h2>
      <p><b>Kenda House, 4th Floor</b><br />Tom Mboya Street, near Afya Centre<br />Nairobi CBD, Kenya</p>
      <p class="postal">Postal address: 1776–00100 GPO Nairobi</p>
      <div class="secondary-numbers"><a href="tel:+254710462063">+254 710 462 063</a><a href="tel:+254112976824">+254 112 976 824</a></div>
      <a class="directions" href="https://www.google.com/maps/search/?api=1&query=Kenda+House+Tom+Mboya+Street+Nairobi">Open directions in Google Maps ↗</a>
    </div>
    <div class="map-wrap">
      <iframe title="Map showing Kenda House, Tom Mboya Street, Nairobi" src="https://www.google.com/maps?q=Kenda+House,+Tom+Mboya+Street,+Nairobi&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
      <div class="map-label"><span>⌖</span><div><small>CHANCE PUBLISHERS</small><b>Kenda House • 4th Floor</b></div></div>
    </div>
  </section>

  <section class="message-section">
    <div class="message-intro">
      <small>YOUR MANUSCRIPT CAN START HERE</small>
      <h2>Tell us what you are working on.</h2>
      <p>Share a few details and we will prepare an email to the Chance Publishers team. You can review it before sending.</p>
      <div class="service-list"><span>Editing & proofreading</span><span>Book cover design</span><span>Book layout & formatting</span><span>Book printing in Nairobi</span><span>Author branding</span><span>Launch & distribution support</span></div>
    </div>
    <form class="contact-form" data-contact-form>
      <label class="hp-field" aria-hidden="true">Leave this blank<input name="website" tabindex="-1" autocomplete="off" /></label>
      <label>Full name<input name="name" autocomplete="name" required placeholder="Your name" /></label>
      <label>Email address<input name="email" type="email" autocomplete="email" required placeholder="you@example.com" /></label>
      <label>Phone number<input name="phone" type="tel" autocomplete="tel" placeholder="+254…" /></label>
      <label>What do you need?<select name="service"><option>Publishing consultation</option><option>Editing and proofreading</option><option>Cover design and book layout</option><option>Book printing</option><option>Launch and distribution</option><option>Other publishing support</option></select></label>
      <label class="full">Tell us about your book<textarea name="message" rows="5" required placeholder="What is the book about, and where are you in your journey?"></textarea></label>
      <button class="full" type="submit">Send message <span>→</span></button>
      <p class="full form-note">Your message is sent directly to chancepublishersltd@gmail.com.</p>
    </form>
  </section>

  <dialog class="confirm-dialog" data-confirm-dialog><button class="dialog-close" type="button" data-confirm-close aria-label="Close">×</button><span class="confirm-icon">✓</span><h2 data-confirm-title>Message sent</h2><p data-confirm-message>Thank you — our publishing team will be in touch soon.</p><button type="button" class="confirm-ok" data-confirm-close>Done</button></dialog>

  <section class="social-section">
    <div><small>FOLLOW THE JOURNEY</small><h2>@chancepublishers</h2></div>
    <nav aria-label="Chance Publishers social media"><a href="https://www.instagram.com/chancepublishers/">Instagram ↗</a><a href="https://www.tiktok.com/@chancepublishers">TikTok ↗</a><a href="https://www.linkedin.com/company/chance-publishers/">LinkedIn ↗</a><a href="https://www.youtube.com/@chancepublishers">YouTube ↗</a></nav>
  </section>
</InnerPage>

<script>
  const contactFormLoadedAt = Date.now();
  const confirmDialog = document.querySelector('[data-confirm-dialog]');
  const openConfirm = (title, message) => {
    if (!confirmDialog) return;
    confirmDialog.querySelector('[data-confirm-title]').textContent = title;
    confirmDialog.querySelector('[data-confirm-message]').textContent = message;
    confirmDialog.showModal();
  };
  document.querySelectorAll('[data-confirm-close]').forEach((button) => button.addEventListener('click', () => confirmDialog?.close()));
  confirmDialog?.addEventListener('click', (event) => { if (event.target === confirmDialog) confirmDialog.close(); });

  const contactForm = document.querySelector('[data-contact-form]');
  contactForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const form = event.currentTarget;
    const data = new FormData(form);
    data.set('elapsedMs', String(Date.now() - contactFormLoadedAt));
    const name = String(data.get('name') || 'Reader');
    const email = String(data.get('email') || '');
    const phone = String(data.get('phone') || 'Not provided');
    const service = String(data.get('service') || 'Publishing consultation');
    const message = String(data.get('message') || '');
    const button = form.querySelector('button[type="submit"]');
    const originalLabel = button?.innerHTML;
    if (button) { button.disabled = true; button.textContent = 'Sending…'; }
    try {
      const response = await fetch('/api/submit-contact', { method: 'POST', body: data });
      const result = await response.json().catch(() => ({ ok: false }));
      if (!response.ok || !result.ok) throw new Error(result.error || 'send-failed');
      form.reset();
      openConfirm('Message sent', 'Thank you — our publishing team has received your message and will be in touch soon. A confirmation has been sent to your email.');
    } catch (err) {
      const subject = `Publishing enquiry: ${service} — ${name}`;
      const body = `Hello Chance Publishers,\n\nMy name is ${name}. I would like help with ${service}.\n\n${message}\n\nMy contact details:\nEmail: ${email}\nPhone: ${phone}\n\nThank you.`;
      openConfirm('Opening your email app instead', "We couldn't send that automatically just now. We've filled in your details in your email app — please press send.");
      window.location.href = `mailto:chancepublishersltd@gmail.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    } finally {
      if (button) { button.disabled = false; button.innerHTML = originalLabel; }
    }
  });
</script>

<style>
  .confirm-dialog{width:min(420px,calc(100vw - 2rem));padding:2.2rem 2rem;text-align:center;border:1px solid rgba(255,255,255,.2);border-radius:26px;background:linear-gradient(145deg,#092d1c,#061b12);color:#fff;box-shadow:0 35px 120px rgba(0,0,0,.55)}.confirm-dialog::backdrop{background:rgba(3,12,8,.72);backdrop-filter:blur(7px)}.confirm-icon{display:grid;width:56px;height:56px;margin:0 auto 1rem;place-items:center;border-radius:50%;background:var(--yellow);color:#173020;font-size:1.6rem;font-weight:900}.confirm-dialog h2{margin:0 0 .6rem;font-family:var(--display);font-size:1.6rem}.confirm-dialog p{margin:0;color:rgba(255,255,255,.75);line-height:1.65}.confirm-ok{margin-top:1.4rem;padding:.85rem 1.4rem;border:0;border-radius:11px;background:var(--yellow);color:#173020;font-family:var(--display);font-weight:900;cursor:pointer}.dialog-close{position:absolute;right:1rem;top:1rem;width:38px;height:38px;border:1px solid rgba(255,255,255,.2);border-radius:50%;background:rgba(255,255,255,.08);color:#fff;font-size:1.3rem;cursor:pointer}
</style>

<style>
